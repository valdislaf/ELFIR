fn fb_write_hcc1_label(ptr<u32> fb, i64 stride, i64 width, i64 height, ptr<i64> xp, ptr<i64> yp) {
    fb_putc(fb, stride, width, height, xp, yp, u8(0x48)); // H
    fb_putc(fb, stride, width, height, xp, yp, u8(0x43)); // C
    fb_putc(fb, stride, width, height, xp, yp, u8(0x43)); // C
    fb_putc(fb, stride, width, height, xp, yp, u8(0x31)); // 1
