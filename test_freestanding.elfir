            } else {
                dbg_mark(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(9));
            }
            if (0 && fb_out != ptr<u32>(0)) {
                fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x55)); // U
                fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x50)); // P
                fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x4C)); // L
                fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x0A));
            }
        }
        if (0 && fb_out != ptr<u32>(0)) {
            fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x55)); // U
            fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x30)); // 0
            fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x0A));
        }
		
        if (0) {
            fb_write_xhci_base_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
            fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, xhci_base);
            fb_mark_line(fb, i64(fb_stride), i64(fb_width), i64(fb_height), *fyp, u32(0x00FF8800));
            fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x0A));
        }

        ptr<u32> cap_reg = ptr<u32>(xhci_base);
        u32 cap0 = volatile_load(cap_reg);
        u8 caplen = u8(cap0 & u32(0xFF));
        u16 hci_ver = u16((cap0 >> u32(16)) & u32(0xFFFF));
        dbg_mark(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(6));

        if (0) {
            fb_write_caplen_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
            fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(caplen));
            fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x20));
            fb_write_hciver_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
            fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(hci_ver));
            fb_mark_line(fb, i64(fb_stride), i64(fb_width), i64(fb_height), *fyp, u32(0x0000FF00));
            fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x0A));
        }
		


        ptr<u32> hcs1_reg = ptr<u32>(xhci_base + u64(0x04));
        ptr<u32> hcs2_reg = ptr<u32>(xhci_base + u64(0x08));
        ptr<u32> hcs3_reg = ptr<u32>(xhci_base + u64(0x0C));
        ptr<u32> dboff_reg = ptr<u32>(xhci_base + u64(0x14));
        ptr<u32> rtsoff_reg = ptr<u32>(xhci_base + u64(0x18));

        u32 hcs1 = volatile_load(hcs1_reg);
        u32 hcs2 = volatile_load(hcs2_reg);
        u32 hcs3 = volatile_load(hcs3_reg);
        u32 dboff = volatile_load(dboff_reg);
        u32 rtsoff = volatile_load(rtsoff_reg);
        u8 max_ports = u8((hcs1 >> u32(24)) & u32(0xFF));
        u8 max_slots = u8(hcs1 & u32(0xFF));
        dbg_mark(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(7));

        if (0) {
            fb_write_hcs1_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
            fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(hcs1));
            fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x0A));

            fb_write_hcs2_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
            fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(hcs2));
            fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x0A));

            fb_write_hcs3_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
            fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(hcs3));
            fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x0A));

            fb_write_dboff_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
            fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(dboff));
            fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x0A));

            fb_write_rtsoff_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
            fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(rtsoff));
            fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x0A));

            fb_write_ports_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
            fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(max_ports));
            fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x0A));

            fb_write_slots_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
            fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(max_slots));
            fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x0A));
        }

        ptr<u32> hcc1_reg = ptr<u32>(xhci_base + u64(0x10));
        u32 hcc1 = volatile_load(hcc1_reg);
        u32 ecp = (hcc1 >> u32(16)) & u32(0xFFFF);
        u64 ecp_off = u64(ecp) * u64(4);
        if (0) {
            fb_write_hcc1_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
            fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(hcc1));
            fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x0A));
            fb_write_ecp_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
            fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(ecp_off));
            fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x0A));
        }

        if (ecp_off != u64(0)) {
            u64 cur_ecp = ecp_off;
            i64 guard = 32;
            while (guard > 0 && cur_ecp != u64(0)) {
                ptr<u32> caphdr_reg = ptr<u32>(xhci_base + cur_ecp);
                u32 caphdr = volatile_load(caphdr_reg);
                u8 cap_id = u8(caphdr & u32(0xFF));
                u8 next = u8((caphdr >> u32(8)) & u32(0xFF));
                if (cap_id == u8(2)) {
                    ptr<u32> sp_d1_reg = ptr<u32>(xhci_base + cur_ecp + u64(0x04));
                    ptr<u32> sp_d2_reg = ptr<u32>(xhci_base + cur_ecp + u64(0x08));
                    u32 sp_d1 = volatile_load(sp_d1_reg);
                    u32 sp_d2 = volatile_load(sp_d2_reg);
                    u8 poff = u8(sp_d2 & u32(0xFF));
                    u8 pcnt = u8((sp_d2 >> u32(8)) & u32(0xFF));
                    if (0) {
                        fb_write_spd1_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
                        fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(sp_d1));
                        fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x0A));
                        fb_write_spd2_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
                        fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(sp_d2));
                        fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x0A));
                        fb_write_poff_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
                        fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(poff));
                        fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x20));
                        fb_write_pcnt_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
                        fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(pcnt));
                        fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x0A));
                    }
                }
                if (cap_id == u8(1)) {
                    ptr<u32> legsup = ptr<u32>(xhci_base + cur_ecp);
                    u32 leg = volatile_load(legsup);
                    u32 bios = (leg >> u32(16)) & u32(1);
                    u32 os = (leg >> u32(24)) & u32(1);
                    if (0) {
                        fb_write_leg_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
                        fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(leg));
                        fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x0A));
                        fb_write_bios_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
                        fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(bios));
                        fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x0A));
                        fb_write_os_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
                        fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(os));
                        fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x0A));
                    }

                    u32 leg2 = leg | u32(1 << 24);
                    volatile_store(legsup, leg2);
                    ptr<u32> legctl = ptr<u32>(xhci_base + cur_ecp + u64(0x04));
                    volatile_store(legctl, u32(0xFFFFFFFF));
                    volatile_store(legctl, u32(0));
                    i64 waitb = 4000000;
                    while (waitb > 0) {
                        u32 l2 = volatile_load(legsup);
                        if (((l2 >> u32(16)) & u32(1)) == u32(0)) { break; }
                        waitb -= 1;
                    }
                    u32 leg_after = volatile_load(legsup);
                    if (((leg_after >> u32(16)) & u32(1)) != u32(0)) {
                        u32 leg_force = leg_after & ~u32(1 << 16);
                        volatile_store(legsup, leg_force);
                        i64 waitb2 = 2000000;
                        while (waitb2 > 0) {
                            u32 l3 = volatile_load(legsup);
                            if (((l3 >> u32(16)) & u32(1)) == u32(0)) { break; }
                            waitb2 -= 1;
                        }
                        leg_after = volatile_load(legsup);
                    }
                    if (((leg_after >> u32(16)) & u32(1)) != u32(0) && fb_out != ptr<u32>(0)) {
