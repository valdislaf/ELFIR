    ptr<i64> colp = &col;
    i64 shift = 0;
    ptr<u32> fb_out = ptr<u32>(0);
    i64 fb_out_stride = 0;
    i64 fb_out_width = 0;
    i64 fb_out_height = 0;
    i64 fb_out_x = 0;
    i64 fb_out_y = 0;
    ptr<i64> fb_out_xp = &fb_out_x;
    ptr<i64> fb_out_yp = &fb_out_y;
    i64 usb_ready = 0;
    i64 usb_pending = 0;
    u32 usb_slot_id = u32(0);
    u32 usb_ep_id = u32(0);
    u32 ep_ctx_index = u32(0);
    u32 usb_ep_addr = u32(0);
    u32 usb_ep_mps = u32(8);
    u32 usb_ep_interval = u32(10);
    u32 usb_if_num = u32(0);
    u32 usb_if_alt = u32(0);
    u32 usb_db_idx = u32(0);
    u64 usb_evt_ring_addr = u64(0);
    u64 usb_erst_addr = u64(0);
    ptr<u8> usb_evt_ring = ptr<u8>(0);
    ptr<u64> usb_erdp_reg = ptr<u64>(0);
    ptr<u32> usb_db_reg = ptr<u32>(0);
    ptr<u8> usb_kbd_ring = ptr<u8>(0);
    ptr<u32> usb_iman_reg = ptr<u32>(0);
    ptr<u32> usb_imod_reg = ptr<u32>(0);
    ptr<u32> usb_erstsz_reg = ptr<u32>(0);
    ptr<u64> usb_erstba_reg = ptr<u64>(0);
