                    *(ep1_ctx + 1) = ep1_d1;
                    *(ep1_ctx + 2) = ep1_d2;
                    *(ep1_ctx + 3) = ep1_d3;
                    *(ep1_ctx + 4) = ep1_d4;
                    *(ep1_ctx + 5) = u32(0);
                    *(ep1_ctx + 6) = u32(0);
