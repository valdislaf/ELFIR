fn xhci_zero(ptr<u8> p, i64 bytes) {
    i64 i = 0;
    while (i < bytes) {
        *(p + i) = u8(0);
        i += 1;
    }
    ret;
}

fn xhci_write_trb(ptr<u32> ring32, i64 trb_idx, u32 d0, u32 d1, u32 d2, u32 d3) {
    ptr<u32> base = ring32 + trb_idx * 4;
    *(base + 0) = d0;
    *(base + 1) = d1;
    *(base + 2) = d2;
    *(base + 3) = d3;
    ret;
}

fn xhci_cmd_ring_init(ptr<u8> cmd_ring, u32 cycle) {
    ptr<u32> ring32 = ptr<u32>(u64(cmd_ring));
    i64 link_idx = 255;
    u64 ring_addr = u64(cmd_ring);
    u32 link_d0 = u32(ring_addr & u64(0xFFFFFFFF));
    u32 link_d1 = u32((ring_addr >> u64(32)) & u64(0xFFFFFFFF));
    u32 link_d2 = u32(0);
    u32 link_d3 = u32(0);
    link_d3 = link_d3 | (cycle & u32(1));
    link_d3 = link_d3 | u32(1 << 1);
    link_d3 = link_d3 | u32(6 << 10);
    xhci_write_trb(ring32, link_idx, link_d0, link_d1, link_d2, link_d3);
    ret;
}

fn xhci_cmd_enqueue(ptr<u8> cmd_ring, ptr<i64> idxp, ptr<u32> cyclep, u32 d0, u32 d1, u32 d2, u32 d3) {
    ptr<u32> ring32 = ptr<u32>(u64(cmd_ring));
    i64 idx = *idxp;
    u32 cycle = *cyclep;
    d3 = d3 | (cycle & u32(1));
    xhci_write_trb(ring32, idx, d0, d1, d2, d3);
    idx += 1;
    if (idx >= 255) {
        idx = 0;
        cycle = cycle ^ u32(1);
        *cyclep = cycle;
    }
    *idxp = idx;
    ret;
}

fn xhci_xfer_enqueue(ptr<u8> ring, ptr<i64> idxp, ptr<u32> cyclep, u32 d0, u32 d1, u32 d2, u32 d3) {
    ptr<u32> ring32 = ptr<u32>(u64(ring));
    i64 idx = *idxp;
    u32 cycle = *cyclep;
    d3 = d3 | (cycle & u32(1));
    xhci_write_trb(ring32, idx, d0, d1, d2, d3);
    idx += 1;
    if (idx >= 255) {
        idx = 0;
        cycle = cycle ^ u32(1);
        *cyclep = cycle;
    }
    *idxp = idx;
    ret;
}

fn xhci_ring_init(ptr<u8> ring, u32 cycle) {
    ptr<u32> ring32 = ptr<u32>(u64(ring));
    i64 link_idx = 255;
    u64 ring_addr = u64(ring);
    u32 link_d0 = u32(ring_addr & u64(0xFFFFFFFF));
    u32 link_d1 = u32((ring_addr >> u64(32)) & u64(0xFFFFFFFF));
    u32 link_d2 = u32(0);
    u32 link_d3 = u32(0);
    link_d3 = link_d3 | (cycle & u32(1));
    link_d3 = link_d3 | u32(1 << 1);
    link_d3 = link_d3 | u32(6 << 10);
    xhci_write_trb(ring32, link_idx, link_d0, link_d1, link_d2, link_d3);
    ret;
}

fn i64 xhci_ctx_size(u32 hcc1) {
    if (((hcc1 >> u32(2)) & u32(1)) != u32(0)) {
        ret 64;
    }
    ret 32;
}

fn u32 pci_cfg_addr(u8 bus, u8 dev, u8 func, u8 off) {
    u32 addr = u32(0x80000000);
    addr = addr | (u32(bus) << u32(16));
    addr = addr | (u32(dev) << u32(11));
    addr = addr | (u32(func) << u32(8));
    addr = addr | (u32(off) & u32(0xFC));
    ret addr;
}

fn u32 pci_read32(u8 bus, u8 dev, u8 func, u8 off) {
    u32 addr = pci_cfg_addr(bus, dev, func, off);
    out32(u16(0xCF8), addr);
    ret in32(u16(0xCFC));
}

fn pci_write32(u8 bus, u8 dev, u8 func, u8 off, u32 val) {
    u32 addr = pci_cfg_addr(bus, dev, func, off);
    out32(u16(0xCF8), addr);
    out32(u16(0xCFC), val);
}

fn u8 pci_find_cap(u8 bus, u8 dev, u8 func, u8 cap_id) {
    u32 st = pci_read32(bus, dev, func, u8(0x04));
    if ((st & u32(0x00100000)) == u32(0)) {
        ret u8(0);
    }
    u32 cap_ptr32 = pci_read32(bus, dev, func, u8(0x34));
    u8 cap_ptr = u8(cap_ptr32 & u32(0xFF));
    i64 guard = 48;
    while (cap_ptr != u8(0) && guard > 0) {
        u32 hdr = pci_read32(bus, dev, func, cap_ptr);
        u8 id = u8(hdr & u32(0xFF));
        u8 next = u8((hdr >> u32(8)) & u32(0xFF));
        if (id == cap_id) {
            ret cap_ptr;
        }
        cap_ptr = next;
        guard -= 1;
    }
    ret u8(0);
}

fn pci_pm_set_d0(u8 bus, u8 dev, u8 func) {
    u8 cap = pci_find_cap(bus, dev, func, u8(0x01));
    if (cap == u8(0)) { ret; }
    u32 pmcsr = pci_read32(bus, dev, func, cap + u8(0x04));
    pmcsr = pmcsr & ~u32(0x3);
    pci_write32(bus, dev, func, cap + u8(0x04), pmcsr);
}

fn pci_flr(u8 bus, u8 dev, u8 func) {
    u8 cap = pci_find_cap(bus, dev, func, u8(0x10));
    if (cap == u8(0)) { ret; }
    u32 devctl2 = pci_read32(bus, dev, func, cap + u8(0x28));
    devctl2 = devctl2 | u32(1 << 15);
    pci_write32(bus, dev, func, cap + u8(0x28), devctl2);
    i64 wait = 2000000;
    while (wait > 0) {
        u32 v = pci_read32(bus, dev, func, cap + u8(0x28));
        if ((v & u32(1 << 15)) == u32(0)) { break; }
        wait -= 1;
    }
}
fn i64 pci_enable_msi(u8 bus, u8 dev, u8 func, u8 vector) {
    u8 cap = pci_find_cap(bus, dev, func, u8(0x05));
    if (cap == u8(0)) { ret 0; }
    u32 hdr = pci_read32(bus, dev, func, cap);
    u32 msg_ctl = (hdr >> u32(16)) & u32(0xFFFF);
    u32 is64 = (msg_ctl >> u32(7)) & u32(1);
    u32 addr_lo = u32(0xFEE00000);
    u32 addr_hi = u32(0);
    pci_write32(bus, dev, func, cap + u8(0x04), addr_lo);
    if (is64 != u32(0)) {
        pci_write32(bus, dev, func, cap + u8(0x08), addr_hi);
        pci_write32(bus, dev, func, cap + u8(0x0C), u32(vector));
    } else {
        pci_write32(bus, dev, func, cap + u8(0x08), u32(vector));
    }
    msg_ctl = msg_ctl | u32(1);
    u32 hdr2 = (hdr & u32(0x0000FFFF)) | (msg_ctl << u32(16));
    pci_write32(bus, dev, func, cap, hdr2);

    u32 cmd = pci_read32(bus, dev, func, u8(0x04));
    cmd = cmd | u32(1 << 2);
    cmd = cmd | u32(1 << 10);
    pci_write32(bus, dev, func, u8(0x04), cmd);
    ret 1;
}

fn u64 pci_find_xhci_base(ptr<u8> bus_out, ptr<u8> dev_out, ptr<u8> fn_out) {
    i64 bus = 0;
    while (bus < 256) {
        i64 dev = 0;
        while (dev < 32) {
            i64 func = 0;
            while (func < 8) {
                u32 id = pci_read32(u8(bus), u8(dev), u8(func), u8(0x00));
                if ((id & u32(0xFFFF)) != u32(0xFFFF)) {
                    u32 classc = pci_read32(u8(bus), u8(dev), u8(func), u8(0x08));
                    u8 prog = u8((classc >> u32(8)) & u32(0xFF));
                    u8 sub = u8((classc >> u32(16)) & u32(0xFF));
                    u8 cls = u8((classc >> u32(24)) & u32(0xFF));
                    if (cls == u8(0x0C) && sub == u8(0x03) && prog == u8(0x30)) {
                        u32 bar0 = pci_read32(u8(bus), u8(dev), u8(func), u8(0x10));
                        u32 bar1 = pci_read32(u8(bus), u8(dev), u8(func), u8(0x14));
                        u64 base = (u64(bar1) << u64(32)) | u64(bar0);
                        base = base & ~u64(0xF);
                        *bus_out = u8(bus);
                        *dev_out = u8(dev);
                        *fn_out = u8(func);
                        ret base;
                    }
                }
                func += 1;
            }
            dev += 1;
        }
        bus += 1;
    }
    ret u64(0);
}

fn fb_write_port_label(ptr<u32> fb, i64 stride, i64 width, i64 height, ptr<i64> xp, ptr<i64> yp) {
    fb_putc(fb, stride, width, height, xp, yp, u8(0x50)); // P
    fb_putc(fb, stride, width, height, xp, yp, u8(0x4F)); // O
    fb_putc(fb, stride, width, height, xp, yp, u8(0x52)); // R
    fb_putc(fb, stride, width, height, xp, yp, u8(0x54)); // T
    fb_putc(fb, stride, width, height, xp, yp, u8(0x3D)); // =
    ret;
}

fn i64 xhci_evt_poll(ptr<u8> evt_ring, ptr<i64> idxp, ptr<u32> cyclep, ptr<u32> d0p, ptr<u32> d1p, ptr<u32> d2p, ptr<u32> d3p) {
    ptr<u32> ring32 = ptr<u32>(u64(evt_ring));
    i64 idx = *idxp;
    u32 d3 = *(ring32 + idx * 4 + 3);
    u32 cycle = *cyclep;
    if ((d3 & u32(1)) != (cycle & u32(1))) {
        ret 0;
    }
    *d0p = *(ring32 + idx * 4 + 0);
    *d1p = *(ring32 + idx * 4 + 1);
    *d2p = *(ring32 + idx * 4 + 2);
    *d3p = d3;
    idx += 1;
    if (idx >= 256) {
        idx = 0;
        cycle = cycle ^ u32(1);
        *cyclep = cycle;
    }
    *idxp = idx;
    ret 1;
}

fn i64 xhci_ctrl_xfer(ptr<u8> ring, ptr<i64> idxp, ptr<u32> cyclep,
                      ptr<u8> evt_ring, ptr<i64> evt_idxp, ptr<u32> evt_cyclep,
                      ptr<u64> erdp_reg, ptr<u32> doorbell,
                      u64 setup, ptr<u8> data, u32 data_len, i64 data_in,
                      ptr<u32> fb_out, i64 fb_stride, i64 fb_width, i64 fb_height,
                      ptr<i64> fb_xp, ptr<i64> fb_yp) {
    u32 d0 = u32(setup & u64(0xFFFFFFFF));
    u32 d1 = u32((setup >> u64(32)) & u64(0xFFFFFFFF));
    u32 d2 = u32(8);
    u32 d3 = u32(0);
    u32 trt = u32(0);
    if (data_len != u32(0)) {
        if (data_in) { trt = u32(2); } else { trt = u32(3); }
    }
    d3 = d3 | (trt << u32(16));
    d3 = d3 | u32(1 << 6);
    d3 = d3 | u32(2 << 10);
    xhci_xfer_enqueue(ring, idxp, cyclep, d0, d1, d2, d3);
    if (data_len != u32(0)) {
        u64 data_addr = u64(data);
        u32 dd0 = u32(data_addr & u64(0xFFFFFFFF));
        u32 dd1 = u32((data_addr >> u64(32)) & u64(0xFFFFFFFF));
        u32 dd2 = data_len;
        u32 dd3 = u32(0);
        if (data_in) {
            dd3 = dd3 | u32(1 << 16);
        }
        dd3 = dd3 | u32(3 << 10);
        xhci_xfer_enqueue(ring, idxp, cyclep, dd0, dd1, dd2, dd3);
    }
    u32 sd3 = u32(0);
    if (data_len == u32(0)) {
        sd3 = sd3 | u32(1 << 16);
    } else {
        if (!data_in) {
            sd3 = sd3 | u32(1 << 16);
        }
    }
    sd3 = sd3 | u32(1 << 5);
    sd3 = sd3 | u32(4 << 10);
    xhci_xfer_enqueue(ring, idxp, cyclep, u32(0), u32(0), u32(0), sd3);

    *doorbell = u32(1);
    i64 wait = 2000000;
    while (wait > 0) {
        u32 ev_d0 = u32(0);
        u32 ev_d1 = u32(0);
        u32 ev_d2 = u32(0);
        u32 ev_d3 = u32(0);
        if (xhci_evt_poll(evt_ring, evt_idxp, evt_cyclep, &ev_d0, &ev_d1, &ev_d2, &ev_d3)) {
            u32 ev_type = (ev_d3 >> u32(10)) & u32(0x3F);
            u32 ccode = (ev_d2 >> u32(24)) & u32(0xFF);
            u64 erdp_val = u64(evt_ring) + u64(*evt_idxp) * u64(16);
            volatile_store(erdp_reg, erdp_val | u64(0x8));
            if (ev_type == u32(32)) {
                if (0 && fb_out != ptr<u32>(0)) {
                    fb_putc(fb_out, fb_stride, fb_width, fb_height, fb_xp, fb_yp, u8(0x58)); // X
                    fb_putc(fb_out, fb_stride, fb_width, fb_height, fb_xp, fb_yp, u8(0x43)); // C
                    fb_putc(fb_out, fb_stride, fb_width, fb_height, fb_xp, fb_yp, u8(0x3D)); // =
                    fb_write_hex_u64(fb_out, fb_stride, fb_width, fb_height, fb_xp, fb_yp, u64(ccode));
                    fb_putc(fb_out, fb_stride, fb_width, fb_height, fb_xp, fb_yp, u8(0x20));
                    fb_putc(fb_out, fb_stride, fb_width, fb_height, fb_xp, fb_yp, u8(0x44)); // D
                    fb_putc(fb_out, fb_stride, fb_width, fb_height, fb_xp, fb_yp, u8(0x32)); // 2
                    fb_putc(fb_out, fb_stride, fb_width, fb_height, fb_xp, fb_yp, u8(0x3D)); // =
                    fb_write_hex_u64(fb_out, fb_stride, fb_width, fb_height, fb_xp, fb_yp, u64(ev_d2));
                    fb_putc(fb_out, fb_stride, fb_width, fb_height, fb_xp, fb_yp, u8(0x20));
                    fb_putc(fb_out, fb_stride, fb_width, fb_height, fb_xp, fb_yp, u8(0x44)); // D
                    fb_putc(fb_out, fb_stride, fb_width, fb_height, fb_xp, fb_yp, u8(0x33)); // 3
                    fb_putc(fb_out, fb_stride, fb_width, fb_height, fb_xp, fb_yp, u8(0x3D)); // =
                    fb_write_hex_u64(fb_out, fb_stride, fb_width, fb_height, fb_xp, fb_yp, u64(ev_d3));
                    fb_putc(fb_out, fb_stride, fb_width, fb_height, fb_xp, fb_yp, u8(0x0A));
                }
                if (ccode == u32(1)) {
                    ret 1;
                }
                ret 0;
            }
        }
        wait -= 1;
    }
    if (0 && fb_out != ptr<u32>(0)) {
        fb_putc(fb_out, fb_stride, fb_width, fb_height, fb_xp, fb_yp, u8(0x45)); // E
        fb_putc(fb_out, fb_stride, fb_width, fb_height, fb_xp, fb_yp, u8(0x54)); // T
        fb_putc(fb_out, fb_stride, fb_width, fb_height, fb_xp, fb_yp, u8(0x0A));
    }
    ret 0;
}

fn u8 hid_key_to_ascii(u8 key, i64 shift) {
    if (key >= u8(0x04) && key <= u8(0x1D)) {
        u8 base = u8(0x61) + (key - u8(0x04));
        if (shift) { ret base - u8(0x20); }
        ret base;
    }
    if (key == u8(0x1E)) { ret sel_shift(shift, u8(0x31), u8(0x21)); }
    if (key == u8(0x1F)) { ret sel_shift(shift, u8(0x32), u8(0x40)); }
    if (key == u8(0x20)) { ret sel_shift(shift, u8(0x33), u8(0x23)); }
    if (key == u8(0x21)) { ret sel_shift(shift, u8(0x34), u8(0x24)); }
    if (key == u8(0x22)) { ret sel_shift(shift, u8(0x35), u8(0x25)); }
    if (key == u8(0x23)) { ret sel_shift(shift, u8(0x36), u8(0x5E)); }
    if (key == u8(0x24)) { ret sel_shift(shift, u8(0x37), u8(0x26)); }
    if (key == u8(0x25)) { ret sel_shift(shift, u8(0x38), u8(0x2A)); }
    if (key == u8(0x26)) { ret sel_shift(shift, u8(0x39), u8(0x28)); }
    if (key == u8(0x27)) { ret sel_shift(shift, u8(0x30), u8(0x29)); }
    if (key == u8(0x28)) { ret u8(0x0A); }
    if (key == u8(0x2A)) { ret u8(0x08); }
    if (key == u8(0x2C)) { ret u8(0x20); }
    if (key == u8(0x2D)) { ret sel_shift(shift, u8(0x2D), u8(0x5F)); }
    if (key == u8(0x2E)) { ret sel_shift(shift, u8(0x3D), u8(0x2B)); }
    if (key == u8(0x2F)) { ret sel_shift(shift, u8(0x5B), u8(0x7B)); }
    if (key == u8(0x30)) { ret sel_shift(shift, u8(0x5D), u8(0x7D)); }
    if (key == u8(0x31)) { ret sel_shift(shift, u8(0x5C), u8(0x7C)); }
    if (key == u8(0x33)) { ret sel_shift(shift, u8(0x3B), u8(0x3A)); }
    if (key == u8(0x34)) { ret sel_shift(shift, u8(0x27), u8(0x22)); }
    if (key == u8(0x35)) { ret sel_shift(shift, u8(0x60), u8(0x7E)); }
    if (key == u8(0x36)) { ret sel_shift(shift, u8(0x2C), u8(0x3C)); }
    if (key == u8(0x37)) { ret sel_shift(shift, u8(0x2E), u8(0x3E)); }
    if (key == u8(0x38)) { ret sel_shift(shift, u8(0x2F), u8(0x3F)); }
    ret u8(0);
}

fn i64 hid_key_in_prev(u8 key, ptr<u8> prev) {
    i64 i = 2;
    while (i < 8) {
        if (*(prev + i) == key) { ret 1; }
        i += 1;
    }
    ret 0;
}

fn fb_write_usbcmd_label(ptr<u32> fb, i64 stride, i64 width, i64 height, ptr<i64> xp, ptr<i64> yp) {
    fb_putc(fb, stride, width, height, xp, yp, u8(0x55)); // U
    fb_putc(fb, stride, width, height, xp, yp, u8(0x53)); // S
    fb_putc(fb, stride, width, height, xp, yp, u8(0x42)); // B
    fb_putc(fb, stride, width, height, xp, yp, u8(0x43)); // C
    fb_putc(fb, stride, width, height, xp, yp, u8(0x4D)); // M
    fb_putc(fb, stride, width, height, xp, yp, u8(0x44)); // D
    fb_putc(fb, stride, width, height, xp, yp, u8(0x3D)); // =
    fb_putc(fb, stride, width, height, xp, yp, u8(0x30)); // 0
    fb_putc(fb, stride, width, height, xp, yp, u8(0x58)); // X
    ret;
}

fn fb_write_usbsts_label(ptr<u32> fb, i64 stride, i64 width, i64 height, ptr<i64> xp, ptr<i64> yp) {
    fb_putc(fb, stride, width, height, xp, yp, u8(0x55)); // U
    fb_putc(fb, stride, width, height, xp, yp, u8(0x53)); // S
    fb_putc(fb, stride, width, height, xp, yp, u8(0x42)); // B
    fb_putc(fb, stride, width, height, xp, yp, u8(0x53)); // S
    fb_putc(fb, stride, width, height, xp, yp, u8(0x54)); // T
    fb_putc(fb, stride, width, height, xp, yp, u8(0x53)); // S
    fb_putc(fb, stride, width, height, xp, yp, u8(0x3D)); // =
    fb_putc(fb, stride, width, height, xp, yp, u8(0x30)); // 0
    fb_putc(fb, stride, width, height, xp, yp, u8(0x58)); // X
    ret;
}

fn fb_fill_rect(ptr<u32> fb, i64 stride, i64 width, i64 height, i64 x, i64 y, i64 w, i64 h, u32 color) {
    i64 yy = 0;
    while (yy < h) {
        i64 py = y + yy;
        if (py >= height) { ret; }
        i64 xx = 0;
        while (xx < w) {
            i64 px = x + xx;
            if (px >= width) { break; }
            i64 off = py * stride + px;
            *(fb + off) = color;
            xx += 1;
        }
        yy += 1;
    }
    ret;
}

fn fb_mark_line(ptr<u32> fb, i64 stride, i64 width, i64 height, i64 line, u32 color) {
    i64 scale = 1;
    i64 line_step = 10;
    i64 cols = width / (8 * scale);
    if (cols <= 4) { ret; }
    i64 x = (cols - 4) * 8 * scale;
    i64 y = line * line_step * scale;
    fb_fill_rect(fb, stride, width, height, x, y, 24 * scale, 8 * scale, color);
    ret;
}

fn tty_write_xhci_base_label(ptr<u16> vga, ptr<i64> rowp, ptr<i64> colp, u16 attr) {
    tty_putc(vga, rowp, colp, attr, u8(0x78)); // x
    tty_putc(vga, rowp, colp, attr, u8(0x68)); // h
    tty_putc(vga, rowp, colp, attr, u8(0x63)); // c
    tty_putc(vga, rowp, colp, attr, u8(0x69)); // i
    tty_putc(vga, rowp, colp, attr, u8(0x5F)); // _
    tty_putc(vga, rowp, colp, attr, u8(0x62)); // b
    tty_putc(vga, rowp, colp, attr, u8(0x61)); // a
    tty_putc(vga, rowp, colp, attr, u8(0x73)); // s
    tty_putc(vga, rowp, colp, attr, u8(0x65)); // e
    tty_putc(vga, rowp, colp, attr, u8(0x3D)); // =
    tty_putc(vga, rowp, colp, attr, u8(0x30)); // 0
    tty_putc(vga, rowp, colp, attr, u8(0x78)); // x
}

fn tty_write_caplen_label(ptr<u16> vga, ptr<i64> rowp, ptr<i64> colp, u16 attr) {
    tty_putc(vga, rowp, colp, attr, u8(0x63)); // c
    tty_putc(vga, rowp, colp, attr, u8(0x61)); // a
    tty_putc(vga, rowp, colp, attr, u8(0x70)); // p
    tty_putc(vga, rowp, colp, attr, u8(0x6C)); // l
    tty_putc(vga, rowp, colp, attr, u8(0x65)); // e
    tty_putc(vga, rowp, colp, attr, u8(0x6E)); // n
    tty_putc(vga, rowp, colp, attr, u8(0x3D)); // =
    tty_putc(vga, rowp, colp, attr, u8(0x30)); // 0
    tty_putc(vga, rowp, colp, attr, u8(0x78)); // x
}

fn tty_write_hciver_label(ptr<u16> vga, ptr<i64> rowp, ptr<i64> colp, u16 attr) {
    tty_putc(vga, rowp, colp, attr, u8(0x68)); // h
    tty_putc(vga, rowp, colp, attr, u8(0x63)); // c
    tty_putc(vga, rowp, colp, attr, u8(0x69)); // i
    tty_putc(vga, rowp, colp, attr, u8(0x76)); // v
    tty_putc(vga, rowp, colp, attr, u8(0x65)); // e
    tty_putc(vga, rowp, colp, attr, u8(0x72)); // r
    tty_putc(vga, rowp, colp, attr, u8(0x3D)); // =
    tty_putc(vga, rowp, colp, attr, u8(0x30)); // 0
    tty_putc(vga, rowp, colp, attr, u8(0x78)); // x
}

fn irq_timer_tick() {
    ptr<u64> ticks = rt_ticks_ptr();
    u64 t = volatile_load(ticks);
    t += u64(1);
    volatile_store(ticks, t);
}

fn irq_kbd_push(u64 sc) {
    ptr<u8> buf = rt_kbd_buf_ptr();
    ptr<u8> headp = rt_kbd_head_ptr();
    ptr<u8> tailp = rt_kbd_tail_ptr();
    u8 head = volatile_load(headp);
    u8 tail = volatile_load(tailp);
    u8 next = u8((u64(head) + u64(1)) & u64(63));
    if (next == tail) {
        ret;
    }
    *(buf + u64(head)) = u8(sc);
    volatile_store(headp, next);
    ret;
}

fn irq_xhci_evt() {
    ptr<u64> flagp = rt_usb_irq_ptr();
    u64 v = volatile_load(flagp);
    volatile_store(flagp, v + u64(1));
}

fn dbg_mark(ptr<u32> fb_out, i64 fb_out_stride, i64 fb_out_width, i64 fb_out_height,
            ptr<i64> fb_out_xp, ptr<i64> fb_out_yp, u8 idx) {
    if (fb_out == ptr<u32>(0)) { ret; }
    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x49)); // I
    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x30) + idx);
    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x20));
}

fn dbg_mark2(ptr<u32> fb_out, i64 fb_out_stride, i64 fb_out_width, i64 fb_out_height,
             ptr<i64> fb_out_xp, ptr<i64> fb_out_yp, u8 idx) {
    if (fb_out == ptr<u32>(0)) { ret; }
    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x4A)); // J
    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x30) + idx);
    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x20));
}

fn panic(str msg) {
    print("PANIC: ", msg, "\n");
    asm0("cli");
    i64 one = 1;
    while (one) {
        asm0("hlt");
    }
}

fn u8 sel_shift(i64 shift, u8 normal, u8 shifted) {
    if (shift) {
        ret shifted;
    }
    ret normal;
}

fn u8 kbd_read_scancode() {
    u8 st = in8(u16(0x64));
    if ((st & u8(0x01)) == u8(0)) {
        ret u8(0);
    }
    ret in8(u16(0x60));
}

fn kbd_flush() {
    u8 st = in8(u16(0x64));
    while ((st & u8(0x01)) != u8(0)) {
        u8 drop = in8(u16(0x60));
        drop = drop;
        st = in8(u16(0x64));
    }
}

fn u8 kbd_read_scancode_irq() {
    ptr<u8> buf = rt_kbd_buf_ptr();
    ptr<u8> headp = rt_kbd_head_ptr();
    ptr<u8> tailp = rt_kbd_tail_ptr();
    u8 head = volatile_load(headp);
    u8 tail = volatile_load(tailp);
    if (head == tail) {
        ret u8(0);
    }
    u8 sc = *(buf + u64(tail));
    tail = u8((u64(tail) + u64(1)) & u64(63));
    volatile_store(tailp, tail);
    ret sc;
}

fn u8 kbd_scancode_to_ascii(u8 sc, i64 shift) {
    if (sc == u8(0x0E)) { ret u8(0x08); }
    if (sc == u8(0x1C)) { ret u8(0x0A); }
    if (sc == u8(0x39)) { ret u8(0x20); }

    if (sc == u8(0x02)) { ret sel_shift(shift, u8(0x31), u8(0x21)); }
    if (sc == u8(0x03)) { ret sel_shift(shift, u8(0x32), u8(0x40)); }
    if (sc == u8(0x04)) { ret sel_shift(shift, u8(0x33), u8(0x23)); }
    if (sc == u8(0x05)) { ret sel_shift(shift, u8(0x34), u8(0x24)); }
    if (sc == u8(0x06)) { ret sel_shift(shift, u8(0x35), u8(0x25)); }
    if (sc == u8(0x07)) { ret sel_shift(shift, u8(0x36), u8(0x5E)); }
    if (sc == u8(0x08)) { ret sel_shift(shift, u8(0x37), u8(0x26)); }
    if (sc == u8(0x09)) { ret sel_shift(shift, u8(0x38), u8(0x2A)); }
    if (sc == u8(0x0A)) { ret sel_shift(shift, u8(0x39), u8(0x28)); }
    if (sc == u8(0x0B)) { ret sel_shift(shift, u8(0x30), u8(0x29)); }
    if (sc == u8(0x0C)) { ret sel_shift(shift, u8(0x2D), u8(0x5F)); }
    if (sc == u8(0x0D)) { ret sel_shift(shift, u8(0x3D), u8(0x2B)); }

    if (sc == u8(0x10)) { ret sel_shift(shift, u8(0x71), u8(0x51)); }
    if (sc == u8(0x11)) { ret sel_shift(shift, u8(0x77), u8(0x57)); }
    if (sc == u8(0x12)) { ret sel_shift(shift, u8(0x65), u8(0x45)); }
    if (sc == u8(0x13)) { ret sel_shift(shift, u8(0x72), u8(0x52)); }
    if (sc == u8(0x14)) { ret sel_shift(shift, u8(0x74), u8(0x54)); }
    if (sc == u8(0x15)) { ret sel_shift(shift, u8(0x79), u8(0x59)); }
    if (sc == u8(0x16)) { ret sel_shift(shift, u8(0x75), u8(0x55)); }
    if (sc == u8(0x17)) { ret sel_shift(shift, u8(0x69), u8(0x49)); }
    if (sc == u8(0x18)) { ret sel_shift(shift, u8(0x6F), u8(0x4F)); }
    if (sc == u8(0x19)) { ret sel_shift(shift, u8(0x70), u8(0x50)); }
    if (sc == u8(0x1A)) { ret sel_shift(shift, u8(0x5B), u8(0x7B)); }
    if (sc == u8(0x1B)) { ret sel_shift(shift, u8(0x5D), u8(0x7D)); }
    if (sc == u8(0x1E)) { ret sel_shift(shift, u8(0x61), u8(0x41)); }
    if (sc == u8(0x1F)) { ret sel_shift(shift, u8(0x73), u8(0x53)); }
    if (sc == u8(0x20)) { ret sel_shift(shift, u8(0x64), u8(0x44)); }
    if (sc == u8(0x21)) { ret sel_shift(shift, u8(0x66), u8(0x46)); }
    if (sc == u8(0x22)) { ret sel_shift(shift, u8(0x67), u8(0x47)); }
    if (sc == u8(0x23)) { ret sel_shift(shift, u8(0x68), u8(0x48)); }
    if (sc == u8(0x24)) { ret sel_shift(shift, u8(0x6A), u8(0x4A)); }
    if (sc == u8(0x25)) { ret sel_shift(shift, u8(0x6B), u8(0x4B)); }
    if (sc == u8(0x26)) { ret sel_shift(shift, u8(0x6C), u8(0x4C)); }
    if (sc == u8(0x27)) { ret sel_shift(shift, u8(0x3B), u8(0x3A)); }
    if (sc == u8(0x28)) { ret sel_shift(shift, u8(0x27), u8(0x22)); }
    if (sc == u8(0x29)) { ret sel_shift(shift, u8(0x60), u8(0x7E)); }
    if (sc == u8(0x2B)) { ret sel_shift(shift, u8(0x5C), u8(0x7C)); }
    if (sc == u8(0x2C)) { ret sel_shift(shift, u8(0x7A), u8(0x5A)); }
    if (sc == u8(0x2D)) { ret sel_shift(shift, u8(0x78), u8(0x58)); }
    if (sc == u8(0x2E)) { ret sel_shift(shift, u8(0x63), u8(0x43)); }
    if (sc == u8(0x2F)) { ret sel_shift(shift, u8(0x76), u8(0x56)); }
    if (sc == u8(0x30)) { ret sel_shift(shift, u8(0x62), u8(0x42)); }
    if (sc == u8(0x31)) { ret sel_shift(shift, u8(0x6E), u8(0x4E)); }
    if (sc == u8(0x32)) { ret sel_shift(shift, u8(0x6D), u8(0x4D)); }
    if (sc == u8(0x33)) { ret sel_shift(shift, u8(0x2C), u8(0x3C)); }
    if (sc == u8(0x34)) { ret sel_shift(shift, u8(0x2E), u8(0x3E)); }
    if (sc == u8(0x35)) { ret sel_shift(shift, u8(0x2F), u8(0x3F)); }

    ret u8(0);
}

fn tty_scroll(ptr<u16> vga, u16 attr) {
    if (uefi_has_st()) {
        ret;
    }
    i64 i = 0;
    while (i < 1920) {
        u16 v = volatile_load(vga + i + 80);
        volatile_store(vga + i, v);
        i += 1;
    }
    i64 j = 1920;
    while (j < 2000) {
        volatile_store(vga + j, u16(0x20) | attr);
        j += 1;
    }
}

fn tty_clear(ptr<u16> vga, ptr<i64> rowp, ptr<i64> colp, u16 attr) {
    if (uefi_present()) {
        i64 st = uefi_clear();
        st = st;
        *rowp = 0;
        *colp = 0;
        ret;
    }
    i64 i = 0;
    while (i < 2000) {
        volatile_store(vga + i, u16(0x20) | attr);
        i += 1;
    }
    *rowp = 0;
    *colp = 0;
}

fn tty_putc(ptr<u16> vga, ptr<i64> rowp, ptr<i64> colp, u16 attr, u8 c) {
    i64 is_uefi = uefi_present();
    i64 row = *rowp;
    i64 col = *colp;
    i64 idx = 0;

    if (c == u8(0x0A)) {
        if (is_uefi) {
            uefi_putc(c);
        }
        col = 0;
        row += 1;
    } else {
        if (c == u8(0x0D)) {
            if (is_uefi) {
                uefi_putc(c);
            }
            col = 0;
        } else {
            if (c == u8(0x08)) {
                if (is_uefi) {
                    uefi_putc(c);
                }
                if (col > 0) {
                    col -= 1;
                } else {
                    if (row > 0) {
                        row -= 1;
                        col = 79;
                    } else {
                        col = 0;
                    }
                }
                if (!is_uefi) {
                    idx = row * 80 + col;
                    volatile_store(vga + idx, u16(0x20) | attr);
                }
            } else {
                if (is_uefi) {
                    uefi_putc(c);
                } else {
                    idx = row * 80 + col;
                    volatile_store(vga + idx, u16(c) | attr);
                }
                col += 1;
            }
        }
    }

    if (col >= 80) {
        col = 0;
        row += 1;
    }
    if (row >= 25) {
        tty_scroll(vga, attr);
        row = 24;
    }
    *rowp = row;
    *colp = col;
}

fn tty_write_prompt(ptr<u16> vga, ptr<i64> rowp, ptr<i64> colp, u16 attr) {
    tty_putc(vga, rowp, colp, attr, u8(0x3E));
    tty_putc(vga, rowp, colp, attr, u8(0x20));
}

fn tty_write_buf(ptr<u16> vga, ptr<i64> rowp, ptr<i64> colp, u16 attr, ptr<u8> buf, i64 len) {
    i64 i = 0;
    while (i < len) {
        u8 ch = *(buf + i);
        tty_putc(vga, rowp, colp, attr, ch);
        i += 1;
    }
}

fn line_copy(ptr<u8> dst, ptr<u8> src, i64 len) {
    i64 i = 0;
    while (i < len) {
        *(dst + i) = *(src + i);
        i += 1;
    }
}

fn line_redraw(ptr<u16> vga, ptr<i64> rowp, ptr<i64> colp, u16 attr, i64 line_row, i64 line_col, ptr<u8> buf, i64 len, i64 prev_len, i64 cur) {
    *rowp = line_row;
    *colp = line_col;
    if (uefi_present()) {
        i64 st = uefi_set_cursor_pos(line_col, line_row);
        st = st;
    }

    i64 i = 0;
    while (i < len) {
        u8 ch = *(buf + i);
        tty_putc(vga, rowp, colp, attr, ch);
        i += 1;
    }
    if (prev_len > len) {
        i64 j = 0;
        while (j < (prev_len - len)) {
            tty_putc(vga, rowp, colp, attr, u8(0x20));
            j += 1;
        }
    }

    i64 total = line_col + cur;
    i64 row = line_row + (total / 80);
    i64 col = total - (total / 80) * 80;
    if (row >= 25) {
        row = 24;
        if (col >= 80) { col = 79; }
    }
    *rowp = row;
    *colp = col;
    if (uefi_present()) {
        i64 st2 = uefi_set_cursor_pos(col, row);
        st2 = st2;
    }
}

fn line_clear_display(ptr<u16> vga, ptr<i64> rowp, ptr<i64> colp, u16 attr, u16 com1, i64 len) {
    i64 i = 0;
    while (i < len) {
        serial_write_backspace(com1);
        tty_putc(vga, rowp, colp, attr, u8(0x08));
        i += 1;
    }
}

fn line_echo_buf(ptr<u16> vga, ptr<i64> rowp, ptr<i64> colp, u16 attr, u16 com1, ptr<u8> buf, i64 len) {
    i64 i = 0;
    while (i < len) {
        u8 ch = *(buf + i);
        serial_write_byte(com1, ch);
        tty_putc(vga, rowp, colp, attr, ch);
        i += 1;
    }
}

fn ptr<u8> hist_entry_ptr(ptr<u8> base, i64 idx) {
    ret byte_add(base, idx * 256);
}

fn i64 hist_get_len(ptr<u8> base, i64 idx) {
    u8 v = *(base + idx);
    ret i64(v);
}

fn hist_set_len(ptr<u8> base, i64 idx, i64 len) {
    *(base + idx) = u8(len);
}

fn tty_write_help(ptr<u16> vga, ptr<i64> rowp, ptr<i64> colp, u16 attr) {
    tty_putc(vga, rowp, colp, attr, u8(0x68));
    tty_putc(vga, rowp, colp, attr, u8(0x65));
    tty_putc(vga, rowp, colp, attr, u8(0x6C));
    tty_putc(vga, rowp, colp, attr, u8(0x70));
    tty_putc(vga, rowp, colp, attr, u8(0x0A));

    tty_putc(vga, rowp, colp, attr, u8(0x65));
    tty_putc(vga, rowp, colp, attr, u8(0x63));
    tty_putc(vga, rowp, colp, attr, u8(0x68));
    tty_putc(vga, rowp, colp, attr, u8(0x6F));
    tty_putc(vga, rowp, colp, attr, u8(0x20));
    tty_putc(vga, rowp, colp, attr, u8(0x3C));
    tty_putc(vga, rowp, colp, attr, u8(0x74));
    tty_putc(vga, rowp, colp, attr, u8(0x65));
    tty_putc(vga, rowp, colp, attr, u8(0x78));
    tty_putc(vga, rowp, colp, attr, u8(0x74));
    tty_putc(vga, rowp, colp, attr, u8(0x3E));
    tty_putc(vga, rowp, colp, attr, u8(0x0A));

    tty_putc(vga, rowp, colp, attr, u8(0x63));
    tty_putc(vga, rowp, colp, attr, u8(0x6C));
    tty_putc(vga, rowp, colp, attr, u8(0x73));
    tty_putc(vga, rowp, colp, attr, u8(0x0A));

    tty_putc(vga, rowp, colp, attr, u8(0x68));
    tty_putc(vga, rowp, colp, attr, u8(0x61));
    tty_putc(vga, rowp, colp, attr, u8(0x6C));
    tty_putc(vga, rowp, colp, attr, u8(0x74));
    tty_putc(vga, rowp, colp, attr, u8(0x0A));

    tty_putc(vga, rowp, colp, attr, u8(0x70));
    tty_putc(vga, rowp, colp, attr, u8(0x61));
    tty_putc(vga, rowp, colp, attr, u8(0x6E));
    tty_putc(vga, rowp, colp, attr, u8(0x69));
    tty_putc(vga, rowp, colp, attr, u8(0x63));
    tty_putc(vga, rowp, colp, attr, u8(0x0A));
}

fn i64 cmd_is_help(ptr<u8> buf, i64 len) {
    if (len != 4) { ret 0; }
    if (*(buf + 0) != u8(0x68)) { ret 0; }
    if (*(buf + 1) != u8(0x65)) { ret 0; }
    if (*(buf + 2) != u8(0x6C)) { ret 0; }
    if (*(buf + 3) != u8(0x70)) { ret 0; }
    ret 1;
}

fn i64 cmd_is_cls(ptr<u8> buf, i64 len) {
    if (len != 3) { ret 0; }
    if (*(buf + 0) != u8(0x63)) { ret 0; }
    if (*(buf + 1) != u8(0x6C)) { ret 0; }
    if (*(buf + 2) != u8(0x73)) { ret 0; }
    ret 1;
}

fn i64 cmd_is_halt(ptr<u8> buf, i64 len) {
    if (len != 4) { ret 0; }
    if (*(buf + 0) != u8(0x68)) { ret 0; }
    if (*(buf + 1) != u8(0x61)) { ret 0; }
    if (*(buf + 2) != u8(0x6C)) { ret 0; }
    if (*(buf + 3) != u8(0x74)) { ret 0; }
    ret 1;
}

fn i64 cmd_is_echo(ptr<u8> buf, i64 len) {
    if (len < 4) { ret 0; }
    if (*(buf + 0) != u8(0x65)) { ret 0; }
    if (*(buf + 1) != u8(0x63)) { ret 0; }
    if (*(buf + 2) != u8(0x68)) { ret 0; }
    if (*(buf + 3) != u8(0x6F)) { ret 0; }
    ret 1;
}

fn i64 cmd_is_panic(ptr<u8> buf, i64 len) {
    if (len != 5) { ret 0; }
    if (*(buf + 0) != u8(0x70)) { ret 0; }
    if (*(buf + 1) != u8(0x61)) { ret 0; }
    if (*(buf + 2) != u8(0x6E)) { ret 0; }
    if (*(buf + 3) != u8(0x69)) { ret 0; }
    if (*(buf + 4) != u8(0x63)) { ret 0; }
    ret 1;
}

