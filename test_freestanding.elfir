    serial_write_byte(port, u8(0x64));
    serial_write_byte(port, u8(0x3A));
    serial_write_byte(port, u8(0x20));
    serial_write_byte(port, u8(0x3F));
    serial_write_newline(port);
}

fn serial_log_key_up(u16 port) {
    serial_write_byte(port, u8(0x6B));
    serial_write_byte(port, u8(0x65));
    serial_write_byte(port, u8(0x79));
    serial_write_byte(port, u8(0x3A));
    serial_write_byte(port, u8(0x20));
    serial_write_byte(port, u8(0x75));
    serial_write_byte(port, u8(0x70));
    serial_write_newline(port);
}

fn serial_log_key_down(u16 port) {
    serial_write_byte(port, u8(0x6B));
    serial_write_byte(port, u8(0x65));
    serial_write_byte(port, u8(0x79));
    serial_write_byte(port, u8(0x3A));
    serial_write_byte(port, u8(0x20));
    serial_write_byte(port, u8(0x64));
    serial_write_byte(port, u8(0x6F));
    serial_write_byte(port, u8(0x77));
    serial_write_byte(port, u8(0x6E));
    serial_write_newline(port);
}

fn serial_log_key_left(u16 port) {
    serial_write_byte(port, u8(0x6B));
    serial_write_byte(port, u8(0x65));
    serial_write_byte(port, u8(0x79));
    serial_write_byte(port, u8(0x3A));
    serial_write_byte(port, u8(0x20));
    serial_write_byte(port, u8(0x6C));
    serial_write_byte(port, u8(0x65));
    serial_write_byte(port, u8(0x66));
    serial_write_byte(port, u8(0x74));
    serial_write_newline(port);
}

fn serial_log_key_right(u16 port) {
    serial_write_byte(port, u8(0x6B));
    serial_write_byte(port, u8(0x65));
    serial_write_byte(port, u8(0x79));
    serial_write_byte(port, u8(0x3A));
    serial_write_byte(port, u8(0x20));
    serial_write_byte(port, u8(0x72));
    serial_write_byte(port, u8(0x69));
    serial_write_byte(port, u8(0x67));
    serial_write_byte(port, u8(0x68));
    serial_write_byte(port, u8(0x74));
    serial_write_newline(port);
}

fn run_command(ptr<u16> vga, ptr<i64> rowp, ptr<i64> colp, u16 attr, u16 com1, ptr<u8> buf, i64 len) {
    if (len == 0) {
        ret;
    }
    if (cmd_is_help(buf, len)) {
        serial_log_cmd_help(com1);
        tty_write_help(vga, rowp, colp, attr);
        ret;
    }
    if (cmd_is_cls(buf, len)) {
        serial_log_cmd_cls(com1);
        tty_clear(vga, rowp, colp, attr);
        ret;
    }
    if (cmd_is_halt(buf, len)) {
        serial_log_cmd_halt(com1);
        asm0("cli");
        i64 one = 1;
        while (one) {
            asm0("hlt");
        }
    }
    if (cmd_is_panic(buf, len)) {
        serial_log_cmd_panic(com1);
        panic("manual panic");
    }
    if (cmd_is_echo(buf, len)) {
        serial_log_cmd_echo(com1);
        i64 start = 4;
        if (len > 4) {
            if (*(buf + 4) == u8(0x20)) {
                start = 5;
            }
        }
        if (len > start) {
            tty_write_buf(vga, rowp, colp, attr, buf + start, len - start);
        }
        tty_putc(vga, rowp, colp, attr, u8(0x0A));
        ret;
    }
    serial_log_cmd_unknown(com1);
    tty_putc(vga, rowp, colp, attr, u8(0x3F));
    tty_putc(vga, rowp, colp, attr, u8(0x0A));
    ret;
}

fn _start() {
   // i64 x=1;
  //  x/=0;
    u64 fb_base = uefi_get_fb_base();
    u64 fb_stride = uefi_get_fb_stride();
    u64 fb_width = uefi_get_fb_width();
    u64 fb_height = uefi_get_fb_height();
    if (fb_base != u64(0)) {
        ptr<u32> fb_boot = ptr<u32>(fb_base);
        i64 bxpv = 0;
        i64 bypv = 0;
        ptr<i64> bxp = &bxpv;
        ptr<i64> byp = &bypv;
        fb_putc(fb_boot, i64(fb_stride), i64(fb_width), i64(fb_height), bxp, byp, u8(0x42)); // B
        fb_putc(fb_boot, i64(fb_stride), i64(fb_width), i64(fb_height), bxp, byp, u8(0x4F)); // O
        fb_putc(fb_boot, i64(fb_stride), i64(fb_width), i64(fb_height), bxp, byp, u8(0x4F)); // O
        fb_putc(fb_boot, i64(fb_stride), i64(fb_width), i64(fb_height), bxp, byp, u8(0x54)); // T
        fb_putc(fb_boot, i64(fb_stride), i64(fb_width), i64(fb_height), bxp, byp, u8(0x0A)); // \n
        // framebuffer echo for key input
        ptr<u32> fb_out_init = ptr<u32>(fb_base);
        fb_out_init = fb_out_init;
        ptr<u32> fbe = ptr<u32>(fb_base);
        fb_fill_rect(fbe, i64(fb_stride), i64(fb_width), i64(fb_height),
                     400, 100, 48, 16, u32(0x00FF0000));
    }
    i64 uefi = uefi_present();
    i64 uefi_env = uefi_has_st();
    u16 com1 = u16(0x3F8);
    if (fb_base != u64(0)) {
        ptr<u32> fb_dbg1 = ptr<u32>(fb_base);
        i64 dx1 = 0;
        i64 dy1 = 1;
        ptr<i64> dx1p = &dx1;
        ptr<i64> dy1p = &dy1;
        fb_putc(fb_dbg1, i64(fb_stride), i64(fb_width), i64(fb_height), dx1p, dy1p, u8(0x31)); // 1
    }
    if (!uefi_env) {
        serial_init(com1);
        serial_write_kernel_start(com1);
    }
    
    ptr<u16> vga = ptr<u16>(0xB8000);
    u16 attr = u16(0x0F00);
    if (!uefi_env) {
        i64 i = 0;
        while (i < 2000) {
            volatile_store(vga + i, u16(0x20) | attr);
            i += 1;
        }

        i64 base = 996;
        volatile_store(vga + base + 0, u16(0x45) | attr);
        volatile_store(vga + base + 1, u16(0x4C) | attr);
        volatile_store(vga + base + 2, u16(0x46) | attr);
        volatile_store(vga + base + 3, u16(0x49) | attr);
        volatile_store(vga + base + 4, u16(0x52) | attr);
        volatile_store(vga + base + 5, u16(0x20) | attr);
        volatile_store(vga + base + 6, u16(0x4F) | attr);
        volatile_store(vga + base + 7, u16(0x4B) | attr);
    }
    if (fb_base != u64(0)) {
        ptr<u32> fb_dbg2 = ptr<u32>(fb_base);
        i64 dx2 = 0;
        i64 dy2 = 2;
        ptr<i64> dx2p = &dx2;
        ptr<i64> dy2p = &dy2;
        fb_putc(fb_dbg2, i64(fb_stride), i64(fb_width), i64(fb_height), dx2p, dy2p, u8(0x32)); // 2
    }
    if (!uefi_env) {
        serial_write_kernel_init_ok(com1);
    }

    volatile_store(rt_ticks_ptr(), u64(0));
    volatile_store(rt_kbd_head_ptr(), u8(0));
    volatile_store(rt_kbd_tail_ptr(), u8(0));
    kbd_flush();
    idt_init();
    if (fb_base != u64(0)) {
        ptr<u32> fb_dbg3 = ptr<u32>(fb_base);
        i64 dx3 = 0;
        i64 dy3 = 3;
        ptr<i64> dx3p = &dx3;
        ptr<i64> dy3p = &dy3;
        fb_putc(fb_dbg3, i64(fb_stride), i64(fb_width), i64(fb_height), dx3p, dy3p, u8(0x33)); // 3
    }
    rt_i8042_init();
    if (fb_base != u64(0)) {
        ptr<u32> fb_dbg4 = ptr<u32>(fb_base);
        i64 dx4 = 0;
        i64 dy4 = 4;
        ptr<i64> dx4p = &dx4;
        ptr<i64> dy4p = &dy4;
        fb_putc(fb_dbg4, i64(fb_stride), i64(fb_width), i64(fb_height), dx4p, dy4p, u8(0x34)); // 4
    }
    i64 enable_irq = 0;
   //i64 use_irq_kbd = enable_irq;
    i64 use_irq_kbd = 0;
    if (enable_irq) {
        use_irq_kbd = 1;
    }
    if (enable_irq) {
        pic_init();
    }
    if (enable_irq && !use_irq_kbd) {
        // Mask IRQ1 so we only poll i8042 and avoid IRQ handler faults.
        out8(u16(0x21), u8(0xFE));
    }
    if (enable_irq) {
        asm0("sti");
    }

    // Exception test scaffolding (enable one at a time)
    // #DE divide-by-zero (enabled)
    /*  
		i64 a = 1;
		i64 b = 0;
		i64 c = a / b;
		if (c == 0) { asm0("nop"); } 
	*/
    // #DB debug (needs hardware debug regs / single-step)
    // #NMI non-maskable interrupt (external)
    // #BP breakpoint (needs int3 / asm)
    // #OF overflow (needs INTO / asm, or crafted flags)
    // #BR bound range (needs BOUND / asm)
    // #UD invalid opcode (needs ud2 / asm)
    // #NM device-not-available (disable TS then use FPU)
    // #DF double fault (needs faulty handler / stack)
    // #CSO coprocessor segment overrun (reserved)
    // #TS invalid TSS (needs task switch / asm)
    // #NP segment not present (needs segment setup / asm)
    // #SS stack-segment fault (needs bad SS / asm)
    // #GP general protection (bad segment or privilege / asm)
    //
    // #PF page fault  
    /*	
           ptr<u64> p = ptr<u64>(0x40000000);
           u64 v = volatile_load(p);
           if (v == u64(0)) { asm0("nop"); }    
    */		   
    //
    // #RES reserved
    // #MF x87 FPU error (use FPU + unmasked exception)
    // #AC alignment check (needs CR0.AM + EFLAGS.AC)
    // #MC machine check (hardware)
    // #XM SIMD FP exception (use SSE + unmasked exception)
    // #VE virtualization exception (VMX)
    // #CP control protection (CET)
    // #RES reserved (22-31)

    if (!uefi_env) {
        u16 com1c = u16(0x3F8);
        serial_write_kernel_halt(com1c);
    }
    i64 row = 0;
    i64 col = 0;
    ptr<i64> rowp = &row;
    ptr<i64> colp = &col;
    i64 shift = 0;
    ptr<u32> fb_out = ptr<u32>(0);
    i64 fb_out_stride = 0;
    i64 fb_out_width = 0;
    i64 fb_out_height = 0;
    i64 fb_out_x = 0;
    i64 fb_out_y = 0;
    ptr<i64> fb_out_xp = &fb_out_x;
    ptr<i64> fb_out_yp = &fb_out_y;

    if (fb_base != u64(0)) {
        fb_out = ptr<u32>(fb_base);
        fb_out_stride = i64(fb_stride);
        fb_out_width = i64(fb_width);
        fb_out_height = i64(fb_height);
        if (0) {
            i64 map_st = rt_map_fb(fb_base);
            map_st = map_st;
        }
		
		
        i64 fx = 0;
        i64 fy = 0;
        ptr<i64> fxp = &fx;
        ptr<i64> fyp = &fy;
        ptr<u32> fb = ptr<u32>(fb_base);
        i64 delay = 1000000;
        while (delay > 0) {
            delay -= 1;
            asm0("nop");
        }
		
		
		
        fb_fill_rect(fb, i64(fb_stride), i64(fb_width), i64(fb_height),
                     0, 0, i64(fb_width), i64(fb_height), u32(0x00000000));

        if (0) {
        u64 xhci_base = uefi_get_xhci_base();
		
        if (0) {
            fb_write_xhci_base_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
            fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, xhci_base);
            fb_mark_line(fb, i64(fb_stride), i64(fb_width), i64(fb_height), *fyp, u32(0x00FF8800));
            fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x0A));
        }

        ptr<u32> cap_reg = ptr<u32>(xhci_base);
        u32 cap0 = volatile_load(cap_reg);
        u8 caplen = u8(cap0 & u32(0xFF));
        u16 hci_ver = u16((cap0 >> u32(16)) & u32(0xFFFF));

        if (0) {
            fb_write_caplen_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
            fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(caplen));
            fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x20));
            fb_write_hciver_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
            fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(hci_ver));
            fb_mark_line(fb, i64(fb_stride), i64(fb_width), i64(fb_height), *fyp, u32(0x0000FF00));
            fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x0A));
        }
		


        ptr<u32> hcs1_reg = ptr<u32>(xhci_base + u64(0x04));
        ptr<u32> hcs2_reg = ptr<u32>(xhci_base + u64(0x08));
        ptr<u32> hcs3_reg = ptr<u32>(xhci_base + u64(0x0C));
        ptr<u32> dboff_reg = ptr<u32>(xhci_base + u64(0x14));
        ptr<u32> rtsoff_reg = ptr<u32>(xhci_base + u64(0x18));

        u32 hcs1 = volatile_load(hcs1_reg);
        u32 hcs2 = volatile_load(hcs2_reg);
        u32 hcs3 = volatile_load(hcs3_reg);
        u32 dboff = volatile_load(dboff_reg);
        u32 rtsoff = volatile_load(rtsoff_reg);
        u8 max_ports = u8((hcs1 >> u32(24)) & u32(0xFF));
        u8 max_slots = u8(hcs1 & u32(0xFF));

        if (0) {
            fb_write_hcs1_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
            fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(hcs1));
            fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x0A));

            fb_write_hcs2_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
            fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(hcs2));
            fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x0A));

            fb_write_hcs3_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
            fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(hcs3));
            fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x0A));

            fb_write_dboff_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
            fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(dboff));
            fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x0A));

            fb_write_rtsoff_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
            fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(rtsoff));
            fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x0A));

            fb_write_ports_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
            fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(max_ports));
            fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x0A));

            fb_write_slots_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
            fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(max_slots));
            fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x0A));
        }

        ptr<u32> hcc1_reg = ptr<u32>(xhci_base + u64(0x10));
        u32 hcc1 = volatile_load(hcc1_reg);
        u32 ecp = (hcc1 >> u32(16)) & u32(0xFFFF);
        u64 ecp_off = u64(ecp) * u64(4);
        if (0) {
            fb_write_hcc1_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
            fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(hcc1));
            fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x0A));
            fb_write_ecp_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
            fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(ecp_off));
            fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x0A));
        }

        if (ecp_off != u64(0)) {
            u64 cur_ecp = ecp_off;
            i64 guard = 32;
            while (guard > 0 && cur_ecp != u64(0)) {
                ptr<u32> caphdr_reg = ptr<u32>(xhci_base + cur_ecp);
                u32 caphdr = volatile_load(caphdr_reg);
                u8 cap_id = u8(caphdr & u32(0xFF));
                u8 next = u8((caphdr >> u32(8)) & u32(0xFF));
                if (cap_id == u8(2)) {
                    ptr<u32> sp_d1_reg = ptr<u32>(xhci_base + cur_ecp + u64(0x04));
                    ptr<u32> sp_d2_reg = ptr<u32>(xhci_base + cur_ecp + u64(0x08));
                    u32 sp_d1 = volatile_load(sp_d1_reg);
                    u32 sp_d2 = volatile_load(sp_d2_reg);
                    u8 poff = u8(sp_d2 & u32(0xFF));
                    u8 pcnt = u8((sp_d2 >> u32(8)) & u32(0xFF));
                    if (0) {
                        fb_write_spd1_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
                        fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(sp_d1));
                        fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x0A));
                        fb_write_spd2_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
                        fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(sp_d2));
                        fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x0A));
                        fb_write_poff_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
                        fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(poff));
                        fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x20));
                        fb_write_pcnt_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
                        fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(pcnt));
                        fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x0A));
                    }
                }
                if (cap_id == u8(1)) {
                    ptr<u32> legsup = ptr<u32>(xhci_base + cur_ecp);
                    u32 leg = volatile_load(legsup);
                    u32 bios = (leg >> u32(16)) & u32(1);
                    u32 os = (leg >> u32(24)) & u32(1);
                    fb_write_leg_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
                    fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(leg));
                    fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x0A));
                    fb_write_bios_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
                    fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(bios));
                    fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x0A));
                    fb_write_os_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
                    fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(os));
                    fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x0A));

                    u32 leg2 = leg | u32(1 << 24);
                    volatile_store(legsup, leg2);
                    i64 waitb = 2000000;
                    while (waitb > 0) {
                        u32 l2 = volatile_load(legsup);
                        if (((l2 >> u32(16)) & u32(1)) == u32(0)) { break; }
                        waitb -= 1;
                    }
                    u32 leg_after = volatile_load(legsup);
                    fb_write_leg_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
                    fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(leg_after));
                    fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x0A));
                    break;
                }
