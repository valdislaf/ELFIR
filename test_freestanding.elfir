        ptr<i64> fyp = &fy;
        ptr<u32> fb = ptr<u32>(fb_base);
        i64 delay = 1000000;
        while (delay > 0) {
            delay -= 1;
            asm0("nop");
        }
		
		
		
        fb_fill_rect(fb, i64(fb_stride), i64(fb_width), i64(fb_height),
                     0, 0, i64(fb_width), i64(fb_height), u32(0x00000000));

        if (1) {
        u64 xhci_base = uefi_get_xhci_base();
        dbg_mark(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0));
        u8 xbus = u8(0);
        u8 xdev = u8(0);
        u8 xfn = u8(0);
        u64 xhci_pci_base = pci_find_xhci_base(&xbus, &xdev, &xfn);
        dbg_mark(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(1));
