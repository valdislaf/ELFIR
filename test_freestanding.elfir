fn fb_write_portsc_label(ptr<u32> fb, i64 stride, i64 width, i64 height, ptr<i64> xp, ptr<i64> yp, i64 port) {
    fb_putc(fb, stride, width, height, xp, yp, u8(0x50)); // P
    fb_putc(fb, stride, width, height, xp, yp, u8(0x4F)); // O
    fb_putc(fb, stride, width, height, xp, yp, u8(0x52)); // R
    fb_putc(fb, stride, width, height, xp, yp, u8(0x54)); // T
    u8 dig = u8(0x30) + u8(port);
    fb_putc(fb, stride, width, height, xp, yp, dig);
    fb_putc(fb, stride, width, height, xp, yp, u8(0x3D)); // =
    ret;
}

fn fb_write_portr_label(ptr<u32> fb, i64 stride, i64 width, i64 height, ptr<i64> xp, ptr<i64> yp, i64 port) {
    fb_putc(fb, stride, width, height, xp, yp, u8(0x50)); // P
    fb_putc(fb, stride, width, height, xp, yp, u8(0x4F)); // O
    fb_putc(fb, stride, width, height, xp, yp, u8(0x52)); // R
    fb_putc(fb, stride, width, height, xp, yp, u8(0x54)); // T
    u8 dig = u8(0x30) + u8(port);
    fb_putc(fb, stride, width, height, xp, yp, dig);
    fb_putc(fb, stride, width, height, xp, yp, u8(0x52)); // R
    fb_putc(fb, stride, width, height, xp, yp, u8(0x3D)); // =
    ret;
}

fn fb_write_portu_label(ptr<u32> fb, i64 stride, i64 width, i64 height, ptr<i64> xp, ptr<i64> yp, i64 port) {
    fb_putc(fb, stride, width, height, xp, yp, u8(0x50)); // P
    fb_putc(fb, stride, width, height, xp, yp, u8(0x4F)); // O
    fb_putc(fb, stride, width, height, xp, yp, u8(0x52)); // R
    fb_putc(fb, stride, width, height, xp, yp, u8(0x54)); // T
    u8 dig = u8(0x30) + u8(port);
    fb_putc(fb, stride, width, height, xp, yp, dig);
    fb_putc(fb, stride, width, height, xp, yp, u8(0x55)); // U
    fb_putc(fb, stride, width, height, xp, yp, u8(0x3D)); // =
    ret;
}

fn fb_write_slots_label(ptr<u32> fb, i64 stride, i64 width, i64 height, ptr<i64> xp, ptr<i64> yp) {
    fb_putc(fb, stride, width, height, xp, yp, u8(0x53)); // S
    fb_putc(fb, stride, width, height, xp, yp, u8(0x4C)); // L
