fn run_command(ptr<u16> vga, ptr<i64> rowp, ptr<i64> colp, u16 attr, u16 com1, ptr<u8> buf, i64 len) {
    if (len == 0) {
        ret;
    }
    if (cmd_is_help(buf, len)) {
        serial_log_cmd_help(com1);
        tty_write_help(vga, rowp, colp, attr);
        ret;
    }
    if (cmd_is_cls(buf, len)) {
        serial_log_cmd_cls(com1);
        tty_clear(vga, rowp, colp, attr);
        ret;
    }
    if (cmd_is_halt(buf, len)) {
        serial_log_cmd_halt(com1);
        asm0("cli");
        i64 one = 1;
        while (one) {
            asm0("hlt");
        }
    }
    if (cmd_is_panic(buf, len)) {
        serial_log_cmd_panic(com1);
        panic("manual panic");
    }
    if (cmd_is_echo(buf, len)) {
        serial_log_cmd_echo(com1);
        i64 start = 4;
        if (len > 4) {
            if (*(buf + 4) == u8(0x20)) {
                start = 5;
            }
        }
        if (len > start) {
            tty_write_buf(vga, rowp, colp, attr, buf + start, len - start);
        }
        tty_putc(vga, rowp, colp, attr, u8(0x0A));
        ret;
    }
    serial_log_cmd_unknown(com1);
    tty_putc(vga, rowp, colp, attr, u8(0x3F));
    tty_putc(vga, rowp, colp, attr, u8(0x0A));
    ret;
}

fn _start() {
   // i64 x=1;
  //  x/=0;
    u64 fb_base = uefi_get_fb_base();
    u64 fb_stride = uefi_get_fb_stride();
    u64 fb_width = uefi_get_fb_width();
    u64 fb_height = uefi_get_fb_height();
    if (fb_base != u64(0)) {
        ptr<u32> fb0 = ptr<u32>(fb_base);
        fb_fill_rect(fb0, i64(fb_stride), i64(fb_width), i64(fb_height),
                     0, 200, 64, 32, u32(0x00FF0000));
    }
    i64 uefi = uefi_present();
    i64 uefi_env = uefi_has_st();
    if (!uefi_env) {
        u16 com1 = u16(0x3F8);
        serial_init(com1);
        serial_write_kernel_start(com1);
    }

    ptr<u16> vga = ptr<u16>(0xB8000);
    u16 attr = u16(0x0F00);
    if (!uefi_env) {
        i64 i = 0;
        while (i < 2000) {
            volatile_store(vga + i, u16(0x20) | attr);
            i += 1;
        }

        i64 base = 996;
        volatile_store(vga + base + 0, u16(0x45) | attr);
        volatile_store(vga + base + 1, u16(0x4C) | attr);
        volatile_store(vga + base + 2, u16(0x46) | attr);
        volatile_store(vga + base + 3, u16(0x49) | attr);
        volatile_store(vga + base + 4, u16(0x52) | attr);
        volatile_store(vga + base + 5, u16(0x20) | attr);
        volatile_store(vga + base + 6, u16(0x4F) | attr);
        volatile_store(vga + base + 7, u16(0x4B) | attr);
    }
    i64 stop1 = 1;
    ptr<i64> stop1p = &stop1;
    while (volatile_load(stop1p) == i64(1)) {
        asm0("nop");
    }

    if (!uefi_env) {
        u16 com1b = u16(0x3F8);
        serial_write_kernel_init_ok(com1b);
    }

    volatile_store(rt_ticks_ptr(), u64(0));
    volatile_store(rt_kbd_head_ptr(), u8(0));
    volatile_store(rt_kbd_tail_ptr(), u8(0));
    kbd_flush();
    i64 enable_irq = 1;
    i64 use_irq_kbd = enable_irq;
    if (uefi_env) {
        enable_irq = 0;
        use_irq_kbd = 0;
    }
    if (enable_irq) {
        asm0("sti");
    }

    // Exception test scaffolding (enable one at a time)
    // #DE divide-by-zero (enabled)
    /*  
		i64 a = 1;
		i64 b = 0;
		i64 c = a / b;
		if (c == 0) { asm0("nop"); } 
	*/
    // #DB debug (needs hardware debug regs / single-step)
    // #NMI non-maskable interrupt (external)
    // #BP breakpoint (needs int3 / asm)
    // #OF overflow (needs INTO / asm, or crafted flags)
    // #BR bound range (needs BOUND / asm)
    // #UD invalid opcode (needs ud2 / asm)
    // #NM device-not-available (disable TS then use FPU)
    // #DF double fault (needs faulty handler / stack)
    // #CSO coprocessor segment overrun (reserved)
    // #TS invalid TSS (needs task switch / asm)
    // #NP segment not present (needs segment setup / asm)
    // #SS stack-segment fault (needs bad SS / asm)
    // #GP general protection (bad segment or privilege / asm)
    //
    // #PF page fault  
    /*	
           ptr<u64> p = ptr<u64>(0x40000000);
           u64 v = volatile_load(p);
           if (v == u64(0)) { asm0("nop"); }    
    */		   
    //
    // #RES reserved
    // #MF x87 FPU error (use FPU + unmasked exception)
    // #AC alignment check (needs CR0.AM + EFLAGS.AC)
    // #MC machine check (hardware)
    // #XM SIMD FP exception (use SSE + unmasked exception)
    // #VE virtualization exception (VMX)
    // #CP control protection (CET)
    // #RES reserved (22-31)

    if (!uefi_env) {
        u16 com1c = u16(0x3F8);
        serial_write_kernel_halt(com1c);
    }
    i64 row = 0;
    i64 col = 0;
    ptr<i64> rowp = &row;
    ptr<i64> colp = &col;
    i64 shift = 0;

    if (fb_base != u64(0)) {
        if (!uefi_has_st()) {
            i64 map_st = rt_map_fb(fb_base);
            map_st = map_st;
        }
        i64 fx = 0;
        i64 fy = 0;
        ptr<i64> fxp = &fx;
        ptr<i64> fyp = &fy;
        ptr<u32> fb = ptr<u32>(fb_base);

        fb_fill_rect(fb, i64(fb_stride), i64(fb_width), i64(fb_height),
                     0, 40, 64, 32, u32(0x00FF0000));

        u64 xhci_base = uefi_get_xhci_base();
        fb_write_xhci_base_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
        fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, xhci_base);
        fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x0A));

        ptr<u32> cap_reg = ptr<u32>(xhci_base);
        u32 cap0 = volatile_load(cap_reg);
        u8 caplen = u8(cap0 & u32(0xFF));
        u16 hci_ver = u16((cap0 >> u32(16)) & u32(0xFFFF));

        fb_write_caplen_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
        fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(caplen));
        fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x20));
        fb_write_hciver_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp);
        fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(hci_ver));
        fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x0A));

        i64 fb_hold = 1;
        while (fb_hold) {
            asm0("hlt");
        }
    }

    ptr<u8> line = rt_uefi_line();
    ptr<u8> last_line = rt_uefi_last_line();
    ptr<u8> hist_base = rt_uefi_hist_base();
    ptr<u8> hist_len_base = rt_uefi_hist_len_base();
    ptr<u8> edit_buf = rt_uefi_edit_buf();
    i64 len = 0;
    i64 last_len = 0;
    i64 prev_len = 0;
    i64 cur = 0;
    i64 cap = 256;
    i64 hist_head = 0;
    i64 hist_count = 0;
    i64 hist_nav = -1;
    i64 edit_len = 0;
    i64 e0 = 0;
    i64 line_row = 0;
    i64 line_col = 0;

    tty_clear(vga, rowp, colp, attr);
    tty_write_prompt(vga, rowp, colp, attr);
    line_row = *rowp;
    line_col = *colp;
    serial_write_byte(com1, u8(0x3E));
    serial_write_byte(com1, u8(0x20));

    i64 one = 1;
    while (one) {
        u64 key = u64(0);
        u16 uefi_uc = u16(0);
        u16 uefi_sc = u16(0);
        if (uefi) {
            key = uefi_read_key();
            if (key != u64(0)) {
                uefi_uc = u16(key & u64(0xFFFF));
                uefi_sc = u16((key >> u64(16)) & u64(0xFFFF));
            }
        }
        if (uefi && ((uefi_uc != u16(0)) || (uefi_sc != u16(0)))) {
            if (uefi_sc != u16(0)) {
                if (uefi_sc == u16(1)) {
                    if (hist_count > 0) {
                        serial_log_key_up(com1);
                        if (hist_nav < 0) {
                            line_copy(edit_buf, line, len);
                            edit_len = len;
                            hist_nav = hist_head - 1;
                            if (hist_nav < 0) { hist_nav += 8; }
                        } else {
                        i64 uefi_oldest = hist_head - hist_count;
                        while (uefi_oldest < 0) { uefi_oldest += 8; }
                        if (hist_nav != uefi_oldest) {
                            hist_nav = hist_nav - 1;
                            if (hist_nav < 0) { hist_nav += 8; }
                        }
                    }
                    ptr<u8> uefi_src = hist_entry_ptr(hist_base, hist_nav);
                    len = hist_get_len(hist_len_base, hist_nav);
                    line_copy(line, uefi_src, len);
                    cur = len;
                    line_redraw(vga, rowp, colp, attr, line_row, line_col, line, len, prev_len, cur);
                    prev_len = len;
                    }
                } else {
                    if (uefi_sc == u16(2)) {
                        if (hist_nav >= 0) {
                            serial_log_key_down(com1);
                            i64 newest = hist_head - 1;
                            if (newest < 0) { newest += 8; }
                            if (hist_nav == newest) {
                                hist_nav = -1;
                                line_copy(line, edit_buf, edit_len);
                                len = edit_len;
                            } else {
                                hist_nav = hist_nav + 1;
                                if (hist_nav >= 8) { hist_nav -= 8; }
                                ptr<u8> src2 = hist_entry_ptr(hist_base, hist_nav);
                                len = hist_get_len(hist_len_base, hist_nav);
                                line_copy(line, src2, len);
                            }
                            cur = len;
                            line_redraw(vga, rowp, colp, attr, line_row, line_col, line, len, prev_len, cur);
                            prev_len = len;
                        }
                    } else {
                        if (uefi_sc == u16(4)) {
                            if (cur > 0) {
                                serial_log_key_left(com1);
                                cur -= 1;
                                line_redraw(vga, rowp, colp, attr, line_row, line_col, line, len, prev_len, cur);
                            }
                        } else {
                            if (uefi_sc == u16(3)) {
                                if (cur < len) {
                                    serial_log_key_right(com1);
                                    cur += 1;
                                    line_redraw(vga, rowp, colp, attr, line_row, line_col, line, len, prev_len, cur);
                                }
                            }
                        }
                    }
                }
                continue;
            }
            if (uefi_uc != u16(0)) {
                u8 uefi_ch = u8(uefi_uc);
                if (uefi_ch == u8(0x0D)) { uefi_ch = u8(0x0A); }
                if (uefi_ch == u8(0x08)) {
                    if (cur > 0) {
                        i64 uefi_k = cur - 1;
                        while (uefi_k < len - 1) {
                            *(line + uefi_k) = *(line + uefi_k + 1);
                            uefi_k += 1;
                        }
                        len -= 1;
                        cur -= 1;
                        line_redraw(vga, rowp, colp, attr, line_row, line_col, line, len, prev_len, cur);
                        prev_len = len;
                    }
                    continue;
                }
                if (uefi_ch == u8(0x0A)) {
                    serial_write_newline(com1);
                    tty_putc(vga, rowp, colp, attr, uefi_ch);
                    if (len > 0) {
                        line_copy(last_line, line, len);
                        last_len = len;
                        ptr<u8> uefi_dst = hist_entry_ptr(hist_base, hist_head);
                        line_copy(uefi_dst, line, len);
                        hist_set_len(hist_len_base, hist_head, len);
                        hist_head += 1;
                        if (hist_head >= 8) { hist_head = 0; }
                        if (hist_count < 8) { hist_count += 1; }
                    }
                    run_command(vga, rowp, colp, attr, com1, line, len);
                    len = 0;
                    cur = 0;
                    prev_len = 0;
                    hist_nav = -1;
                    tty_write_prompt(vga, rowp, colp, attr);
                    line_row = *rowp;
                    line_col = *colp;
                    serial_write_byte(com1, u8(0x3E));
                    serial_write_byte(com1, u8(0x20));
                    continue;
                }
                if (uefi_ch < u8(0x20)) {
                    continue;
                }
                if (len >= cap - 1) {
                    continue;
                }
                i = len;
                while (i > cur) {
                    *(line + i) = *(line + i - 1);
                    i -= 1;
                }
                *(line + cur) = uefi_ch;
                len += 1;
                cur += 1;
                serial_write_byte(com1, uefi_ch);
                line_redraw(vga, rowp, colp, attr, line_row, line_col, line, len, prev_len, cur);
                prev_len = len;
                continue;
            }
        }

        u8 sc = u8(0);
        if (use_irq_kbd) {
            sc = kbd_read_scancode_irq();
        } else {
            sc = kbd_read_scancode();
        }
        if (sc == u8(0)) {
            continue;
        }
        if (sc == u8(0xE0)) {
            e0 = 1;
            continue;
        }
        if (sc == u8(0xE1)) {
            continue;
        }
        if (e0) {
            if (sc == u8(0x48)) {
                if (hist_count > 0) {
                    serial_log_key_up(com1);
                    if (hist_nav < 0) {
                        line_copy(edit_buf, line, len);
                        edit_len = len;
                        hist_nav = hist_head - 1;
                        if (hist_nav < 0) { hist_nav += 8; }
                    } else {
                        i64 oldest2 = hist_head - hist_count;
                        while (oldest2 < 0) { oldest2 += 8; }
                        if (hist_nav != oldest2) {
                            hist_nav = hist_nav - 1;
                            if (hist_nav < 0) { hist_nav += 8; }
                        }
                    }
                    ptr<u8> src = hist_entry_ptr(hist_base, hist_nav);
                    len = hist_get_len(hist_len_base, hist_nav);
                    line_copy(line, src, len);
                    cur = len;
                    line_redraw(vga, rowp, colp, attr, line_row, line_col, line, len, prev_len, cur);
                    prev_len = len;
                }
            } else {
                if (sc == u8(0x50)) {
                    if (hist_nav >= 0) {
                        serial_log_key_down(com1);
                        i64 uefi_newest = hist_head - 1;
                        if (uefi_newest < 0) { uefi_newest += 8; }
                        if (hist_nav == uefi_newest) {
                            hist_nav = -1;
                            line_copy(line, edit_buf, edit_len);
                            len = edit_len;
                        } else {
                            hist_nav = hist_nav + 1;
                            if (hist_nav >= 8) { hist_nav -= 8; }
                            ptr<u8> uefi_src2 = hist_entry_ptr(hist_base, hist_nav);
                            len = hist_get_len(hist_len_base, hist_nav);
                            line_copy(line, uefi_src2, len);
                        }
                        cur = len;
                        line_redraw(vga, rowp, colp, attr, line_row, line_col, line, len, prev_len, cur);
                        prev_len = len;
                    }
                } else {
                    if (sc == u8(0x4B)) {
                        if (cur > 0) {
                            serial_log_key_left(com1);
                            cur -= 1;
                            line_redraw(vga, rowp, colp, attr, line_row, line_col, line, len, prev_len, cur);
                        }
                    } else {
                        if (sc == u8(0x4D)) {
                            if (cur < len) {
                                serial_log_key_right(com1);
                                cur += 1;
                                line_redraw(vga, rowp, colp, attr, line_row, line_col, line, len, prev_len, cur);
                            }
                        }
                    }
                }
            }
            e0 = 0;
            continue;
        }
        if ((sc & u8(0x80)) != u8(0)) {
            u8 rel = sc & u8(0x7F);
            if ((rel == u8(0x2A)) || (rel == u8(0x36))) {
                shift = 0;
            }
            continue;
        }
        if ((sc == u8(0x2A)) || (sc == u8(0x36))) {
            shift = 1;
            continue;
        }
        u8 ch = kbd_scancode_to_ascii(sc, shift);
        if (ch == u8(0)) {
            continue;
        }
        if (ch == u8(0x08)) {
            if (cur > 0) {
                i64 k = cur - 1;
                while (k < len - 1) {
                    *(line + k) = *(line + k + 1);
                    k += 1;
                }
                len -= 1;
                cur -= 1;
                line_redraw(vga, rowp, colp, attr, line_row, line_col, line, len, prev_len, cur);
                prev_len = len;
            }
            continue;
        }
        if (ch == u8(0x0A)) {
            serial_write_newline(com1);
            tty_putc(vga, rowp, colp, attr, ch);
            if (len > 0) {
                line_copy(last_line, line, len);
                last_len = len;
                ptr<u8> dst = hist_entry_ptr(hist_base, hist_head);
                line_copy(dst, line, len);
                hist_set_len(hist_len_base, hist_head, len);
                hist_head += 1;
                if (hist_head >= 8) { hist_head = 0; }
                if (hist_count < 8) { hist_count += 1; }
            }
            run_command(vga, rowp, colp, attr, com1, line, len);
            len = 0;
            cur = 0;
            prev_len = 0;
            hist_nav = -1;
            tty_write_prompt(vga, rowp, colp, attr);
            line_row = *rowp;
            line_col = *colp;
            serial_write_byte(com1, u8(0x3E));
            serial_write_byte(com1, u8(0x20));
            continue;
        }
        if (ch < u8(0x20)) {
            continue;
        }
        if (len >= cap - 1) {
            continue;
        }
        i = len;
        while (i > cur) {
            *(line + i) = *(line + i - 1);
            i -= 1;
        }
        *(line + cur) = ch;
        len += 1;
        cur += 1;
        serial_write_byte(com1, ch);
        line_redraw(vga, rowp, colp, attr, line_row, line_col, line, len, prev_len, cur);
        prev_len = len;
    }
}
