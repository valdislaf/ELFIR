            pci_flr(xbus, xdev, xfn);
            dbg_mark(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(3));
            u32 cmdreg = pci_read32(xbus, xdev, xfn, u8(0x04));
            cmdreg = cmdreg | u32(1 << 1) | u32(1 << 2);
            pci_write32(xbus, xdev, xfn, u8(0x04), cmdreg);
