fn run_command(ptr<u16> vga, ptr<i64> rowp, ptr<i64> colp, u16 attr, u16 com1, ptr<u8> buf, i64 len) {
    if (len == 0) {
        ret;
    }
    if (cmd_is_help(buf, len)) {
        serial_log_cmd_help(com1);
        tty_write_help(vga, rowp, colp, attr);
        ret;
    }
    if (cmd_is_cls(buf, len)) {
        serial_log_cmd_cls(com1);
        tty_clear(vga, rowp, colp, attr);
        ret;
    }
    if (cmd_is_halt(buf, len)) {
        serial_log_cmd_halt(com1);
        asm0("cli");
        i64 one = 1;
        while (one) {
            asm0("hlt");
        }
    }
    if (cmd_is_panic(buf, len)) {
        serial_log_cmd_panic(com1);
        panic("manual panic");
    }
    if (cmd_is_echo(buf, len)) {
        serial_log_cmd_echo(com1);
        i64 start = 4;
        if (len > 4) {
            if (*(buf + 4) == u8(0x20)) {
                start = 5;
            }
        }
        if (len > start) {
            tty_write_buf(vga, rowp, colp, attr, buf + start, len - start);
        }
        tty_putc(vga, rowp, colp, attr, u8(0x0A));
        ret;
    }
    serial_log_cmd_unknown(com1);
    tty_putc(vga, rowp, colp, attr, u8(0x3F));
    tty_putc(vga, rowp, colp, attr, u8(0x0A));
    ret;
}

fn _start() {
   // i64 x=1;
  //  x/=0;
    u64 fb_base = uefi_get_fb_base();
    u64 fb_stride = uefi_get_fb_stride();
    u64 fb_width = uefi_get_fb_width();
    u64 fb_height = uefi_get_fb_height();
    if (fb_base != u64(0)) {
        ptr<u32> fb_boot = ptr<u32>(fb_base);
        i64 bxpv = 0;
        i64 bypv = 0;
        ptr<i64> bxp = &bxpv;
        ptr<i64> byp = &bypv;
        fb_putc(fb_boot, i64(fb_stride), i64(fb_width), i64(fb_height), bxp, byp, u8(0x42)); // B
        fb_putc(fb_boot, i64(fb_stride), i64(fb_width), i64(fb_height), bxp, byp, u8(0x4F)); // O
        fb_putc(fb_boot, i64(fb_stride), i64(fb_width), i64(fb_height), bxp, byp, u8(0x4F)); // O
        fb_putc(fb_boot, i64(fb_stride), i64(fb_width), i64(fb_height), bxp, byp, u8(0x54)); // T
        fb_putc(fb_boot, i64(fb_stride), i64(fb_width), i64(fb_height), bxp, byp, u8(0x0A)); // \n
        // framebuffer echo for key input
        ptr<u32> fb_out_init = ptr<u32>(fb_base);
        fb_out_init = fb_out_init;
        ptr<u32> fbe = ptr<u32>(fb_base);
        fb_fill_rect(fbe, i64(fb_stride), i64(fb_width), i64(fb_height),
                     400, 100, 48, 16, u32(0x00FF0000));
    }
    i64 uefi = uefi_present();
    i64 uefi_env = uefi_has_st();
    u16 com1 = u16(0x3F8);
    if (fb_base != u64(0)) {
        ptr<u32> fb_dbg1 = ptr<u32>(fb_base);
        i64 dx1 = 0;
        i64 dy1 = 1;
        ptr<i64> dx1p = &dx1;
        ptr<i64> dy1p = &dy1;
        fb_putc(fb_dbg1, i64(fb_stride), i64(fb_width), i64(fb_height), dx1p, dy1p, u8(0x31)); // 1
    }
    if (!uefi_env) {
        serial_init(com1);
        serial_write_kernel_start(com1);
    }
    
    ptr<u16> vga = ptr<u16>(0xB8000);
    u16 attr = u16(0x0F00);
    if (!uefi_env) {
        i64 i = 0;
        while (i < 2000) {
            volatile_store(vga + i, u16(0x20) | attr);
            i += 1;
        }

        i64 base = 996;
        volatile_store(vga + base + 0, u16(0x45) | attr);
        volatile_store(vga + base + 1, u16(0x4C) | attr);
        volatile_store(vga + base + 2, u16(0x46) | attr);
        volatile_store(vga + base + 3, u16(0x49) | attr);
        volatile_store(vga + base + 4, u16(0x52) | attr);
        volatile_store(vga + base + 5, u16(0x20) | attr);
        volatile_store(vga + base + 6, u16(0x4F) | attr);
        volatile_store(vga + base + 7, u16(0x4B) | attr);
    }
    if (fb_base != u64(0)) {
        ptr<u32> fb_dbg2 = ptr<u32>(fb_base);
        i64 dx2 = 0;
        i64 dy2 = 2;
        ptr<i64> dx2p = &dx2;
        ptr<i64> dy2p = &dy2;
        fb_putc(fb_dbg2, i64(fb_stride), i64(fb_width), i64(fb_height), dx2p, dy2p, u8(0x32)); // 2
    }
    if (!uefi_env) {
        serial_write_kernel_init_ok(com1);
    }

    volatile_store(rt_ticks_ptr(), u64(0));
    volatile_store(rt_kbd_head_ptr(), u8(0));
    volatile_store(rt_kbd_tail_ptr(), u8(0));
    kbd_flush();
    idt_init();
    if (fb_base != u64(0)) {
        ptr<u32> fb_dbg3 = ptr<u32>(fb_base);
        i64 dx3 = 0;
        i64 dy3 = 3;
        ptr<i64> dx3p = &dx3;
        ptr<i64> dy3p = &dy3;
        fb_putc(fb_dbg3, i64(fb_stride), i64(fb_width), i64(fb_height), dx3p, dy3p, u8(0x33)); // 3
    }
    rt_i8042_init();
    if (fb_base != u64(0)) {
        ptr<u32> fb_dbg4 = ptr<u32>(fb_base);
        i64 dx4 = 0;
        i64 dy4 = 4;
        ptr<i64> dx4p = &dx4;
        ptr<i64> dy4p = &dy4;
        fb_putc(fb_dbg4, i64(fb_stride), i64(fb_width), i64(fb_height), dx4p, dy4p, u8(0x34)); // 4
    }
    i64 enable_irq = 0;
   //i64 use_irq_kbd = enable_irq;
    i64 use_irq_kbd = 0;
    if (enable_irq) {
        use_irq_kbd = 1;
    }
    if (enable_irq) {
        pic_init();
    }
    if (enable_irq && !use_irq_kbd) {
        // Mask IRQ1 so we only poll i8042 and avoid IRQ handler faults.
        out8(u16(0x21), u8(0xFE));
    }
    if (enable_irq) {
        asm0("sti");
    }

    // Exception test scaffolding (enable one at a time)
    // #DE divide-by-zero (enabled)
    /*  
		i64 a = 1;
		i64 b = 0;
		i64 c = a / b;
		if (c == 0) { asm0("nop"); } 
	*/
    // #DB debug (needs hardware debug regs / single-step)
    // #NMI non-maskable interrupt (external)
    // #BP breakpoint (needs int3 / asm)
    // #OF overflow (needs INTO / asm, or crafted flags)
    // #BR bound range (needs BOUND / asm)
    // #UD invalid opcode (needs ud2 / asm)
    // #NM device-not-available (disable TS then use FPU)
    // #DF double fault (needs faulty handler / stack)
    // #CSO coprocessor segment overrun (reserved)
    // #TS invalid TSS (needs task switch / asm)
    // #NP segment not present (needs segment setup / asm)
    // #SS stack-segment fault (needs bad SS / asm)
    // #GP general protection (bad segment or privilege / asm)
    //
    // #PF page fault  
    /*	
           ptr<u64> p = ptr<u64>(0x40000000);
           u64 v = volatile_load(p);
           if (v == u64(0)) { asm0("nop"); }    
    */		   
    //
    // #RES reserved
    // #MF x87 FPU error (use FPU + unmasked exception)
    // #AC alignment check (needs CR0.AM + EFLAGS.AC)
    // #MC machine check (hardware)
    // #XM SIMD FP exception (use SSE + unmasked exception)
    // #VE virtualization exception (VMX)
    // #CP control protection (CET)
    // #RES reserved (22-31)

    if (!uefi_env) {
