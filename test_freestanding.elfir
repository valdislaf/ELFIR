        if (0) {
            i64 pu = 1;
            while (pu <= i64(max_ports)) {
                u64 portsc_addr3 = op_base2 + u64(0x400) + u64(pu - 1) * u64(0x10);
                ptr<u32> portsc_reg3 = ptr<u32>(portsc_addr3);
                u32 psu = volatile_load(portsc_reg3);
                u32 psu2 = psu & u32(0xFFFFFE1F);
                psu2 = psu2 | u32(0x00010000) | u32(0x00000200) | rw1c_mask;
                volatile_store(portsc_reg3, psu2);
                i64 wu = 200000;
                while (wu > 0) {
                    wu -= 1;
                }
                u32 psu_done = volatile_load(portsc_reg3);
                fb_write_portu_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, pu);
                fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(psu_done));
                fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x0A));
