fn xhci_write_trb(ptr<u32> ring32, i64 trb_idx, u32 d0, u32 d1, u32 d2, u32 d3) {
    ptr<u32> base = ring32 + trb_idx * 4;
    *(base + 0) = d0;
    *(base + 1) = d1;
    *(base + 2) = d2;
    *(base + 3) = d3;
    ret;
}

fn xhci_zero(ptr<u8> p, i64 bytes) {
    i64 i = 0;
    while (i < bytes) {
        *(p + i) = u8(0);
        i += 1;
    }
    ret;
}

fn xhci_cmd_ring_init(ptr<u8> cmd_ring, u32 cycle) {
    ptr<u32> ring32 = ptr<u32>(u64(cmd_ring));
    i64 link_idx = 255;
    u64 ring_addr = u64(cmd_ring);
    u32 link_d0 = u32(ring_addr & u64(0xFFFFFFFF));
    u32 link_d1 = u32((ring_addr >> u64(32)) & u64(0xFFFFFFFF));
    u32 link_d2 = u32(0);
    u32 link_d3 = u32(0);
    link_d3 = link_d3 | (cycle & u32(1));
    link_d3 = link_d3 | u32(1 << 1);
    link_d3 = link_d3 | u32(6 << 10);
    xhci_write_trb(ring32, link_idx, link_d0, link_d1, link_d2, link_d3);
    ret;
}

fn xhci_cmd_enqueue(ptr<u8> cmd_ring, ptr<i64> idxp, ptr<u32> cyclep, u32 d0, u32 d1, u32 d2, u32 d3) {
    ptr<u32> ring32 = ptr<u32>(u64(cmd_ring));
    i64 idx = *idxp;
    u32 cycle = *cyclep;
    d3 = d3 | (cycle & u32(1));
    xhci_write_trb(ring32, idx, d0, d1, d2, d3);
    idx += 1;
    if (idx >= 255) {
        idx = 0;
        cycle = cycle ^ u32(1);
        *cyclep = cycle;
    }
    *idxp = idx;
    ret;
}

fn xhci_xfer_enqueue(ptr<u8> ring, ptr<i64> idxp, ptr<u32> cyclep, u32 d0, u32 d1, u32 d2, u32 d3) {
    ptr<u32> ring32 = ptr<u32>(u64(ring));
    i64 idx = *idxp;
    u32 cycle = *cyclep;
    d3 = d3 | (cycle & u32(1));
    xhci_write_trb(ring32, idx, d0, d1, d2, d3);
    idx += 1;
    if (idx >= 255) {
        idx = 0;
        cycle = cycle ^ u32(1);
        *cyclep = cycle;
    }
    *idxp = idx;
    ret;
}

fn xhci_ring_init(ptr<u8> ring, u32 cycle) {
    ptr<u32> ring32 = ptr<u32>(u64(ring));
    i64 link_idx = 255;
    u64 ring_addr = u64(ring);
    u32 link_d0 = u32(ring_addr & u64(0xFFFFFFFF));
    u32 link_d1 = u32((ring_addr >> u64(32)) & u64(0xFFFFFFFF));
    u32 link_d2 = u32(0);
    u32 link_d3 = u32(0);
    link_d3 = link_d3 | (cycle & u32(1));
    link_d3 = link_d3 | u32(1 << 1);
    link_d3 = link_d3 | u32(6 << 10);
    xhci_write_trb(ring32, link_idx, link_d0, link_d1, link_d2, link_d3);
    ret;
}

fn xhci_ring_doorbell(ptr<u32> db_reg, u32 target) {
    rt_wbinvd();
    volatile_store(db_reg, target);
}

fn ptr<u64> usb_kbd_meta_addr(ptr<u8> meta_pool, i64 idx, i64 offset) {
    ret ptr<u64>(u64(meta_pool) + u64(idx) * u64(usb_kbd_meta_stride()) + u64(offset));
}

fn usb_kbd_meta_store_u64(ptr<u8> meta_pool, i64 idx, i64 offset, u64 value) {
    ptr<u64> dest = usb_kbd_meta_addr(meta_pool, idx, offset);
    *dest = value;
}

fn u64 usb_kbd_meta_load_u64(ptr<u8> meta_pool, i64 idx, i64 offset) {
    ptr<u64> src = usb_kbd_meta_addr(meta_pool, idx, offset);
    ret *src;
}

fn usb_kbd_meta_store_i64(ptr<u8> meta_pool, i64 idx, i64 offset, i64 value) {
    usb_kbd_meta_store_u64(meta_pool, idx, offset, u64(value));
}

fn i64 usb_kbd_meta_load_i64(ptr<u8> meta_pool, i64 idx, i64 offset) {
    ret i64(usb_kbd_meta_load_u64(meta_pool, idx, offset));
}

fn ptr<u8> usb_kbd_ring_ptr(ptr<u8> ring_pool, i64 idx) {
    ret ring_pool + idx * usb_kbd_ring_size();
}

fn ptr<u8> usb_kbd_buf_ptr(ptr<u8> buf_pool, i64 idx) {
    ret buf_pool + idx * usb_kbd_buf_size();
}

fn ptr<u8> usb_kbd_prev_ptr(ptr<u8> buf_pool, i64 idx) {
    ret usb_kbd_buf_ptr(buf_pool, idx) + u64(8);
}

fn i64 usb_kbd_find_by_ep(ptr<u8> meta_pool, i64 dev_cnt, u64 ep_id) {
    i64 i = 0;
    while (i < dev_cnt) {
        if (usb_kbd_meta_load_u64(meta_pool, i, usb_kbd_meta_used_off()) != u64(0) &&
            usb_kbd_meta_load_u64(meta_pool, i, usb_kbd_meta_ep_id_off()) == ep_id) {
            ret i;
        }
        i += 1;
    }
    ret i64(-1);
}

fn i64 usb_kbd_alloc_handle(ptr<u8> meta_pool, ptr<i64> dev_cnt) {
    i64 i = 0;
    while (i < *dev_cnt) {
        if (usb_kbd_meta_load_u64(meta_pool, i, usb_kbd_meta_used_off()) == u64(0)) {
            usb_kbd_meta_store_u64(meta_pool, i, usb_kbd_meta_used_off(), u64(1));
            ret i;
        }
        i += 1;
    }
    if (*dev_cnt >= usb_kbd_max_devs()) {
        ret i64(-1);
    }
    i64 idx = *dev_cnt;
    *dev_cnt += 1;
    usb_kbd_meta_store_u64(meta_pool, idx, usb_kbd_meta_used_off(), u64(1));
    usb_kbd_meta_store_u64(meta_pool, idx, usb_kbd_meta_ring_idx_off(), u64(0));
    usb_kbd_meta_store_u64(meta_pool, idx, usb_kbd_meta_ring_cycle_off(), u64(1));
    usb_kbd_meta_store_u64(meta_pool, idx, usb_kbd_meta_pending_off(), u64(0));
    ret idx;
}

fn i64 usb_kbd_max_devs() { ret i64(4); }
fn i64 usb_kbd_ring_size() { ret i64(4096); }
fn i64 usb_kbd_buf_size() { ret i64(16); }
fn i64 usb_kbd_meta_stride() { ret i64(88); }
fn i64 usb_kbd_meta_used_off() { ret i64(0); }
fn i64 usb_kbd_meta_ep_id_off() { ret i64(8); }
fn i64 usb_kbd_meta_ep_addr_off() { ret i64(16); }
fn i64 usb_kbd_meta_slot_id_off() { ret i64(24); }
fn i64 usb_kbd_meta_port_id_off() { ret i64(32); }
fn i64 usb_kbd_meta_db_off() { ret i64(40); }
fn i64 usb_kbd_meta_ring_ptr_off() { ret i64(48); }
fn i64 usb_kbd_meta_buf_ptr_off() { ret i64(56); }
fn i64 usb_kbd_meta_ring_idx_off() { ret i64(64); }
fn i64 usb_kbd_meta_ring_cycle_off() { ret i64(72); }
fn i64 usb_kbd_meta_pending_off() { ret i64(80); }

fn ptr<u8> usb_kbd_ring_pool(ptr<u8> scratch) {
    ret scratch;
}

fn ptr<u8> usb_kbd_buf_pool(ptr<u8> scratch) {
    ret usb_kbd_ring_pool(scratch) + usb_kbd_ring_size() * usb_kbd_max_devs();
}

fn ptr<u8> usb_kbd_meta_pool(ptr<u8> scratch) {
    ret usb_kbd_buf_pool(scratch) + usb_kbd_buf_size() * usb_kbd_max_devs();
}

fn xhci_queue_noop(ptr<u8> ring, ptr<i64> idxp, ptr<u32> cyclep, ptr<u32> db_reg, u32 ep_id) {
    u32 d0 = u32(0);
    u32 d1 = u32(0);
    u32 d2 = u32(0);
    u32 d3 = u32(0);
    d3 = d3 | u32(1 << 5);     // IOC
    d3 = d3 | u32(23 << 10);   // No-Op TRB
    xhci_xfer_enqueue(ring, idxp, cyclep, d0, d1, d2, d3);
    xhci_ring_doorbell(db_reg, ep_id);
}

fn i64 xhci_ctx_size(u32 hcc1) {
    if (((hcc1 >> u32(2)) & u32(1)) != u32(0)) {
        ret 64;
    }
    ret 32;
}



fn pci_write32(u8 bus, u8 dev, u8 func, u8 off, u32 val) {
    u32 addr = pci_cfg_addr(bus, dev, func, off);
    out32(u16(0xCF8), addr);
    out32(u16(0xCFC), val);
}

fn u8 pci_find_cap(u8 bus, u8 dev, u8 func, u8 cap_id) {
    u32 st = pci_read32(bus, dev, func, u8(0x04));
    if ((st & u32(0x00100000)) == u32(0)) {
        ret u8(0);
    }
    u32 cap_ptr32 = pci_read32(bus, dev, func, u8(0x34));
    u8 cap_ptr = u8(cap_ptr32 & u32(0xFF));
    i64 guard = 48;
    while (cap_ptr != u8(0) && guard > 0) {
        u32 hdr = pci_read32(bus, dev, func, cap_ptr);
        u8 id = u8(hdr & u32(0xFF));
        u8 next = u8((hdr >> u32(8)) & u32(0xFF));
        if (id == cap_id) {
            ret cap_ptr;
        }
        cap_ptr = next;
        guard -= 1;
    }
    ret u8(0);
}

fn pci_pm_set_d0(u8 bus, u8 dev, u8 func) {
    u8 cap = pci_find_cap(bus, dev, func, u8(0x01));
    if (cap == u8(0)) { ret; }
    u32 pmcsr = pci_read32(bus, dev, func, cap + u8(0x04));
    pmcsr = pmcsr & ~u32(0x3);
    pci_write32(bus, dev, func, cap + u8(0x04), pmcsr);
}

fn pci_flr(u8 bus, u8 dev, u8 func) {
    u8 cap = pci_find_cap(bus, dev, func, u8(0x10));
    if (cap == u8(0)) { ret; }
    u32 devctl2 = pci_read32(bus, dev, func, cap + u8(0x28));
    devctl2 = devctl2 | u32(1 << 15);
    pci_write32(bus, dev, func, cap + u8(0x28), devctl2);
    i64 wait = 2000000;
    while (wait > 0) {
        u32 v = pci_read32(bus, dev, func, cap + u8(0x28));
        if ((v & u32(1 << 15)) == u32(0)) { break; }
        wait -= 1;
    }
}
fn i64 pci_enable_msi(u8 bus, u8 dev, u8 func, u8 vector) {
    u8 cap = pci_find_cap(bus, dev, func, u8(0x05));
    if (cap == u8(0)) { ret 0; }
    u32 hdr = pci_read32(bus, dev, func, cap);
    u32 msg_ctl = (hdr >> u32(16)) & u32(0xFFFF);
    u32 is64 = (msg_ctl >> u32(7)) & u32(1);
    u32 addr_lo = u32(0xFEE00000);
    u32 addr_hi = u32(0);
    pci_write32(bus, dev, func, cap + u8(0x04), addr_lo);
    if (is64 != u32(0)) {
        pci_write32(bus, dev, func, cap + u8(0x08), addr_hi);
        pci_write32(bus, dev, func, cap + u8(0x0C), u32(vector));
    } else {
        pci_write32(bus, dev, func, cap + u8(0x08), u32(vector));
    }
    msg_ctl = msg_ctl | u32(1);
    u32 hdr2 = (hdr & u32(0x0000FFFF)) | (msg_ctl << u32(16));
    pci_write32(bus, dev, func, cap, hdr2);

    u32 cmd = pci_read32(bus, dev, func, u8(0x04));
    cmd = cmd | u32(1 << 2);
    cmd = cmd | u32(1 << 10);
    pci_write32(bus, dev, func, u8(0x04), cmd);
    ret 1;
}

fn u64 pci_find_xhci_base(ptr<u8> bus_out, ptr<u8> dev_out, ptr<u8> fn_out) {
    i64 bus = 0;
    while (bus < 256) {
        i64 dev = 0;
        while (dev < 32) {
            i64 func = 0;
            while (func < 8) {
                u32 id = pci_read32(u8(bus), u8(dev), u8(func), u8(0x00));
                if ((id & u32(0xFFFF)) != u32(0xFFFF)) {
                    u32 classc = pci_read32(u8(bus), u8(dev), u8(func), u8(0x08));
                    u8 prog = u8((classc >> u32(8)) & u32(0xFF));
                    u8 sub = u8((classc >> u32(16)) & u32(0xFF));
                    u8 cls = u8((classc >> u32(24)) & u32(0xFF));
                    if (cls == u8(0x0C) && sub == u8(0x03) && prog == u8(0x30)) {
                        u32 bar0 = pci_read32(u8(bus), u8(dev), u8(func), u8(0x10));
                        u32 bar1 = pci_read32(u8(bus), u8(dev), u8(func), u8(0x14));
                        u64 base = (u64(bar1) << u64(32)) | u64(bar0);
                        base = base & ~u64(0xF);
                        *bus_out = u8(bus);
                        *dev_out = u8(dev);
                        *fn_out = u8(func);
                        ret base;
                    }
                }
                func += 1;
            }
            dev += 1;
        }
        bus += 1;
    }
    ret u64(0);
}

fn u64 pci_find_xhci_active_base(ptr<u8> bus_out, ptr<u8> dev_out, ptr<u8> fn_out) {
    i64 bus = 0;
    while (bus < 256) {
        i64 dev = 0;
        while (dev < 32) {
            i64 func = 0;
            while (func < 8) {
                u32 id = pci_read32(u8(bus), u8(dev), u8(func), u8(0x00));
                if ((id & u32(0xFFFF)) != u32(0xFFFF)) {
                    u32 classc = pci_read32(u8(bus), u8(dev), u8(func), u8(0x08));
                    u8 prog = u8((classc >> u32(8)) & u32(0xFF));
                    u8 sub = u8((classc >> u32(16)) & u32(0xFF));
                    u8 cls = u8((classc >> u32(24)) & u32(0xFF));
                    if (cls == u8(0x0C) && sub == u8(0x03) && prog == u8(0x30)) {
                        u32 bar0 = pci_read32(u8(bus), u8(dev), u8(func), u8(0x10));
                        u32 bar1 = pci_read32(u8(bus), u8(dev), u8(func), u8(0x14));
                        u64 base = (u64(bar1) << u64(32)) | u64(bar0);
                        base = base & ~u64(0xF);
                        if (base != u64(0)) {
                            ptr<u32> cap_reg = ptr<u32>(base);
                            u32 cap0 = volatile_load(cap_reg);
                            u8 caplen = u8(cap0 & u32(0xFF));
                            ptr<u32> hcs1_reg = ptr<u32>(base + u64(0x04));
                            u32 hcs1 = volatile_load(hcs1_reg);
                            u8 max_ports = u8((hcs1 >> u32(24)) & u32(0xFF));
                            u64 op_base = base + u64(caplen);
                            i64 pr = 1;
                            while (pr <= i64(max_ports)) {
                                u64 portsc_addr = op_base + u64(0x400) + u64(pr - 1) * u64(0x10);
                                ptr<u32> portsc_reg = ptr<u32>(portsc_addr);
                                u32 ps = volatile_load(portsc_reg);
                                u32 ccs = ps & u32(1);
                                u32 ped = (ps >> u32(1)) & u32(1);
                                if (ccs != u32(0) && ped != u32(0)) {
                                    *bus_out = u8(bus);
                                    *dev_out = u8(dev);
                                    *fn_out = u8(func);
                                    ret base;
                                }
                                pr += 1;
                            }
                        }
                    }
                }
                func += 1;
            }
            dev += 1;
        }
        bus += 1;
    }
    ret u64(0);
}


fn i64 xhci_evt_poll(ptr<u8> evt_ring, ptr<i64> idxp, ptr<u32> cyclep, ptr<u32> d0p, ptr<u32> d1p, ptr<u32> d2p, ptr<u32> d3p) {
    ptr<u32> ring32 = ptr<u32>(u64(evt_ring));
    i64 idx = *idxp;
    u32 d3 = *(ring32 + idx * 4 + 3);
    u32 cycle = *cyclep;
    if ((d3 & u32(1)) != (cycle & u32(1))) {
        ret 0;
    }
    *d0p = *(ring32 + idx * 4 + 0);
    *d1p = *(ring32 + idx * 4 + 1);
    *d2p = *(ring32 + idx * 4 + 2);
    *d3p = d3;
    idx += 1;
    if (idx >= 256) {
        idx = 0;
        cycle = cycle ^ u32(1);
        *cyclep = cycle;
    }
    *idxp = idx;
    ret 1;
}

fn i64 xhci_ctrl_xfer(ptr<u8> ring, ptr<i64> idxp, ptr<u32> cyclep,
                      ptr<u8> evt_ring, ptr<i64> evt_idxp, ptr<u32> evt_cyclep,
                      ptr<u64> erdp_reg, ptr<u32> doorbell,
                      u64 setup, ptr<u8> data, u32 data_len, i64 data_in,
                      ptr<u32> fb_out, i64 fb_stride, i64 fb_width, i64 fb_height,
                      ptr<i64> fb_xp, ptr<i64> fb_yp) {
    u32 d0 = u32(setup & u64(0xFFFFFFFF));
    u32 d1 = u32((setup >> u64(32)) & u64(0xFFFFFFFF));
    u32 d2 = u32(8);
    u32 d3 = u32(0);
    u32 trt = u32(0);
    if (data_len != u32(0)) {
        if (data_in) { trt = u32(2); } else { trt = u32(3); }
    }
    d3 = d3 | (trt << u32(16));
    d3 = d3 | u32(1 << 6);
    d3 = d3 | u32(2 << 10);
    xhci_xfer_enqueue(ring, idxp, cyclep, d0, d1, d2, d3);
    if (data_len != u32(0)) {
        u64 data_addr = u64(data);
        u32 dd0 = u32(data_addr & u64(0xFFFFFFFF));
        u32 dd1 = u32((data_addr >> u64(32)) & u64(0xFFFFFFFF));
        u32 dd2 = data_len;
        u32 dd3 = u32(0);
        if (data_in) {
            dd3 = dd3 | u32(1 << 16);
        }
        dd3 = dd3 | u32(3 << 10);
        xhci_xfer_enqueue(ring, idxp, cyclep, dd0, dd1, dd2, dd3);
    }
    u32 sd3 = u32(0);
    if (data_len == u32(0)) {
        sd3 = sd3 | u32(1 << 16);
    } else {
        if (!data_in) {
            sd3 = sd3 | u32(1 << 16);
        }
    }
    sd3 = sd3 | u32(1 << 5);
    sd3 = sd3 | u32(4 << 10);
    xhci_xfer_enqueue(ring, idxp, cyclep, u32(0), u32(0), u32(0), sd3);

    xhci_ring_doorbell(doorbell, u32(1));
    i64 wait = 2000000;
    while (wait > 0) {
        u32 ev_d0 = u32(0);
        u32 ev_d1 = u32(0);
        u32 ev_d2 = u32(0);
        u32 ev_d3 = u32(0);
        if (xhci_evt_poll(evt_ring, evt_idxp, evt_cyclep, &ev_d0, &ev_d1, &ev_d2, &ev_d3)) {
            u32 ev_type = (ev_d3 >> u32(10)) & u32(0x3F);
            u32 ccode = (ev_d2 >> u32(24)) & u32(0xFF);
            u64 erdp_val = u64(evt_ring) + u64(*evt_idxp) * u64(16);
            volatile_store(erdp_reg, erdp_val | u64(0x8));
            if (ev_type == u32(32)) {
                if (0 && fb_out != ptr<u32>(0)) {
                    X();
                    C();
                    eq();
                    khex(u64(ccode));
                    spc();
                    D();
                    d2();
                    eq();
                    khex(u64(ev_d2));
                    spc();
                    D();
                    d3();
                    eq();
                    khex(u64(ev_d3));
                    nl();
                }
                if (ccode == u32(1)) {
                    ret 1;
                }
                ret 0;
            }
        }
        wait -= 1;
    }
    if (0 && fb_out != ptr<u32>(0)) {
        E();
        T();
        nl();
    }
    ret 0;
}



fn i64 hid_key_in_prev(u8 key, ptr<u8> prev) {
    i64 i = 2;
    while (i < 8) {
        if (*(prev + i) == key) { ret 1; }
        i += 1;
    }
    ret 0;
}

fn u8 hid_first_key(ptr<u8> rep) {
    i64 i = 2;
    while (i < 8) {
        u8 key = *(rep + i);
        if (key != u8(0)) { ret key; }
        i += 1;
    }
    ret u8(0);
}


fn fb_mark_line(ptr<u32> fb, i64 stride, i64 width, i64 height, i64 line, u32 color) {
    i64 scale = 1;
    i64 line_step = 10;
    i64 cols = width / (8 * scale);
    if (cols <= 4) { ret; }
    i64 x = (cols - 4) * 8 * scale;
    i64 y = line * line_step * scale;
    fb_fill_rect(fb, stride, width, height, x, y, 24 * scale, 8 * scale, color);
    ret;
}


fn irq_timer_tick() {
    ptr<u64> ticks = rt_ticks_ptr();
    u64 t = volatile_load(ticks);
    t += u64(1);
    volatile_store(ticks, t);
}

fn irq_kbd_push(u64 sc) {
    ptr<u8> buf = rt_kbd_buf_ptr();
    ptr<u8> headp = rt_kbd_head_ptr();
    ptr<u8> tailp = rt_kbd_tail_ptr();
    u8 head = volatile_load(headp);
    u8 tail = volatile_load(tailp);
    u8 next = u8((u64(head) + u64(1)) & u64(63));
    if (next == tail) {
        ret;
    }
    *(buf + u64(head)) = u8(sc);
    volatile_store(headp, next);
    ret;
}

fn irq_xhci_evt() {
    ptr<u64> flagp = rt_usb_irq_ptr();
    u64 v = volatile_load(flagp);
    volatile_store(flagp, v + u64(1));
}


fn panic(str msg) {
    print("PANIC: ", msg, "\n");
    asm0("cli");
    i64 one = 1;
    while (one) {
        asm0("hlt");
    }
}



fn u8 kbd_read_scancode() {
    u8 st = in8(u16(0x64));
    if ((st & u8(0x01)) == u8(0)) {
        ret u8(0);
    }
    ret in8(u16(0x60));
}

fn kbd_flush() {
    u8 st = in8(u16(0x64));
    while ((st & u8(0x01)) != u8(0)) {
        u8 drop = in8(u16(0x60));
        drop = drop;
        st = in8(u16(0x64));
    }
}

fn u8 kbd_read_scancode_irq() {
    ptr<u8> buf = rt_kbd_buf_ptr();
    ptr<u8> headp = rt_kbd_head_ptr();
    ptr<u8> tailp = rt_kbd_tail_ptr();
    u8 head = volatile_load(headp);
    u8 tail = volatile_load(tailp);
    if (head == tail) {
        ret u8(0);
    }
    u8 sc = *(buf + u64(tail));
    tail = u8((u64(tail) + u64(1)) & u64(63));
    volatile_store(tailp, tail);
    ret sc;
}

fn tty_clear(ptr<u16> vga, ptr<i64> rowp, ptr<i64> colp, u16 attr) {
    if (uefi_present()) {
        i64 st = uefi_clear();
        st = st;
        *rowp = 0;
        *colp = 0;
        ret;
    }
    i64 i = 0;
    while (i < 2000) {
        volatile_store(vga + i, u16(0x20) | attr);
        i += 1;
    }
    *rowp = 0;
    *colp = 0;
}


fn tty_write_buf(ptr<u16> vga, ptr<i64> rowp, ptr<i64> colp, u16 attr, ptr<u8> buf, i64 len) {
    i64 i = 0;
    while (i < len) {
        u8 ch = *(buf + i);
        tty_putc(vga, rowp, colp, attr, ch);
        i += 1;
    }
}




fn line_clear_display(ptr<u16> vga, ptr<i64> rowp, ptr<i64> colp, u16 attr, u16 com1, i64 len) {
    i64 i = 0;
    while (i < len) {
        serial_write_backspace(com1);
        tty_putc(vga, rowp, colp, attr, u8(0x08));
        i += 1;
    }
}

fn line_echo_buf(ptr<u16> vga, ptr<i64> rowp, ptr<i64> colp, u16 attr, u16 com1, ptr<u8> buf, i64 len) {
    i64 i = 0;
    while (i < len) {
        u8 ch = *(buf + i);
        serial_write_byte(com1, ch);
        tty_putc(vga, rowp, colp, attr, ch);
        i += 1;
    }
}


fn i64 hist_get_len(ptr<u8> base, i64 idx) {
    u8 v = *(base + idx);
    ret i64(v);
}


fn run_command(ptr<u16> vga, ptr<i64> rowp, ptr<i64> colp, u16 attr, u16 com1, ptr<u8> buf, i64 len) {
    if (len == 0) {
        ret;
    }
    if (cmd_is_help(buf, len)) {
        serial_log_cmd_help(com1);
        tty_write_help(vga, rowp, colp, attr);
        ret;
    }
    if (cmd_is_cls(buf, len)) {
        serial_log_cmd_cls(com1);
        tty_clear(vga, rowp, colp, attr);
        ret;
    }
    if (cmd_is_halt(buf, len)) {
        serial_log_cmd_halt(com1);
        asm0("cli");
        i64 one = 1;
        while (one) {
            asm0("hlt");
        }
    }
    if (cmd_is_panic(buf, len)) {
        serial_log_cmd_panic(com1);
        panic("manual panic");
    }
    if (cmd_is_echo(buf, len)) {
        serial_log_cmd_echo(com1);
        i64 start = 4;
        if (len > 4) {
            if (*(buf + 4) == u8(0x20)) {
                start = 5;
            }
        }
        if (len > start) {
            tty_write_buf(vga, rowp, colp, attr, buf + start, len - start);
        }
        tty_putc(vga, rowp, colp, attr, u8(0x0A));
        ret;
    }
    serial_log_cmd_unknown(com1);
    tty_putc(vga, rowp, colp, attr, u8(0x3F));
    tty_putc(vga, rowp, colp, attr, u8(0x0A));
    ret;
}

fn _start() {
   // i64 x=1;
  //  x/=0;
    u64 fb_base = uefi_get_fb_base();
    u64 fb_stride_u = uefi_get_fb_stride();
    u64 fb_width_u = uefi_get_fb_width();
    u64 fb_height_u = uefi_get_fb_height();
    if (fb_base != u64(0)) {
        fb_out = ptr<u32>(fb_base);
        fb_stride = i64(fb_stride_u);
        fb_width = i64(fb_width_u);
        fb_height = i64(fb_height_u);
        fb_x = 0;
        fb_y = 0;
        fb_xp = &fb_x;
        fb_yp = &fb_y;
        kputc(u8(0x42)); // B
        kputc(u8(0x4F)); // O
        kputc(u8(0x4F)); // O
        kputc(u8(0x54)); // T
        kputc(u8(0x0A)); // \n
        // framebuffer echo for key input
        ptr<u32> fb_out_init = ptr<u32>(fb_base);
        fb_out_init = fb_out_init;
        ptr<u32> fbe = ptr<u32>(fb_base);
        fb_fill_rect(fbe, fb_stride, fb_width, fb_height, 400, 100, 48, 16, u32(0x00FF0000));
    }
    i64 uefi = uefi_present();
    i64 uefi_env = uefi_has_st();
    u16 com1 = u16(0x3F8);
    dbg_boot_mark(u8(1));
    if (!uefi_env) {
        serial_init(com1);
        serial_write_kernel_start(com1);
    }
    
    ptr<u16> vga = ptr<u16>(0xB8000);
    u16 attr = u16(0x0F00);
    if (!uefi_env) {
        i64 i = 0;
        while (i < 2000) {
            volatile_store(vga + i, u16(0x20) | attr);
            i += 1;
        }

        i64 base = 996;
        volatile_store(vga + base + 0, u16(0x45) | attr);
        volatile_store(vga + base + 1, u16(0x4C) | attr);
        volatile_store(vga + base + 2, u16(0x46) | attr);
        volatile_store(vga + base + 3, u16(0x49) | attr);
        volatile_store(vga + base + 4, u16(0x52) | attr);
        volatile_store(vga + base + 5, u16(0x20) | attr);
        volatile_store(vga + base + 6, u16(0x4F) | attr);
        volatile_store(vga + base + 7, u16(0x4B) | attr);
    }
    dbg_boot_mark(u8(2));
    if (!uefi_env) {
        serial_write_kernel_init_ok(com1);
    }

    volatile_store(rt_ticks_ptr(), u64(0));
    volatile_store(rt_kbd_head_ptr(), u8(0));
    volatile_store(rt_kbd_tail_ptr(), u8(0));
    kbd_flush();
    idt_init();
    dbg_boot_mark(u8(3));
    rt_i8042_init();
    dbg_boot_mark(u8(4));
    i64 enable_irq = 0;
   //i64 use_irq_kbd = enable_irq;
    i64 use_irq_kbd = 0;
    if (enable_irq) {
        use_irq_kbd = 1;
    }
    if (enable_irq) {
        pic_init();
    }
    if (enable_irq && !use_irq_kbd) {
        // Mask IRQ1 so we only poll i8042 and avoid IRQ handler faults.
        out8(u16(0x21), u8(0xFE));
    }
    if (enable_irq) {
        asm0("sti");
    }

    // Exception test scaffolding (enable one at a time)
    // #DE divide-by-zero (enabled)
    /*  
		i64 a = 1;
		i64 b = 0;
		i64 c = a / b;
		if (c == 0) { asm0("nop"); } 
	*/
    // #DB debug (needs hardware debug regs / single-step)
    // #NMI non-maskable interrupt (external)
    // #BP breakpoint (needs int3 / asm)
    // #OF overflow (needs INTO / asm, or crafted flags)
    // #BR bound range (needs BOUND / asm)
    // #UD invalid opcode (needs ud2 / asm)
    // #NM device-not-available (disable TS then use FPU)
    // #DF double fault (needs faulty handler / stack)
    // #CSO coprocessor segment overrun (reserved)
    // #TS invalid TSS (needs task switch / asm)
    // #NP segment not present (needs segment setup / asm)
    // #SS stack-segment fault (needs bad SS / asm)
    // #GP general protection (bad segment or privilege / asm)
    //
    // #PF page fault  
    /*	
           ptr<u64> p = ptr<u64>(0x40000000);
           u64 v = volatile_load(p);
           if (v == u64(0)) { asm0("nop"); }    
    */		   
    //
    // #RES reserved
    // #MF x87 FPU error (use FPU + unmasked exception)
    // #AC alignment check (needs CR0.AM + EFLAGS.AC)
    // #MC machine check (hardware)
    // #XM SIMD FP exception (use SSE + unmasked exception)
    // #VE virtualization exception (VMX)
    // #CP control protection (CET)
    // #RES reserved (22-31)

