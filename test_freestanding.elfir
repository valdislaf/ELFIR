    ptr<u8> usb_scratch_bufs = rt_xhci_scratch_bufs();
    ptr<u8> usb_kbd_buf = usb_scratch_bufs + i64(4096 * 31);
    ptr<u64> usb_irq_flag = rt_usb_irq_ptr();
    i64 usb_irq_mode = 0;
    u64 usb_irq_seen = u64(0);
    i64 usb_irq_printed = 0;
    i64 usb_dbg_stage = 1;
    i64 usb_dbg_evt = 2;
    i64 usb_dbg_enq = 1;
    i64 usb_dbg_tevt = 1;
    i64 usb_dbg_epctx = 1;
    i64 usb_dbg_epstate = 1;
    i64 usb_noevt = 0;
    i64 usb_evt_dumped = 0;
    i64 usb_evt_log = 0;
    i64 usb_mark_enq = 0;
    i64 usb_mark_evt = 0;
    i64 usb_mark_tevt = 0;
    i64 usb_mark_ctx = 0;
    i64 usb_mark_d3 = 0;

    if (fb_base != u64(0)) {
