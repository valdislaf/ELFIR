                                khex(u64(volatile_load(usb_erstba_reg)));
                                nl();
                            }
                            if (usb_erdp_reg != ptr<u64>(0)) {
                                fb_label_erdp(fb_out, fb_out_xp, fb_out_yp);
                                khex(u64(volatile_load(usb_erdp_reg)));
                                nl();
                            }
                        }
                    }
                }
            }
            }
            if (kbd_registered == 0) {
                if (kbd_handle >= 0) {
                    usb_kbd_meta_store_u64(usb_kbd_meta_base, kbd_handle, usb_kbd_meta_used_off(), u64(0));
                    usb_kbd_meta_store_u64(usb_kbd_meta_base, kbd_handle, usb_kbd_meta_ep_id_off(), u64(0));
                    usb_kbd_meta_store_u64(usb_kbd_meta_base, kbd_handle, usb_kbd_meta_pending_off(), u64(0));
                    if (kbd_handle == usb_kbd_dev_cnt - 1 && usb_kbd_dev_cnt > 0) {
                        usb_kbd_dev_cnt -= 1;
                    }
                }
                u32 dis_d3 = (slot_id << u32(24)) | u32(10 << 10);
                xhci_cmd_enqueue(cmd_ring, &cmd_idx, &cmd_cycle, u32(0), u32(0), u32(0), dis_d3);
                volatile_store(db0, u32(0));
                i64 wait_dis = 1000000;
                u32 ev_dd0 = u32(0);
                u32 ev_dd1 = u32(0);
                u32 ev_dd2 = u32(0);
                u32 ev_dd3 = u32(0);
                while (wait_dis > 0) {
                    if (xhci_evt_poll(evt_ring, &evt_idx, &evt_cycle, &ev_dd0, &ev_dd1, &ev_dd2, &ev_dd3)) {
                        u32 ev_type_d = (ev_dd3 >> u32(10)) & u32(0x3F);
                        u32 ev_slot_d = (ev_dd3 >> u32(24)) & u32(0xFF);
                        u64 erdp_val_d = u64(evt_ring) + u64(evt_idx) * u64(16);
                        volatile_store(erdp_reg, erdp_val_d | u64(0x8));
                        if (ev_type_d == u32(33) && ev_slot_d == slot_id) {
                            break;
                        }
                    }
                    wait_dis -= 1;
                }
            }
            if (usb_ready && usb_kbd_dev_cnt > 0) {
                usb_ep_id = u32(usb_kbd_meta_load_u64(usb_kbd_meta_base, 0, usb_kbd_meta_ep_id_off()));
            }
            port_try += 1;
        }

        if (0) {
            i64 pu = 1;
            while (pu <= i64(max_ports)) {
                u64 portsc_addr3 = op_base2 + u64(0x400) + u64(pu - 1) * u64(0x10);
                ptr<u32> portsc_reg3 = ptr<u32>(portsc_addr3);
                u32 psu = volatile_load(portsc_reg3);
                u32 psu2 = psu & u32(0xFFFFFE1F);
                psu2 = psu2 | u32(0x00010000) | u32(0x00000200) | rw1c_mask;
                volatile_store(portsc_reg3, psu2);
                i64 wu = 200000;
                while (wu > 0) {
                    wu -= 1;
                }
                u32 psu_done = volatile_load(portsc_reg3);
                fb_label_portu(fb, fxp, fyp, pu);
                fb_hex(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u64(psu_done));
                fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), fxp, fyp, u8(0x0A));
                pu += 1;
            }
        }

        i64 cx = *fxp;
        i64 cy = *fyp;
        ptr<i64> cxp = &cx;
        ptr<i64> cyp = &cy;
        i64 xhci_watch = 0;
        if (xhci_watch) {
            u32 last_ccs_mask = u32(0);
            while (1) {
                u32 ccs_mask = u32(0);
                i64 pscan = 1;
                while (pscan <= i64(max_ports)) {
                    u64 portsc_addr4 = op_base2 + u64(0x400) + u64(pscan - 1) * u64(0x10);
                    ptr<u32> portsc_reg4 = ptr<u32>(portsc_addr4);
                    u32 ps4 = volatile_load(portsc_reg4);
                    u32 ccs4 = ps4 & u32(1);
                    if (ccs4 != u32(0)) {
                        ccs_mask = ccs_mask | (u32(1) << u32(pscan - 1));
                    }
                    pscan += 1;
                }
                if (ccs_mask != last_ccs_mask && ccs_mask != u32(0)) {
                    last_ccs_mask = ccs_mask;
                    i64 pshow = 1;
                    while (pshow <= i64(max_ports)) {
                        if ((ccs_mask & (u32(1) << u32(pshow - 1))) != u32(0)) {
                            u64 portsc_addr5 = op_base2 + u64(0x400) + u64(pshow - 1) * u64(0x10);
                            ptr<u32> portsc_reg5 = ptr<u32>(portsc_addr5);
                            u32 ps5 = volatile_load(portsc_reg5);
                            u32 ccs5 = ps5 & u32(1);
                            u32 ped5 = (ps5 >> u32(1)) & u32(1);
                            u32 pls5 = (ps5 >> u32(5)) & u32(0xF);
                            u32 spd5 = (ps5 >> u32(10)) & u32(0xF);
                            fb_label_portsc(fb, cxp, cyp, pshow);
                            fb_hex(fb, i64(fb_stride), i64(fb_width), i64(fb_height), cxp, cyp, u64(ps5));
                            fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), cxp, cyp, u8(0x0A));
                            fb_label_ccs(fb, cxp, cyp);
                            fb_hex(fb, i64(fb_stride), i64(fb_width), i64(fb_height), cxp, cyp, u64(ccs5));
                            fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), cxp, cyp, u8(0x20));
                            fb_label_ped(fb, cxp, cyp);
                            fb_hex(fb, i64(fb_stride), i64(fb_width), i64(fb_height), cxp, cyp, u64(ped5));
                            fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), cxp, cyp, u8(0x20));
                            fb_label_pls(fb, cxp, cyp);
                            fb_hex(fb, i64(fb_stride), i64(fb_width), i64(fb_height), cxp, cyp, u64(pls5));
                            fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), cxp, cyp, u8(0x20));
                            fb_label_spd(fb, cxp, cyp);
                            fb_hex(fb, i64(fb_stride), i64(fb_width), i64(fb_height), cxp, cyp, u64(spd5));
                            fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), cxp, cyp, u8(0x0A));
                        }
                        pshow += 1;
                    }
                }
                i64 idle = 200000;
                while (idle > 0) {
                    idle -= 1;
                }
            }
        }
        }
    }


    ptr<u8> line = rt_uefi_line();
    ptr<u8> last_line = rt_uefi_last_line();
    ptr<u8> hist_base = rt_uefi_hist_base();
    ptr<u8> hist_len_base = rt_uefi_hist_len_base();
    ptr<u8> edit_buf = rt_uefi_edit_buf();
    i64 len = 0;
    i64 last_len = 0;
    i64 prev_len = 0;
    i64 cur = 0;
    i64 cap = 256;
    i64 hist_head = 0;
    i64 hist_count = 0;
    i64 hist_nav = -1;
    i64 edit_len = 0;
    i64 e0 = 0;
    i64 line_row = 0;
    i64 line_col = 0;
    i64 fb_line_row = 0;
    i64 fb_line_col = 0;
    i64 fb_line_set = 0;
    i64 fb_cursor_on = 0;
    i64 fb_cursor_x = 0;
    i64 fb_cursor_y = 0;

    tty_clear(vga, rowp, colp, attr);
    tty_write_prompt(vga, rowp, colp, attr);
    line_row = *rowp;
    line_col = *colp;
    serial_write_byte(com1, u8(0x3E));
    serial_write_byte(com1, u8(0x20));
    if (fb_out != ptr<u32>(0)) {
        fb_line_row = *fb_out_yp;
        fb_line_col = *fb_out_xp;
        fb_line_set = 0;
    }
    if (0 && fb_out != ptr<u32>(0)) {
        R();
        E();
        A();
        D();
        Y();
        nl();
    }
    if (fb_base != u64(0)) {
        if (0) {
            dbg_boot_mark(u8(5));
        }
    }

    i64 one = 1;
    while (one) {
        if (fb_out != ptr<u32>(0)) {
            if (fb_cursor_x != *fb_out_xp || fb_cursor_y != *fb_out_yp) {
                if (fb_cursor_on != 0) {
                    fb_cursor_xor(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_cursor_x, fb_cursor_y);
                }
                fb_cursor_x = *fb_out_xp;
                fb_cursor_y = *fb_out_yp;
                fb_cursor_xor(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_cursor_x, fb_cursor_y);
                fb_cursor_on = 1;
            } elseif (fb_cursor_on == 0) {
                fb_cursor_x = *fb_out_xp;
                fb_cursor_y = *fb_out_yp;
                fb_cursor_xor(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_cursor_x, fb_cursor_y);
                fb_cursor_on = 1;
            }
        }
        u64 key = u64(0);
        u16 uefi_uc = u16(0);
        u16 uefi_sc = u16(0);
        if (uefi) {
            key = uefi_read_key();
            if (key != u64(0)) {
                uefi_uc = u16(key & u64(0xFFFF));
                uefi_sc = u16((key >> u64(16)) & u64(0xFFFF));
            }
        }
        if (uefi && ((uefi_uc != u16(0)) || (uefi_sc != u16(0)))) {
            if (uefi_sc != u16(0)) {
                if (uefi_sc == u16(1)) {
                    if (hist_count > 0) {
                        serial_log_key_up(com1);
                        if (hist_nav < 0) {
                            line_copy(edit_buf, line, len);
                            edit_len = len;
                            hist_nav = hist_head - 1;
                            if (hist_nav < 0) { hist_nav += 8; }
                        } else {
                            i64 uefi_oldest = hist_head - hist_count;
                            while (uefi_oldest < 0) { uefi_oldest += 8; }
                            if (hist_nav != uefi_oldest) {
                                hist_nav = hist_nav - 1;
                                if (hist_nav < 0) { hist_nav += 8; }
                            }
                        }
                        ptr<u8> uefi_src = hist_entry_ptr(hist_base, hist_nav);
                        len = hist_get_len(hist_len_base, hist_nav);
                        line_copy(line, uefi_src, len);
                        cur = len;
                        line_redraw(vga, rowp, colp, attr, line_row, line_col, line, len, prev_len, cur);
                        fb_cursor_set_line(fb_out, fb_out_width, fb_out_xp, fb_out_yp, fb_line_row, fb_line_col, cur);
                        prev_len = len;
                    }
                } else {
                    if (uefi_sc == u16(2)) {
                        if (hist_nav >= 0) {
                            serial_log_key_down(com1);
                            i64 newest = hist_head - 1;
                            if (newest < 0) { newest += 8; }
                            if (hist_nav == newest) {
                                hist_nav = -1;
                                line_copy(line, edit_buf, edit_len);
                                len = edit_len;
                            } else {
                                hist_nav = hist_nav + 1;
                                if (hist_nav >= 8) { hist_nav -= 8; }
                                ptr<u8> src2 = hist_entry_ptr(hist_base, hist_nav);
                                len = hist_get_len(hist_len_base, hist_nav);
                                line_copy(line, src2, len);
                            }
                            cur = len;
                            line_redraw(vga, rowp, colp, attr, line_row, line_col, line, len, prev_len, cur);
                            prev_len = len;
                        }
                    } else {
                        if (uefi_sc == u16(4)) {
                            if (cur > 0) {
                                serial_log_key_left(com1);
                                cur -= 1;
                                line_redraw(vga, rowp, colp, attr, line_row, line_col, line, len, prev_len, cur);
                            }
                        } else {
                            if (uefi_sc == u16(3)) {
                                if (cur < len) {
                                    serial_log_key_right(com1);
                                    cur += 1;
                                    line_redraw(vga, rowp, colp, attr, line_row, line_col, line, len, prev_len, cur);
                                }
                            }
                        }
                    }
                }
                continue;
            }
            if (uefi_uc != u16(0)) {
                u8 uefi_ch = u8(uefi_uc);
                if (uefi_ch == u8(0x0D)) { uefi_ch = u8(0x0A); }
                if (uefi_ch == u8(0x08)) {
                    if (cur > 0) {
                        i64 uefi_k = cur - 1;
                        while (uefi_k < len - 1) {
                            *(line + uefi_k) = *(line + uefi_k + 1);
                            uefi_k += 1;
                        }
                        len -= 1;
                        cur -= 1;
                        line_redraw(vga, rowp, colp, attr, line_row, line_col, line, len, prev_len, cur);
                        fb_cursor_set_line(fb_out, fb_out_width, fb_out_xp, fb_out_yp, fb_line_row, fb_line_col, cur);
                        prev_len = len;
                    }
                    continue;
                }
                if (uefi_ch == u8(0x0A)) {
                serial_write_newline(com1);
                tty_putc(vga, rowp, colp, attr, uefi_ch);
                if (fb_out != ptr<u32>(0)) {
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, uefi_ch);
                }
                if (len > 0) {
                    line_copy(last_line, line, len);
                    last_len = len;
                        ptr<u8> uefi_dst = hist_entry_ptr(hist_base, hist_head);
                        line_copy(uefi_dst, line, len);
                        hist_set_len(hist_len_base, hist_head, len);
                        hist_head += 1;
                        if (hist_head >= 8) { hist_head = 0; }
                        if (hist_count < 8) { hist_count += 1; }
                    }
                    run_command(vga, rowp, colp, attr, com1, line, len);
                    len = 0;
                    cur = 0;
                    prev_len = 0;
                    hist_nav = -1;
                    tty_write_prompt(vga, rowp, colp, attr);
                    line_row = *rowp;
                    line_col = *colp;
                    serial_write_byte(com1, u8(0x3E));
                    serial_write_byte(com1, u8(0x20));
                    continue;
                }
                if (uefi_ch < u8(0x20)) {
                    continue;
                }
                if (len >= cap - 1) {
                    continue;
                }
                i = len;
                while (i > cur) {
                    *(line + i) = *(line + i - 1);
                    i -= 1;
                }
                *(line + cur) = uefi_ch;
                len += 1;
                cur += 1;
                serial_write_byte(com1, uefi_ch);
                if (fb_out != ptr<u32>(0)) {
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, uefi_ch);
                }
                line_redraw(vga, rowp, colp, attr, line_row, line_col, line, len, prev_len, cur);
                prev_len = len;
                continue;
            }
        }

        if (usb_ready && usb_kbd_dev_cnt > 0) {
            if (usb_noop_done == 0) {
                i64 hn = 0;
                while (hn < usb_kbd_dev_cnt) {
                if (usb_kbd_meta_load_u64(usb_kbd_meta_base, hn, usb_kbd_meta_used_off()) != u64(0)) {
                    ptr<u8> nring = usb_kbd_ring_ptr(usb_kbd_ring_base, hn);
                    ptr<u32> ndb = ptr<u32>(usb_kbd_meta_load_u64(usb_kbd_meta_base, hn, usb_kbd_meta_db_off()));
                    u32 nep = u32(usb_kbd_meta_load_u64(usb_kbd_meta_base, hn, usb_kbd_meta_ep_id_off()));
                    i64 nidx = usb_kbd_meta_load_i64(usb_kbd_meta_base, hn, usb_kbd_meta_ring_idx_off());
                    u32 ncyc = u32(usb_kbd_meta_load_u64(usb_kbd_meta_base, hn, usb_kbd_meta_ring_cycle_off()));
                        xhci_queue_noop(nring, &nidx, &ncyc, ndb, nep);
                        usb_kbd_meta_store_u64(usb_kbd_meta_base, hn, usb_kbd_meta_ring_idx_off(), u64(nidx));
                        usb_kbd_meta_store_u64(usb_kbd_meta_base, hn, usb_kbd_meta_ring_cycle_off(), u64(ncyc));
                        usb_noop_done = 1;
                        if (fb_out != ptr<u32>(0)) {
                            dbg_mark2_g(u8(5));
                        }
                        break;
                    }
                    hn += 1;
                }
            }
            i64 h = 0;
            while (h < usb_kbd_dev_cnt) {
                if (usb_kbd_meta_load_u64(usb_kbd_meta_base, h, usb_kbd_meta_used_off()) == u64(0)) {
                    h += 1;
                    continue;
                }
                if (usb_kbd_meta_load_i64(usb_kbd_meta_base, h, usb_kbd_meta_pending_off()) != i64(0)) {
                    h += 1;
                    continue;
                }
                ptr<u8> buf_h = usb_kbd_buf_ptr(usb_kbd_buf_base, h);
                i64 bi = 0;
                while (bi < 8) {
                    *(buf_h + bi) = u8(0xAA);
                    bi += 1;
                }
                u64 rep_addr = u64(buf_h);
                u32 nd0 = u32(rep_addr & u64(0xFFFFFFFF));
                u32 nd1 = u32((rep_addr >> u64(32)) & u64(0xFFFFFFFF));
                u32 nd2 = u32(8);
                u32 nd3 = u32(0);
                nd3 = nd3 | u32(1 << 2); // ISP
                nd3 = nd3 | u32(1 << 5);
                nd3 = nd3 | u32(1 << 10);
                ptr<u8> ring_h = usb_kbd_ring_ptr(usb_kbd_ring_base, h);
                ptr<u32> db_h = ptr<u32>(usb_kbd_meta_load_u64(usb_kbd_meta_base, h, usb_kbd_meta_db_off()));
                u32 ep_h = u32(usb_kbd_meta_load_u64(usb_kbd_meta_base, h, usb_kbd_meta_ep_id_off()));
                i64 idx_h = usb_kbd_meta_load_i64(usb_kbd_meta_base, h, usb_kbd_meta_ring_idx_off());
                u32 cyc_h = u32(usb_kbd_meta_load_u64(usb_kbd_meta_base, h, usb_kbd_meta_ring_cycle_off()));
                i64 last_idx_h = idx_h;
                if (usb_mark_enq == 0 && h == 0) {
                    usb_mark_enq = 1;
                    dbg_mark2_g(u8(0));
                }
                xhci_xfer_enqueue(ring_h, &idx_h, &cyc_h, nd0, nd1, nd2, nd3);
                xhci_ring_doorbell(db_h, ep_h);
                usb_kbd_meta_store_u64(usb_kbd_meta_base, h, usb_kbd_meta_ring_idx_off(), u64(idx_h));
                usb_kbd_meta_store_u64(usb_kbd_meta_base, h, usb_kbd_meta_ring_cycle_off(), u64(cyc_h));
                usb_kbd_meta_store_u64(usb_kbd_meta_base, h, usb_kbd_meta_pending_off(), u64(1));
                if (h == 0) {
                    usb_kbd_ring = ring_h;
                    usb_kbd_last_idx = last_idx_h;
                    usb_kbd_idx = idx_h;
                    usb_kbd_cycle = cyc_h;
                    usb_kbd_buf = buf_h;
                    usb_kbd_prev = usb_kbd_prev_ptr(usb_kbd_buf_base, h);
                }
                if (usb_mark_enq == 1 && h == 0) {
                    usb_mark_enq = 2;
                    dbg_mark2_g(u8(1));
                }
                if (usb_dbg_evt == 0) {
                    usb_dbg_evt = 1;
                }
                if (0 && usb_dbg_enq == 0 && fb_out != ptr<u32>(0) && h == 0) {
                    usb_dbg_enq = 1;
                    E();
                    N();
                    Q();
                    nl();
                    E();
                    P();
                    eq();
                    khex(u64(ep_h));
                    nl();
                    K();
                    B();
                    D();
                    eq();
                    khex(u64(ring_h));
                    nl();
                    B();
                    U();
                    F();
                    eq();
                    khex(u64(rep_addr));
                    nl();
                    I();
                    D();
                    X();
                    eq();
                    khex(u64(last_idx_h));
                    nl();
                    ptr<u32> trb32 = ptr<u32>(u64(ring_h));
                    ptr<u32> tbase = trb32 + last_idx_h * 4;
                    T();
                    d0();
                    eq();
                    khex(u64(*(tbase + 0)));
                    nl();
                    T();
                    d1();
                    eq();
                    khex(u64(*(tbase + 1)));
                    nl();
                    T();
                    d2();
                    eq();
                    khex(u64(*(tbase + 2)));
                    nl();
                    T();
                    d3();
                    eq();
                    khex(u64(*(tbase + 3)));
                    nl();
                }
                h += 1;
            }
            if (0 && usb_evt_dumped == 0 && fb_out != ptr<u32>(0)) {
                ptr<u32> er32 = ptr<u32>(u64(usb_evt_ring));
                u32 d0r = *(er32 + usb_evt_idx * 4 + 0);
                u32 d1r = *(er32 + usb_evt_idx * 4 + 1);
                u32 d2r = *(er32 + usb_evt_idx * 4 + 2);
                u32 d3r = *(er32 + usb_evt_idx * 4 + 3);
                usb_evt_dumped = 1;
                R();
                d0();
                eq();
                khex(u64(d0r));
                nl();

                R();
                d1();
                eq();
                khex(u64(d1r));
                nl();

                R();
                d2();
                eq();
                khex(u64(d2r));
                nl();

                R();
                d3();
                eq();
                khex(u64(d3r));
                nl();
            }
            u32 ev_d0u = u32(0);
            u32 ev_d1u = u32(0);
            u32 ev_d2u = u32(0);
            u32 ev_d3u = u32(0);
            i64 evt_ready = 1;
            if (usb_irq_mode) {
                u64 irq_cnt = volatile_load(usb_irq_flag);
                if (irq_cnt == usb_irq_seen) {
                    evt_ready = 0;
                } else {
                    usb_irq_seen = irq_cnt;
                }
            }
            if (evt_ready) {
                if (usb_mark_evt == 0) {
                    usb_mark_evt = 1;
                    dbg_mark2_g(u8(2));
                }
                if (usb_mark_d3 == 0) {
                    usb_mark_d3 = 1;
                    ptr<u32> ev32 = ptr<u32>(u64(usb_evt_ring));
                    u32 d3raw = *(ev32 + usb_evt_idx * 4 + 3);
                    if (d3raw == u32(0)) {
                        dbg_mark2_g(u8(9));
                        if (usb_evt_dumped == 0) {
                            usb_evt_dumped = 1;
                            nl();
                            dbg_dump_xhci_all_g();
                        }
                    } else {
                        u32 cyc = usb_evt_cycle & u32(1);
                        if ((d3raw & u32(1)) != cyc) {
                            dbg_mark2_g(u8(8));
                        }
                    }
                }
                while (xhci_evt_poll(usb_evt_ring, &usb_evt_idx, &usb_evt_cycle, &ev_d0u, &ev_d1u, &ev_d2u, &ev_d3u)) {
                u32 ev_typeu = (ev_d3u >> u32(10)) & u32(0x3F);
                u32 ccodeu = (ev_d2u >> u32(24)) & u32(0xFF);
                u32 ev_epu = (ev_d3u >> u32(16)) & u32(0x1F);
                u32 tr_len = ev_d2u & u32(0x00FFFFFF);
                u64 erdp_valu = u64(usb_evt_ring) + u64(usb_evt_idx) * u64(16);
                volatile_store(usb_erdp_reg, erdp_valu | u64(0x8));
                if (usb_iman_reg != ptr<u32>(0)) {
                    u32 iman_now = volatile_load(usb_iman_reg);
                    volatile_store(usb_iman_reg, iman_now | u32(1));
                }
                if (0 && usb_evt_log == 0 && fb_out != ptr<u32>(0)) {
                    usb_evt_log = 1;
                    E();
                    V();
                    eq();
                    khex(u64(ev_typeu));
                    spc();
                    C();
                    C();
                    eq();
                    khex(u64(ccodeu));
                    spc();
                    E();
                    P();
                    eq();
                    khex(u64(ev_epu));
                    nl();
                    R();
                    d0();
                    eq();
                    khex(u64(ev_d0u));
                    nl();
                    R();
                    d1();
                    eq();
                    khex(u64(ev_d1u));
                    nl();
                    R();
                    d2();
                    eq();
                    khex(u64(ev_d2u));
                    nl();
                    R();
                    d3();
                    eq();
                    khex(u64(ev_d3u));
                    nl();
                }
                if (ev_typeu == u32(32) && usb_dbg_tevt == 0 && fb_out != ptr<u32>(0)) {
                    usb_dbg_tevt = 1;
                    T();
                    E();
                    P();
                    eq();
                    khex(u64(ev_epu));
                    spc();
                    C();
                    C();
                    eq();
                    khex(u64(ccodeu));
                    spc();
                    T();
                    L();
                    eq();
                    khex(u64(tr_len));
                    nl();
                }
                if (ev_typeu == u32(32)) {
                    i64 h_evt = usb_kbd_find_by_ep(usb_kbd_meta_base, usb_kbd_dev_cnt, u64(ev_epu));
                    if (h_evt >= 0) {
                        ptr<u8> ring_evt = usb_kbd_ring_ptr(usb_kbd_ring_base, h_evt);
                        ptr<u8> rep = usb_kbd_buf_ptr(usb_kbd_buf_base, h_evt);
                        ptr<u8> prev = usb_kbd_prev_ptr(usb_kbd_buf_base, h_evt);
                        usb_kbd_ring = ring_evt;
                        usb_kbd_buf = rep;
                        usb_kbd_prev = prev;
                        usb_kbd_meta_store_u64(usb_kbd_meta_base, h_evt, usb_kbd_meta_pending_off(), u64(0));
                        usb_pending = 0;
                        if (fb_out != ptr<u32>(0)) {
                            E();
                            P();
                            eq();
                            khex(u64(ev_epu));
                            spc();
                            H();
                            eq();
                            khex(u64(h_evt));
                            nl();
                        }
                        if (usb_mark_tevt == 0) {
                            usb_mark_tevt = 1;
                            dbg_mark2_g(u8(3));
                        }
                        if (ccodeu == u32(1)) {
                            rt_wbinvd();
                            i64 dma_missing = 1;
                            i64 bj = 0;
                            while (bj < 8) {
                                if (*(rep + bj) != u8(0xAA)) { dma_missing = 0; }
                                bj += 1;
                            }
                            if (fb_out != ptr<u32>(0)) {
                                if (usb_irq_printed == 0 && usb_irq_seen != u64(0)) {
                                    usb_irq_printed = 1;
                                    I();
                                    R();
                                    Q();
                                    eq();
                                    khex(u64(usb_irq_seen));
                                    nl();
                                }
                                if (dma_missing != 0) {
                                    if (usb_dbg_evt == 1) {
                                        usb_dbg_evt = 2;
                                        D();
                                        M();
                                        A();
                                        nl();
                                        C();
                                        C();
                                        eq();
                                        khex(u64(ccodeu));
                                        nl();
                                        T();
                                        L();
                                        eq();
                                        khex(u64(tr_len));
                                        nl();
                                        B();
                                        U();
                                        F();
                                        eq();
                                        khex(u64(rep));
                                        nl();
                                        K();
                                        B();
                                        D();
                                        eq();
                                        khex(u64(ring_evt));
                                        nl();
                                        E();
                                        V();
                                        T();
                                        eq();
                                        khex(u64(usb_evt_ring));
                                        nl();
                                        u64 ev_ptr = u64(ev_d0u) | (u64(ev_d1u) << u64(32));
                                        u64 trb_ptr = u64(ring_evt) + u64(usb_kbd_last_idx) * u64(16);
                                        T();
                                        R();
                                        B();
                                        eq();
                                        khex(u64(trb_ptr));
                                        nl();
                                        E();
                                        V();
                                        P();
                                        eq();
                                        khex(u64(ev_ptr));
                                        nl();
                        if (0) {
                            bj = 0;
                            while (bj < 8) {
                                B();
                                kdigit(u8(bj));
                                            eq();
                                            khex(u64(*(rep + bj)));
                                            nl();
                                            bj += 1;
                                        }
                                    }
                                }
                                } else {
                                    if (0) {
                                        bj = 0;
                                        while (bj < 8) {
                                            B();
                                            kdigit(u8(bj));
                                            eq();
                                            khex(u64(*(rep + bj)));
                                            nl();
                                            bj += 1;
                                        }
                                    }
                                }
                            }
                            u8 mods = *(rep + 0);
                            i64 sh = 0;
                            if ((mods & u8(0x22)) != u8(0)) { sh = 1; }
                            i64 ki = 2;
                            while (ki < 8) {
                                u8 hid_keycode = *(rep + ki);
                                if (hid_keycode != u8(0) && !hid_key_in_prev(hid_keycode, prev)) {
                                    if (hid_keycode == u8(0x50)) { // left
                                        if (cur > 0) {
                                            cur -= 1;
                                            line_redraw(vga, rowp, colp, attr, line_row, line_col, line, len, prev_len, cur);
                                            fb_cursor_set_line(fb_out, fb_out_width, fb_out_xp, fb_out_yp, fb_line_row, fb_line_col, cur);
                                            prev_len = len;
                                        }
                                        ki += 1;
                                        continue;
                                    }
                                    if (hid_keycode == u8(0x4F)) { // right
                                        if (cur < len) {
                                            cur += 1;
                                            line_redraw(vga, rowp, colp, attr, line_row, line_col, line, len, prev_len, cur);
                                            fb_cursor_set_line(fb_out, fb_out_width, fb_out_xp, fb_out_yp, fb_line_row, fb_line_col, cur);
                                            prev_len = len;
                                        }
                                        ki += 1;
                                        continue;
                                    }
                                    u8 usb_ch = hid_key_to_ascii(hid_keycode, sh);
                                    if (usb_ch != u8(0)) {
                                        line_apply_char(usb_ch, vga, rowp, colp, attr, com1,
                                                        fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp,
                                                        &fb_cursor_on, &fb_cursor_x, &fb_cursor_y,
                                                        &fb_line_row, &fb_line_col, &fb_line_set,
                                                        line, &len, &prev_len, &cur, cap,
                                                        last_line, &last_len,
                                                        hist_base, hist_len_base, &hist_head, &hist_count, &hist_nav,
                                                        &line_row, &line_col);
                                    }
                                }
                                ki += 1;
                            }
                            i64 ci = 0;
                            while (ci < 8) {
                                *(prev + ci) = *(rep + ci);
                                ci += 1;
                            }
                            usb_kbd_prev = prev;
                        }
                    }
                }
            }
            usb_noevt = 0;
        } else {
            if (usb_dbg_evt == 1) {
                usb_noevt += 1;
                if (0 && usb_noevt > 2000000 && fb_out != ptr<u32>(0)) {
                    usb_dbg_evt = 3;
                    N();
                    E();
                    nl();
                }
            }
        }
        if (usb_ready) {
            ptr<u8> prev2 = usb_kbd_prev;
            u8 held = hid_first_key(prev2);
            if (held == u8(0)) {
                usb_repeat_key = u8(0);
                usb_repeat_count = 0;
            } else {
                if (held != usb_repeat_key) {
                    usb_repeat_key = held;
                    usb_repeat_count = 0;
                } else {
                    usb_repeat_count += 1;
                    if (usb_repeat_count == usb_repeat_delay ||
                        (usb_repeat_count > usb_repeat_delay &&
                         ((usb_repeat_count - usb_repeat_delay) % usb_repeat_rate) == 0)) {
                        i64 sh2 = 0;
                        u8 mods2 = *(prev2 + 0);
                        if ((mods2 & u8(0x22)) != u8(0)) { sh2 = 1; }
                        if (held == u8(0x50)) { // left
                            if (cur > 0) {
                                cur -= 1;
                                line_redraw(vga, rowp, colp, attr, line_row, line_col, line, len, prev_len, cur);
                                fb_cursor_set_line(fb_out, fb_out_width, fb_out_xp, fb_out_yp, fb_line_row, fb_line_col, cur);
                                prev_len = len;
                            }
                        } else {
                            if (held == u8(0x4F)) { // right
                                if (cur < len) {
                                    cur += 1;
                                    line_redraw(vga, rowp, colp, attr, line_row, line_col, line, len, prev_len, cur);
                                    fb_cursor_set_line(fb_out, fb_out_width, fb_out_xp, fb_out_yp, fb_line_row, fb_line_col, cur);
                                    prev_len = len;
                                }
                            } else {
                                if (held != u8(0x28)) {
                                    u8 usb_ch2 = hid_key_to_ascii(held, sh2);
                                    if (usb_ch2 != u8(0)) {
                                        line_apply_char(usb_ch2, vga, rowp, colp, attr, com1,
                                                        fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp,
                                                        &fb_cursor_on, &fb_cursor_x, &fb_cursor_y,
                                                        &fb_line_row, &fb_line_col, &fb_line_set,
                                                        line, &len, &prev_len, &cur, cap,
                                                        last_line, &last_len,
                                                        hist_base, hist_len_base, &hist_head, &hist_count, &hist_nav,
                                                        &line_row, &line_col);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        u8 sc = u8(0);
        if (use_irq_kbd) {
            sc = kbd_read_scancode_irq();
        } else {
            sc = kbd_read_scancode();
        }
        if (sc == u8(0) && use_irq_kbd) {
            sc = kbd_read_scancode();
        }
        if (sc == u8(0)) {
            continue;
        }
        if (sc == u8(0xE0)) {
            e0 = 1;
            continue;
        }
        if (sc == u8(0xE1)) {
            continue;
        }
        if (e0) {
            if (sc == u8(0x48)) {
                if (hist_count > 0) {
                    serial_log_key_up(com1);
                    if (hist_nav < 0) {
                        line_copy(edit_buf, line, len);
                        edit_len = len;
                        hist_nav = hist_head - 1;
                        if (hist_nav < 0) { hist_nav += 8; }
                    } else {
                        i64 oldest2 = hist_head - hist_count;
                        while (oldest2 < 0) { oldest2 += 8; }
                        if (hist_nav != oldest2) {
                            hist_nav = hist_nav - 1;
                            if (hist_nav < 0) { hist_nav += 8; }
                        }
                    }
                    ptr<u8> src = hist_entry_ptr(hist_base, hist_nav);
                    len = hist_get_len(hist_len_base, hist_nav);
                    line_copy(line, src, len);
                    cur = len;
                    line_redraw(vga, rowp, colp, attr, line_row, line_col, line, len, prev_len, cur);
                    prev_len = len;
                }
            } else {
                if (sc == u8(0x50)) {
                    if (hist_nav >= 0) {
                        serial_log_key_down(com1);
                        i64 uefi_newest = hist_head - 1;
                        if (uefi_newest < 0) { uefi_newest += 8; }
                        if (hist_nav == uefi_newest) {
                            hist_nav = -1;
                            line_copy(line, edit_buf, edit_len);
                            len = edit_len;
                        } else {
                            hist_nav = hist_nav + 1;
                            if (hist_nav >= 8) { hist_nav -= 8; }
                            ptr<u8> uefi_src2 = hist_entry_ptr(hist_base, hist_nav);
                            len = hist_get_len(hist_len_base, hist_nav);
                            line_copy(line, uefi_src2, len);
                        }
                        cur = len;
                        line_redraw(vga, rowp, colp, attr, line_row, line_col, line, len, prev_len, cur);
                        prev_len = len;
                    }
                } else {
                    if (sc == u8(0x4B)) {
                        if (cur > 0) {
                            serial_log_key_left(com1);
                            cur -= 1;
                            line_redraw(vga, rowp, colp, attr, line_row, line_col, line, len, prev_len, cur);
                            fb_cursor_set_line(fb_out, fb_out_width, fb_out_xp, fb_out_yp, fb_line_row, fb_line_col, cur);
                        }
                    } else {
                        if (sc == u8(0x4D)) {
                            if (cur < len) {
                                serial_log_key_right(com1);
                                cur += 1;
                                line_redraw(vga, rowp, colp, attr, line_row, line_col, line, len, prev_len, cur);
                                fb_cursor_set_line(fb_out, fb_out_width, fb_out_xp, fb_out_yp, fb_line_row, fb_line_col, cur);
                        }
                    }
                }
            }
        }
            if (sc == u8(0x53)) {
                line_apply_char(u8(0x7F), vga, rowp, colp, attr, com1,
                                fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp,
                                &fb_cursor_on, &fb_cursor_x, &fb_cursor_y,
                                &fb_line_row, &fb_line_col, &fb_line_set,
                                line, &len, &prev_len, &cur, cap,
                                last_line, &last_len,
                                hist_base, hist_len_base, &hist_head, &hist_count, &hist_nav,
                                &line_row, &line_col);
            }
            e0 = 0;
            continue;
        }
        if ((sc & u8(0x80)) != u8(0)) {
            u8 rel = sc & u8(0x7F);
            if ((rel == u8(0x2A)) || (rel == u8(0x36))) {
                shift = 0;
                continue;
            }
            continue;
        }
        if ((sc == u8(0x2A)) || (sc == u8(0x36))) {
            shift = 1;
            continue;
        }
        u8 ch = kbd_scancode_to_ascii(sc, shift);
        if (ch == u8(0)) {
            continue;
        }
        line_apply_char(ch, vga, rowp, colp, attr, com1,
                        fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp,
                        &fb_cursor_on, &fb_cursor_x, &fb_cursor_y,
                        &fb_line_row, &fb_line_col, &fb_line_set,
                        line, &len, &prev_len, &cur, cap,
                        last_line, &last_len,
                        hist_base, hist_len_base, &hist_head, &hist_count, &hist_nav,
                        &line_row, &line_col);
    }
}
}
