        i64 cx = *fxp;
        i64 cy = *fyp;
        ptr<i64> cxp = &cx;
        ptr<i64> cyp = &cy;
        i64 xhci_watch = 0;
        if (xhci_watch) {
            u32 last_ccs_mask = u32(0);
            while (1) {
                u32 ccs_mask = u32(0);
                i64 pscan = 1;
                while (pscan <= i64(max_ports)) {
                    u64 portsc_addr4 = op_base2 + u64(0x400) + u64(pscan - 1) * u64(0x10);
                    ptr<u32> portsc_reg4 = ptr<u32>(portsc_addr4);
                    u32 ps4 = volatile_load(portsc_reg4);
                    u32 ccs4 = ps4 & u32(1);
                    if (ccs4 != u32(0)) {
                        ccs_mask = ccs_mask | (u32(1) << u32(pscan - 1));
                    }
                    pscan += 1;
                }
                if (ccs_mask != last_ccs_mask && ccs_mask != u32(0)) {
                    last_ccs_mask = ccs_mask;
                    i64 pshow = 1;
                    while (pshow <= i64(max_ports)) {
                        if ((ccs_mask & (u32(1) << u32(pshow - 1))) != u32(0)) {
                            u64 portsc_addr5 = op_base2 + u64(0x400) + u64(pshow - 1) * u64(0x10);
                            ptr<u32> portsc_reg5 = ptr<u32>(portsc_addr5);
                            u32 ps5 = volatile_load(portsc_reg5);
                            u32 ccs5 = ps5 & u32(1);
                            u32 ped5 = (ps5 >> u32(1)) & u32(1);
                            u32 pls5 = (ps5 >> u32(5)) & u32(0xF);
                            u32 spd5 = (ps5 >> u32(10)) & u32(0xF);
                            fb_write_portsc_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), cxp, cyp, pshow);
                            fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), cxp, cyp, u64(ps5));
                            fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), cxp, cyp, u8(0x0A));
                            fb_write_ccs_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), cxp, cyp);
                            fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), cxp, cyp, u64(ccs5));
                            fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), cxp, cyp, u8(0x20));
                            fb_write_ped_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), cxp, cyp);
                            fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), cxp, cyp, u64(ped5));
                            fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), cxp, cyp, u8(0x20));
                            fb_write_pls_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), cxp, cyp);
                            fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), cxp, cyp, u64(pls5));
                            fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), cxp, cyp, u8(0x20));
                            fb_write_spd_label(fb, i64(fb_stride), i64(fb_width), i64(fb_height), cxp, cyp);
                            fb_write_hex_u64(fb, i64(fb_stride), i64(fb_width), i64(fb_height), cxp, cyp, u64(spd5));
                            fb_putc(fb, i64(fb_stride), i64(fb_width), i64(fb_height), cxp, cyp, u8(0x0A));
                        }
                        pshow += 1;
                    }
                }
                i64 idle = 200000;
                while (idle > 0) {
                    idle -= 1;
                }
            }
        }
        }
    }


    ptr<u8> line = rt_uefi_line();
    ptr<u8> last_line = rt_uefi_last_line();
    ptr<u8> hist_base = rt_uefi_hist_base();
    ptr<u8> hist_len_base = rt_uefi_hist_len_base();
    ptr<u8> edit_buf = rt_uefi_edit_buf();
    i64 len = 0;
    i64 last_len = 0;
    i64 prev_len = 0;
    i64 cur = 0;
    i64 cap = 256;
    i64 hist_head = 0;
    i64 hist_count = 0;
    i64 hist_nav = -1;
    i64 edit_len = 0;
    i64 e0 = 0;
    i64 line_row = 0;
    i64 line_col = 0;

    tty_clear(vga, rowp, colp, attr);
    tty_write_prompt(vga, rowp, colp, attr);
    line_row = *rowp;
    line_col = *colp;
    serial_write_byte(com1, u8(0x3E));
    serial_write_byte(com1, u8(0x20));
    if (0 && fb_out != ptr<u32>(0)) {
        fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x52)); // R
        fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x45)); // E
        fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x41)); // A
        fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x44)); // D
        fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x59)); // Y
        fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x0A)); // \n
    }
    if (fb_base != u64(0)) {
        if (0) {
            ptr<u32> fb_dbg5 = ptr<u32>(fb_base);
            i64 dx5 = 0;
            i64 dy5 = 5;
            ptr<i64> dx5p = &dx5;
            ptr<i64> dy5p = &dy5;
            fb_putc(fb_dbg5, i64(fb_stride), i64(fb_width), i64(fb_height), dx5p, dy5p, u8(0x35)); // 5
        }
    }

    i64 one = 1;
    while (one) {
        u64 key = u64(0);
        u16 uefi_uc = u16(0);
        u16 uefi_sc = u16(0);
        if (uefi) {
            key = uefi_read_key();
            if (key != u64(0)) {
                uefi_uc = u16(key & u64(0xFFFF));
                uefi_sc = u16((key >> u64(16)) & u64(0xFFFF));
            }
        }
        if (uefi && ((uefi_uc != u16(0)) || (uefi_sc != u16(0)))) {
            if (uefi_sc != u16(0)) {
                if (uefi_sc == u16(1)) {
                    if (hist_count > 0) {
                        serial_log_key_up(com1);
                        if (hist_nav < 0) {
                            line_copy(edit_buf, line, len);
                            edit_len = len;
                            hist_nav = hist_head - 1;
                            if (hist_nav < 0) { hist_nav += 8; }
                        } else {
                            i64 uefi_oldest = hist_head - hist_count;
                            while (uefi_oldest < 0) { uefi_oldest += 8; }
                            if (hist_nav != uefi_oldest) {
                                hist_nav = hist_nav - 1;
                                if (hist_nav < 0) { hist_nav += 8; }
                            }
                        }
                        ptr<u8> uefi_src = hist_entry_ptr(hist_base, hist_nav);
                        len = hist_get_len(hist_len_base, hist_nav);
                        line_copy(line, uefi_src, len);
                        cur = len;
                        line_redraw(vga, rowp, colp, attr, line_row, line_col, line, len, prev_len, cur);
                        prev_len = len;
                    }
                } else {
                    if (uefi_sc == u16(2)) {
                        if (hist_nav >= 0) {
                            serial_log_key_down(com1);
                            i64 newest = hist_head - 1;
                            if (newest < 0) { newest += 8; }
                            if (hist_nav == newest) {
                                hist_nav = -1;
                                line_copy(line, edit_buf, edit_len);
                                len = edit_len;
                            } else {
                                hist_nav = hist_nav + 1;
                                if (hist_nav >= 8) { hist_nav -= 8; }
                                ptr<u8> src2 = hist_entry_ptr(hist_base, hist_nav);
                                len = hist_get_len(hist_len_base, hist_nav);
                                line_copy(line, src2, len);
                            }
                            cur = len;
                            line_redraw(vga, rowp, colp, attr, line_row, line_col, line, len, prev_len, cur);
                            prev_len = len;
                        }
                    } else {
                        if (uefi_sc == u16(4)) {
                            if (cur > 0) {
                                serial_log_key_left(com1);
                                cur -= 1;
                                line_redraw(vga, rowp, colp, attr, line_row, line_col, line, len, prev_len, cur);
                            }
                        } else {
                            if (uefi_sc == u16(3)) {
                                if (cur < len) {
                                    serial_log_key_right(com1);
                                    cur += 1;
                                    line_redraw(vga, rowp, colp, attr, line_row, line_col, line, len, prev_len, cur);
                                }
                            }
                        }
                    }
                }
                continue;
            }
            if (uefi_uc != u16(0)) {
                u8 uefi_ch = u8(uefi_uc);
                if (uefi_ch == u8(0x0D)) { uefi_ch = u8(0x0A); }
                if (uefi_ch == u8(0x08)) {
                    if (cur > 0) {
                        i64 uefi_k = cur - 1;
                        while (uefi_k < len - 1) {
                            *(line + uefi_k) = *(line + uefi_k + 1);
                            uefi_k += 1;
                        }
                        len -= 1;
                        cur -= 1;
                        line_redraw(vga, rowp, colp, attr, line_row, line_col, line, len, prev_len, cur);
                        prev_len = len;
                    }
                    continue;
                }
                if (uefi_ch == u8(0x0A)) {
                serial_write_newline(com1);
                tty_putc(vga, rowp, colp, attr, uefi_ch);
                if (fb_out != ptr<u32>(0)) {
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, uefi_ch);
                }
                if (len > 0) {
                    line_copy(last_line, line, len);
                    last_len = len;
                        ptr<u8> uefi_dst = hist_entry_ptr(hist_base, hist_head);
                        line_copy(uefi_dst, line, len);
                        hist_set_len(hist_len_base, hist_head, len);
                        hist_head += 1;
                        if (hist_head >= 8) { hist_head = 0; }
                        if (hist_count < 8) { hist_count += 1; }
                    }
                    run_command(vga, rowp, colp, attr, com1, line, len);
                    len = 0;
                    cur = 0;
                    prev_len = 0;
                    hist_nav = -1;
                    tty_write_prompt(vga, rowp, colp, attr);
                    line_row = *rowp;
                    line_col = *colp;
                    serial_write_byte(com1, u8(0x3E));
                    serial_write_byte(com1, u8(0x20));
                    continue;
                }
                if (uefi_ch < u8(0x20)) {
                    continue;
                }
                if (len >= cap - 1) {
                    continue;
                }
                i = len;
                while (i > cur) {
                    *(line + i) = *(line + i - 1);
                    i -= 1;
                }
                *(line + cur) = uefi_ch;
                len += 1;
                cur += 1;
                serial_write_byte(com1, uefi_ch);
                if (fb_out != ptr<u32>(0)) {
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, uefi_ch);
                }
                line_redraw(vga, rowp, colp, attr, line_row, line_col, line, len, prev_len, cur);
                prev_len = len;
                continue;
            }
        }

        if (usb_ready) {
            if (!usb_pending) {
                i64 bi = 0;
                while (bi < 8) {
                    *(usb_kbd_buf + bi) = u8(0xAA);
                    bi += 1;
                }
                u64 rep_addr = u64(usb_kbd_buf);
                u32 nd0 = u32(rep_addr & u64(0xFFFFFFFF));
                u32 nd1 = u32((rep_addr >> u64(32)) & u64(0xFFFFFFFF));
                u32 nd2 = u32(8);
                u32 nd3 = u32(0);
                nd3 = nd3 | u32(1 << 2); // ISP
                nd3 = nd3 | u32(1 << 5);
                nd3 = nd3 | u32(1 << 10);
                usb_kbd_last_idx = usb_kbd_idx;
                if (usb_mark_enq == 0) {
                    usb_mark_enq = 1;
                    dbg_mark2(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0));
                }
                xhci_xfer_enqueue(usb_kbd_ring, &usb_kbd_idx, &usb_kbd_cycle, nd0, nd1, nd2, nd3);
                *usb_db_reg = usb_ep_id;
                if (usb_mark_enq == 1) {
                    usb_mark_enq = 2;
                    dbg_mark2(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(1));
                }
                usb_pending = 1;
                if (usb_dbg_evt == 0) {
                    usb_dbg_evt = 1;
                }
                if (0 && usb_dbg_enq == 0 && fb_out != ptr<u32>(0)) {
                    usb_dbg_enq = 1;
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x45)); // E
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x4E)); // N
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x51)); // Q
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x0A));
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x45)); // E
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x50)); // P
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x3D));
                    fb_write_hex_u64(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u64(usb_ep_id));
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x0A));
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x4B)); // K
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x42)); // B
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x44)); // D
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x3D));
                    fb_write_hex_u64(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u64(usb_kbd_ring));
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x0A));
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x42)); // B
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x55)); // U
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x46)); // F
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x3D));
                    fb_write_hex_u64(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u64(rep_addr));
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x0A));
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x49)); // I
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x44)); // D
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x58)); // X
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x3D));
                    fb_write_hex_u64(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u64(usb_kbd_last_idx));
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x0A));
                    ptr<u32> trb32 = ptr<u32>(u64(usb_kbd_ring));
                    ptr<u32> tbase = trb32 + usb_kbd_last_idx * 4;
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x54)); // T
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x30)); // 0
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x3D));
                    fb_write_hex_u64(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u64(*(tbase + 0)));
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x0A));
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x54)); // T
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x31)); // 1
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x3D));
                    fb_write_hex_u64(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u64(*(tbase + 1)));
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x0A));
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x54)); // T
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x32)); // 2
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x3D));
                    fb_write_hex_u64(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u64(*(tbase + 2)));
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x0A));
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x54)); // T
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x33)); // 3
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x3D));
                    fb_write_hex_u64(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u64(*(tbase + 3)));
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x0A));
                }
            }
            if (0 && usb_evt_dumped == 0 && fb_out != ptr<u32>(0)) {
                ptr<u32> er32 = ptr<u32>(u64(usb_evt_ring));
                u32 d0r = *(er32 + usb_evt_idx * 4 + 0);
                u32 d1r = *(er32 + usb_evt_idx * 4 + 1);
                u32 d2r = *(er32 + usb_evt_idx * 4 + 2);
                u32 d3r = *(er32 + usb_evt_idx * 4 + 3);
                usb_evt_dumped = 1;
                fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x52)); // R
                fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x30)); // 0
                fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x3D));
                fb_write_hex_u64(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u64(d0r));
                fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x0A));

                fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x52)); // R
                fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x31)); // 1
                fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x3D));
                fb_write_hex_u64(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u64(d1r));
                fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x0A));

                fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x52)); // R
                fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x32)); // 2
                fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x3D));
                fb_write_hex_u64(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u64(d2r));
                fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x0A));

                fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x52)); // R
                fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x33)); // 3
                fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x3D));
                fb_write_hex_u64(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u64(d3r));
                fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x0A));
            }
            u32 ev_d0u = u32(0);
            u32 ev_d1u = u32(0);
            u32 ev_d2u = u32(0);
            u32 ev_d3u = u32(0);
            i64 evt_ready = 1;
            if (usb_irq_mode) {
                u64 irq_cnt = volatile_load(usb_irq_flag);
                if (irq_cnt == usb_irq_seen) {
                    evt_ready = 0;
                } else {
                    usb_irq_seen = irq_cnt;
                }
            }
            if (evt_ready) {
                if (usb_mark_evt == 0) {
                    usb_mark_evt = 1;
                    dbg_mark2(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(2));
                }
                if (usb_mark_d3 == 0) {
                    usb_mark_d3 = 1;
                    ptr<u32> ev32 = ptr<u32>(u64(usb_evt_ring));
                    u32 d3raw = *(ev32 + usb_evt_idx * 4 + 3);
                    if (d3raw == u32(0)) {
                        dbg_mark2(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(9));
                    } else {
                        u32 cyc = usb_evt_cycle & u32(1);
                        if ((d3raw & u32(1)) != cyc) {
                            dbg_mark2(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(8));
                        }
                    }
                }
                while (xhci_evt_poll(usb_evt_ring, &usb_evt_idx, &usb_evt_cycle, &ev_d0u, &ev_d1u, &ev_d2u, &ev_d3u)) {
                u32 ev_typeu = (ev_d3u >> u32(10)) & u32(0x3F);
                u32 ccodeu = (ev_d2u >> u32(24)) & u32(0xFF);
                u32 ev_epu = (ev_d3u >> u32(16)) & u32(0x1F);
                u32 tr_len = ev_d2u & u32(0x00FFFFFF);
                u64 erdp_valu = u64(usb_evt_ring) + u64(usb_evt_idx) * u64(16);
                volatile_store(usb_erdp_reg, erdp_valu | u64(0x8));
                if (usb_iman_reg != ptr<u32>(0)) {
                    u32 iman_now = volatile_load(usb_iman_reg);
                    volatile_store(usb_iman_reg, iman_now | u32(1));
                }
                if (0 && usb_evt_log == 0 && fb_out != ptr<u32>(0)) {
                    usb_evt_log = 1;
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x45)); // E
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x56)); // V
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x3D));
                    fb_write_hex_u64(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u64(ev_typeu));
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x20));
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x43)); // C
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x43)); // C
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x3D));
                    fb_write_hex_u64(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u64(ccodeu));
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x20));
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x45)); // E
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x50)); // P
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x3D));
                    fb_write_hex_u64(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u64(ev_epu));
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x0A));
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x52)); // R
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x30)); // 0
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x3D));
                    fb_write_hex_u64(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u64(ev_d0u));
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x0A));
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x52)); // R
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x31)); // 1
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x3D));
                    fb_write_hex_u64(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u64(ev_d1u));
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x0A));
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x52)); // R
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x32)); // 2
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x3D));
                    fb_write_hex_u64(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u64(ev_d2u));
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x0A));
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x52)); // R
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x33)); // 3
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x3D));
                    fb_write_hex_u64(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u64(ev_d3u));
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x0A));
                }
                if (ev_typeu == u32(32) && usb_dbg_tevt == 0 && fb_out != ptr<u32>(0)) {
                    usb_dbg_tevt = 1;
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x54)); // T
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x45)); // E
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x50)); // P
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x3D));
                    fb_write_hex_u64(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u64(ev_epu));
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x20));
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x43)); // C
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x43)); // C
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x3D));
                    fb_write_hex_u64(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u64(ccodeu));
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x20));
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x54)); // T
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x4C)); // L
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x3D));
                    fb_write_hex_u64(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u64(tr_len));
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x0A));
                }
                if (ev_typeu == u32(32) && ev_epu == usb_ep_id) {
                    if (usb_mark_tevt == 0) {
                        usb_mark_tevt = 1;
                        dbg_mark2(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(3));
                    }
                    usb_pending = 0;
                    if (ccodeu == u32(1)) {
                        rt_wbinvd();
                        ptr<u8> rep = usb_kbd_buf;
                        ptr<u8> prev = usb_kbd_buf + 8;
                        i64 dma_missing = 1;
                        i64 bj = 0;
                        while (bj < 8) {
                            if (*(rep + bj) != u8(0xAA)) { dma_missing = 0; }
                            bj += 1;
                        }
                        if (fb_out != ptr<u32>(0)) {
                            if (usb_irq_printed == 0 && usb_irq_seen != u64(0)) {
                                usb_irq_printed = 1;
                                fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x49)); // I
                                fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x52)); // R
                                fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x51)); // Q
                                fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x3D));
                                fb_write_hex_u64(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u64(usb_irq_seen));
                                fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x0A));
                            }
                            if (dma_missing != 0) {
                                if (usb_dbg_evt == 1) {
                                    usb_dbg_evt = 2;
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x44)); // D
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x4D)); // M
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x41)); // A
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x0A));
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x43)); // C
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x43)); // C
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x3D));
                                    fb_write_hex_u64(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u64(ccodeu));
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x0A));
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x54)); // T
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x4C)); // L
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x3D));
                                    fb_write_hex_u64(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u64(tr_len));
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x0A));
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x42)); // B
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x55)); // U
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x46)); // F
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x3D));
                                    fb_write_hex_u64(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u64(usb_kbd_buf));
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x0A));
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x4B)); // K
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x42)); // B
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x44)); // D
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x3D));
                                    fb_write_hex_u64(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u64(usb_kbd_ring));
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x0A));
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x45)); // E
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x56)); // V
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x54)); // T
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x3D));
                                    fb_write_hex_u64(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u64(usb_evt_ring));
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x0A));
                                    u64 ev_ptr = u64(ev_d0u) | (u64(ev_d1u) << u64(32));
                                    u64 trb_ptr = u64(usb_kbd_ring) + u64(usb_kbd_last_idx) * u64(16);
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x54)); // T
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x52)); // R
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x42)); // B
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x3D));
                                    fb_write_hex_u64(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u64(trb_ptr));
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x0A));
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x45)); // E
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x56)); // V
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x50)); // P
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x3D));
                                    fb_write_hex_u64(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u64(ev_ptr));
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x0A));
                                    bj = 0;
                                    while (bj < 8) {
                                        fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x42)); // B
                                        fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x30) + u8(bj));
                                        fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x3D));
                                        fb_write_hex_u64(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u64(*(rep + bj)));
                                        fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x0A));
                                        bj += 1;
                                    }
                                }
                            } else {
                                bj = 0;
                                while (bj < 8) {
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x42)); // B
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x30) + u8(bj));
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x3D));
                                    fb_write_hex_u64(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u64(*(rep + bj)));
                                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x0A));
                                    bj += 1;
                                }
                            }
                        }
                        u8 mods = *(rep + 0);
                        i64 sh = 0;
                        if ((mods & u8(0x22)) != u8(0)) { sh = 1; }
                        i64 ki = 2;
                        while (ki < 8) {
                            u8 hid_keycode = *(rep + ki);
                            if (hid_keycode != u8(0) && !hid_key_in_prev(hid_keycode, prev)) {
                                u8 usb_ch = hid_key_to_ascii(hid_keycode, sh);
                                if (usb_ch != u8(0)) {
                                    if (usb_ch >= u8(0x61) && usb_ch <= u8(0x7A)) {
                                        usb_ch = usb_ch - u8(0x20);
                                    }
                                    if (fb_out != ptr<u32>(0)) {
                                        fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, usb_ch);
                                    }
                                }
                            }
                            ki += 1;
                        }
                        i64 ci = 0;
                        while (ci < 8) {
                            *(prev + ci) = *(rep + ci);
                            ci += 1;
                        }
                    }
                }
            }
            usb_noevt = 0;
        } else {
            if (usb_dbg_evt == 1) {
                usb_noevt += 1;
                if (0 && usb_noevt > 2000000 && fb_out != ptr<u32>(0)) {
                    usb_dbg_evt = 3;
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x4E)); // N
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x45)); // E
                    fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, u8(0x0A));
                }
            }
        }

        u8 sc = u8(0);
        if (use_irq_kbd) {
            sc = kbd_read_scancode_irq();
        } else {
            sc = kbd_read_scancode();
        }
        if (sc == u8(0) && use_irq_kbd) {
            sc = kbd_read_scancode();
        }
        if (sc == u8(0)) {
            continue;
        }
        if (sc == u8(0xE0)) {
            e0 = 1;
            continue;
        }
        if (sc == u8(0xE1)) {
            continue;
        }
        if (e0) {
            if (sc == u8(0x48)) {
                if (hist_count > 0) {
                    serial_log_key_up(com1);
                    if (hist_nav < 0) {
                        line_copy(edit_buf, line, len);
                        edit_len = len;
                        hist_nav = hist_head - 1;
                        if (hist_nav < 0) { hist_nav += 8; }
                    } else {
                        i64 oldest2 = hist_head - hist_count;
                        while (oldest2 < 0) { oldest2 += 8; }
                        if (hist_nav != oldest2) {
                            hist_nav = hist_nav - 1;
                            if (hist_nav < 0) { hist_nav += 8; }
                        }
                    }
                    ptr<u8> src = hist_entry_ptr(hist_base, hist_nav);
                    len = hist_get_len(hist_len_base, hist_nav);
                    line_copy(line, src, len);
                    cur = len;
                    line_redraw(vga, rowp, colp, attr, line_row, line_col, line, len, prev_len, cur);
                    prev_len = len;
                }
            } else {
                if (sc == u8(0x50)) {
                    if (hist_nav >= 0) {
                        serial_log_key_down(com1);
                        i64 uefi_newest = hist_head - 1;
                        if (uefi_newest < 0) { uefi_newest += 8; }
                        if (hist_nav == uefi_newest) {
                            hist_nav = -1;
                            line_copy(line, edit_buf, edit_len);
                            len = edit_len;
                        } else {
                            hist_nav = hist_nav + 1;
                            if (hist_nav >= 8) { hist_nav -= 8; }
                            ptr<u8> uefi_src2 = hist_entry_ptr(hist_base, hist_nav);
                            len = hist_get_len(hist_len_base, hist_nav);
                            line_copy(line, uefi_src2, len);
                        }
                        cur = len;
                        line_redraw(vga, rowp, colp, attr, line_row, line_col, line, len, prev_len, cur);
                        prev_len = len;
                    }
                } else {
                    if (sc == u8(0x4B)) {
                        if (cur > 0) {
                            serial_log_key_left(com1);
                            cur -= 1;
                            line_redraw(vga, rowp, colp, attr, line_row, line_col, line, len, prev_len, cur);
                        }
                    } else {
                        if (sc == u8(0x4D)) {
                            if (cur < len) {
                                serial_log_key_right(com1);
                                cur += 1;
                                line_redraw(vga, rowp, colp, attr, line_row, line_col, line, len, prev_len, cur);
                            }
                        }
                    }
                }
            }
            e0 = 0;
            continue;
        }
        if ((sc & u8(0x80)) != u8(0)) {
            u8 rel = sc & u8(0x7F);
            if ((rel == u8(0x2A)) || (rel == u8(0x36))) {
                shift = 0;
                continue;
            }
            continue;
        }
        if ((sc == u8(0x2A)) || (sc == u8(0x36))) {
            shift = 1;
            continue;
        }
        u8 ch = kbd_scancode_to_ascii(sc, shift);
        if (ch == u8(0)) {
            continue;
        }
        if (ch >= u8(0x61) && ch <= u8(0x7A)) {
            ch = ch - u8(0x20);
        }
        if (fb_out != ptr<u32>(0)) {
            fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, ch);
        }
        if (ch == u8(0x08)) {
            if (cur > 0) {
                i64 k = cur - 1;
                while (k < len - 1) {
                    *(line + k) = *(line + k + 1);
                    k += 1;
                }
                len -= 1;
                cur -= 1;
                line_redraw(vga, rowp, colp, attr, line_row, line_col, line, len, prev_len, cur);
                prev_len = len;
            }
            continue;
        }
        if (ch == u8(0x0A)) {
            serial_write_newline(com1);
            tty_putc(vga, rowp, colp, attr, ch);
            if (fb_out != ptr<u32>(0)) {
                fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, ch);
            }
            if (len > 0) {
                line_copy(last_line, line, len);
                last_len = len;
                ptr<u8> dst = hist_entry_ptr(hist_base, hist_head);
                line_copy(dst, line, len);
                hist_set_len(hist_len_base, hist_head, len);
                hist_head += 1;
                if (hist_head >= 8) { hist_head = 0; }
                if (hist_count < 8) { hist_count += 1; }
            }
            run_command(vga, rowp, colp, attr, com1, line, len);
            len = 0;
            cur = 0;
            prev_len = 0;
            hist_nav = -1;
            tty_write_prompt(vga, rowp, colp, attr);
            line_row = *rowp;
            line_col = *colp;
            serial_write_byte(com1, u8(0x3E));
            serial_write_byte(com1, u8(0x20));
            continue;
        }
        if (ch < u8(0x20)) {
            continue;
        }
        if (len >= cap - 1) {
            continue;
        }
        i = len;
        while (i > cur) {
            *(line + i) = *(line + i - 1);
            i -= 1;
        }
        *(line + cur) = ch;
        len += 1;
        cur += 1;
        serial_write_byte(com1, ch);
        if (fb_out != ptr<u32>(0)) {
            fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, ch);
        }
        line_redraw(vga, rowp, colp, attr, line_row, line_col, line, len, prev_len, cur);
        prev_len = len;
    }
}
}
