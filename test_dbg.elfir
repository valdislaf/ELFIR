    serial_write_byte(port, u8(0x63));
    serial_write_byte(port, u8(0x6D));
    serial_write_byte(port, u8(0x64));
    serial_write_byte(port, u8(0x3A));
    serial_write_byte(port, u8(0x20));
    serial_write_byte(port, u8(0x3F));
    serial_write_newline(port);
}

fn serial_log_key_up(u16 port) {
    serial_write_byte(port, u8(0x6B));
    serial_write_byte(port, u8(0x65));
    serial_write_byte(port, u8(0x79));
    serial_write_byte(port, u8(0x3A));
    serial_write_byte(port, u8(0x20));
    serial_write_byte(port, u8(0x75));
    serial_write_byte(port, u8(0x70));
    serial_write_newline(port);
}

fn serial_log_key_down(u16 port) {
    serial_write_byte(port, u8(0x6B));
    serial_write_byte(port, u8(0x65));
    serial_write_byte(port, u8(0x79));
    serial_write_byte(port, u8(0x3A));
    serial_write_byte(port, u8(0x20));
    serial_write_byte(port, u8(0x64));
    serial_write_byte(port, u8(0x6F));
    serial_write_byte(port, u8(0x77));
    serial_write_byte(port, u8(0x6E));
    serial_write_newline(port);
}

fn serial_log_key_left(u16 port) {
    serial_write_byte(port, u8(0x6B));
    serial_write_byte(port, u8(0x65));
    serial_write_byte(port, u8(0x79));
    serial_write_byte(port, u8(0x3A));
    serial_write_byte(port, u8(0x20));
    serial_write_byte(port, u8(0x6C));
    serial_write_byte(port, u8(0x65));
    serial_write_byte(port, u8(0x66));
    serial_write_byte(port, u8(0x74));
    serial_write_newline(port);
}

fn serial_log_key_right(u16 port) {
    serial_write_byte(port, u8(0x6B));
    serial_write_byte(port, u8(0x65));
    serial_write_byte(port, u8(0x79));
    serial_write_byte(port, u8(0x3A));
    serial_write_byte(port, u8(0x20));
    serial_write_byte(port, u8(0x72));
    serial_write_byte(port, u8(0x69));
    serial_write_byte(port, u8(0x67));
    serial_write_byte(port, u8(0x68));
    serial_write_byte(port, u8(0x74));
    serial_write_newline(port);
}

fn u8 sel_shift(i64 shift, u8 normal, u8 shifted) {
    if (shift) {
        ret shifted;
    }
    ret normal;
}

fn dbg_dump_xhci_all(ptr<u32> fb_out, i64 fb_stride, i64 fb_width, i64 fb_height,
    ptr<i64> fb_xp, ptr<i64> fb_yp) {
    if (fb_out == ptr<u32>(0)) { ret; }
    kbind_fb(fb_out, fb_stride, fb_width, fb_height, fb_xp, fb_yp);
    i64 bus = 0;
    while (bus < 256) {
        i64 dev = 0;
        while (dev < 32) {
            i64 func = 0;
            while (func < 8) {
                u32 id = pci_read32(u8(bus), u8(dev), u8(func), u8(0x00));
                if ((id & u32(0xFFFF)) != u32(0xFFFF)) {
                    u32 classc = pci_read32(u8(bus), u8(dev), u8(func), u8(0x08));
                    u8 prog = u8((classc >> u32(8)) & u32(0xFF));
                    u8 sub = u8((classc >> u32(16)) & u32(0xFF));
                    u8 cls = u8((classc >> u32(24)) & u32(0xFF));
                    if (cls == u8(0x0C) && sub == u8(0x03) && prog == u8(0x30)) {
                        u32 bar0 = pci_read32(u8(bus), u8(dev), u8(func), u8(0x10));
                        u32 bar1 = pci_read32(u8(bus), u8(dev), u8(func), u8(0x14));
                        u64 base = (u64(bar1) << u64(32)) | u64(bar0);
                        base = base & ~u64(0xF);

                        nl();
                        X();
                        H();
                        C();
                        I();
                        spc();

                        B();
                        eq();
                        khex(u64(bus));
                        spc();
                        D();
                        eq();
                        khex(u64(dev));
                        spc();
                        F();
                        eq();
                        khex(u64(func));
                        spc();
                        I();
                        D();
                        eq();
                        khex(u64(id));
                        nl();

                        B();
                        A();
                        S();
                        E();
                        eq();
                        khex(base);
                        spc();

                        ptr<u32> cap_reg = ptr<u32>(base);
                        u32 cap0 = volatile_load(cap_reg);
                        u8 caplen = u8(cap0 & u32(0xFF));
                        ptr<u32> hcs1_reg = ptr<u32>(base + u64(0x04));
                        u32 hcs1 = volatile_load(hcs1_reg);
                        u8 max_ports = u8((hcs1 >> u32(24)) & u32(0xFF));
                        P();
                        O();
                        R();
                        T();
                        S();
                        eq();
                        khex(u64(max_ports));
                        nl();

                        u64 op_base = base + u64(caplen);
                        i64 pr = 1;
                        while (pr <= i64(max_ports)) {
                            u64 portsc_addr = op_base + u64(0x400) + u64(pr - 1) * u64(0x10);
                            ptr<u32> portsc_reg = ptr<u32>(portsc_addr);
                            u32 ps = volatile_load(portsc_reg);
                            u32 ccs = ps & u32(1);
                            u32 ped = (ps >> u32(1)) & u32(1);
                            u32 pls = (ps >> u32(5)) & u32(0xF);
                            u32 spd = (ps >> u32(10)) & u32(0xF);

                            fb_write_portsc_label(fb_out, fb_stride, fb_width, fb_height, fb_xp, fb_yp, pr);
                            khex(u64(ps));
                            nl();
                            fb_write_ccs_label(fb_out, fb_stride, fb_width, fb_height, fb_xp, fb_yp);
                            khex(u64(ccs));
                            spc();
                            fb_write_ped_label(fb_out, fb_stride, fb_width, fb_height, fb_xp, fb_yp);
                            khex(u64(ped));
                            spc();
                            fb_write_pls_label(fb_out, fb_stride, fb_width, fb_height, fb_xp, fb_yp);
                            khex(u64(pls));
                            spc();
                            fb_write_spd_label(fb_out, fb_stride, fb_width, fb_height, fb_xp, fb_yp);
                            khex(u64(spd));
                            nl();
                            pr += 1;
                        }
                    }
                }
                func += 1;
            }
            dev += 1;
        }
        bus += 1;
    }
    ret;
}

fn u32 pci_read32(u8 bus, u8 dev, u8 func, u8 off) {
    u32 addr = pci_cfg_addr(bus, dev, func, off);
    out32(u16(0xCF8), addr);
    ret in32(u16(0xCFC));
}
fn u32 pci_cfg_addr(u8 bus, u8 dev, u8 func, u8 off) {
    u32 addr = u32(0x80000000);
    addr = addr | (u32(bus) << u32(16));
    addr = addr | (u32(dev) << u32(11));
    addr = addr | (u32(func) << u32(8));
    addr = addr | (u32(off) & u32(0xFC));
    ret addr;
}fn line_apply_char(u8 ch, ptr<u16> vga, ptr<i64> rowp, ptr<i64> colp, u16 attr, u16 com1,
    ptr<u32> fb_out, i64 fb_out_stride, i64 fb_out_width, i64 fb_out_height,
    ptr<i64> fb_out_xp, ptr<i64> fb_out_yp,
    ptr<i64> fb_cursor_onp, ptr<i64> fb_cursor_xp, ptr<i64> fb_cursor_yp,
    ptr<i64> fb_line_rowp, ptr<i64> fb_line_colp, ptr<i64> fb_line_setp,
    ptr<u8> line, ptr<i64> lenp, ptr<i64> prev_lenp, ptr<i64> curp, i64 cap,
    ptr<u8> last_line, ptr<i64> last_lenp,
    ptr<u8> hist_base, ptr<u8> hist_len_base, ptr<i64> hist_headp, ptr<i64> hist_countp, ptr<i64> hist_navp,
    ptr<i64> line_rowp, ptr<i64> line_colp) {
    i64 len = *lenp;
    i64 prev_len = *prev_lenp;
    i64 cur = *curp;

    if (fb_out != ptr<u32>(0) && *fb_line_setp == 0) {
        *fb_line_rowp = *fb_out_yp;
        *fb_line_colp = *fb_out_xp;
        *fb_line_setp = 1;
    }

    if (ch == u8(0x08)) {
        if (cur > 0) {
            i64 k = cur - 1;
            while (k < len - 1) {
                *(line + k) = *(line + k + 1);
                k += 1;
            }
            len -= 1;
            cur -= 1;
            if (fb_out != ptr<u32>(0) && *fb_cursor_onp != 0) {
                fb_cursor_xor(fb_out, fb_out_stride, fb_out_width, fb_out_height, *fb_cursor_xp, *fb_cursor_yp);
                *fb_cursor_onp = 0;
            }
            line_redraw(vga, rowp, colp, attr, *line_rowp, *line_colp, line, len, prev_len, cur);
            if (fb_out != ptr<u32>(0)) {
                fb_redraw_from(fb_out, fb_out_stride, fb_out_width, fb_out_height,
                    *fb_line_rowp, *fb_line_colp, line, len, prev_len, cur);
                fb_cursor_set_line(fb_out, fb_out_width, fb_out_xp, fb_out_yp, *fb_line_rowp, *fb_line_colp, cur);
            }
            line_redraw_serial(com1, line, len, prev_len, cur);
            prev_len = len;
        }
        *lenp = len;
        *prev_lenp = prev_len;
        *curp = cur;
        ret;
    }

    if (ch == u8(0x7F)) {
        if (cur < len) {
            i64 k2 = cur;
            while (k2 < len - 1) {
                *(line + k2) = *(line + k2 + 1);
                k2 += 1;
            }
            len -= 1;
            if (fb_out != ptr<u32>(0) && *fb_cursor_onp != 0) {
                fb_cursor_xor(fb_out, fb_out_stride, fb_out_width, fb_out_height, *fb_cursor_xp, *fb_cursor_yp);
                *fb_cursor_onp = 0;
            }
            line_redraw(vga, rowp, colp, attr, *line_rowp, *line_colp, line, len, prev_len, cur);
            if (fb_out != ptr<u32>(0)) {
                fb_redraw_from(fb_out, fb_out_stride, fb_out_width, fb_out_height,
                    *fb_line_rowp, *fb_line_colp, line, len, prev_len, cur);
                fb_cursor_set_line(fb_out, fb_out_width, fb_out_xp, fb_out_yp, *fb_line_rowp, *fb_line_colp, cur);
            }
            line_redraw_serial(com1, line, len, prev_len, cur);
            prev_len = len;
        }
        *lenp = len;
        *prev_lenp = prev_len;
        *curp = cur;
        ret;
    }

    if (ch == u8(0x0A)) {
        if (fb_out != ptr<u32>(0) && *fb_cursor_onp != 0) {
            fb_cursor_xor(fb_out, fb_out_stride, fb_out_width, fb_out_height, *fb_cursor_xp, *fb_cursor_yp);
            *fb_cursor_onp = 0;
        }
        serial_write_newline(com1);
        tty_putc(vga, rowp, colp, attr, ch);
        if (fb_out != ptr<u32>(0)) {
            fb_cursor_set_line(fb_out, fb_out_width, fb_out_xp, fb_out_yp, *fb_line_rowp, *fb_line_colp, len);
            fb_putc(fb_out, fb_out_stride, fb_out_width, fb_out_height, fb_out_xp, fb_out_yp, ch);
        }
        if (len > 0) {
            line_copy(last_line, line, len);
            *last_lenp = len;
            ptr<u8> dst = hist_entry_ptr(hist_base, *hist_headp);
            line_copy(dst, line, len);
            hist_set_len(hist_len_base, *hist_headp, len);
            *hist_headp = *hist_headp + 1;
            if (*hist_headp >= 8) { *hist_headp = 0; }
            if (*hist_countp < 8) { *hist_countp = *hist_countp + 1; }
        }
        run_command(vga, rowp, colp, attr, com1, line, len);
        len = 0;
        cur = 0;
        prev_len = 0;
        *hist_navp = -1;
        tty_write_prompt(vga, rowp, colp, attr);
        *line_rowp = *rowp;
        *line_colp = *colp;
        serial_write_byte(com1, u8(0x3E));
        serial_write_byte(com1, u8(0x20));
        if (fb_out != ptr<u32>(0)) {
            *fb_line_rowp = *fb_out_yp;
            *fb_line_colp = *fb_out_xp;
            *fb_line_setp = 1;
        }
        *lenp = len;
        *prev_lenp = prev_len;
        *curp = cur;
        ret;
    }

    if (ch < u8(0x20)) {
        ret;
    }
    if (len >= cap - 1) {
        ret;
    }
    i64 i = len;
    while (i > cur) {
        *(line + i) = *(line + i - 1);
        i -= 1;
    }
    if (fb_out != ptr<u32>(0) && *fb_cursor_onp != 0) {
        fb_cursor_xor(fb_out, fb_out_stride, fb_out_width, fb_out_height, *fb_cursor_xp, *fb_cursor_yp);
        *fb_cursor_onp = 0;
    }
    *(line + cur) = ch;
    len += 1;
    cur += 1;
    line_redraw(vga, rowp, colp, attr, *line_rowp, *line_colp, line, len, prev_len, cur);
    if (fb_out != ptr<u32>(0)) {
        i64 start = cur - 1;
        if (start < 0) { start = 0; }
        fb_redraw_from(fb_out, fb_out_stride, fb_out_width, fb_out_height,
            *fb_line_rowp, *fb_line_colp, line, len, prev_len, start);
        fb_cursor_set_line(fb_out, fb_out_width, fb_out_xp, fb_out_yp, *fb_line_rowp, *fb_line_colp, cur);
    }
    line_redraw_serial(com1, line, len, prev_len, cur);
    prev_len = len;
    *lenp = len;
    *prev_lenp = prev_len;
    *curp = cur;
}
fn line_redraw(ptr<u16> vga, ptr<i64> rowp, ptr<i64> colp, u16 attr, i64 line_row, i64 line_col, ptr<u8> buf, i64 len, i64 prev_len, i64 cur) {
    *rowp = line_row;
    *colp = line_col;
    if (uefi_present()) {
        i64 st = uefi_set_cursor_pos(line_col, line_row);
        st = st;
    }

    i64 i = 0;
    while (i < len) {
        u8 ch = *(buf + i);
        tty_putc(vga, rowp, colp, attr, ch);
        i += 1;
    }
    if (prev_len > len) {
        i64 j = 0;
        while (j < (prev_len - len)) {
            tty_putc(vga, rowp, colp, attr, u8(0x20));
            j += 1;
        }
    }

    i64 total = line_col + cur;
    i64 row = line_row + (total / 80);
    i64 col = total - (total / 80) * 80;
    if (row >= 25) {
        row = 24;
        if (col >= 80) { col = 79; }
    }
    *rowp = row;
    *colp = col;
    if (uefi_present()) {
        i64 st2 = uefi_set_cursor_pos(col, row);
        st2 = st2;
    }
}

fn fb_cursor_set_line(ptr<u32> fb_out, i64 fb_out_width, ptr<i64> fb_out_xp, ptr<i64> fb_out_yp,
    i64 fb_line_row, i64 fb_line_col, i64 cur) {
    if (fb_out == ptr<u32>(0)) { ret; }
    i64 cols = fb_out_width / 8;
    if (cols <= 0) { cols = 80; }
    i64 total = fb_line_col + cur;
    i64 row = fb_line_row + (total / cols);
    i64 col = total - (total / cols) * cols;
    *fb_out_xp = col;
    *fb_out_yp = row;
}
fn line_redraw_serial(u16 com1, ptr<u8> buf, i64 len, i64 prev_len, i64 cur) {
    serial_write_byte(com1, u8(0x0D));
    serial_write_byte(com1, u8(0x3E));
    serial_write_byte(com1, u8(0x20));
    i64 i = 0;
    while (i < len) {
        serial_write_byte(com1, *(buf + i));
        i += 1;
    }
    if (prev_len > len) {
        i64 j = 0;
        while (j < (prev_len - len)) {
            serial_write_byte(com1, u8(0x20));
            j += 1;
        }
        j = 0;
        while (j < (prev_len - len)) {
            serial_write_backspace(com1);
            j += 1;
        }
    }
    i64 back = len - cur;
    while (back > 0) {
        serial_write_backspace(com1);
        back -= 1;
    }
}

fn line_copy(ptr<u8> dst, ptr<u8> src, i64 len) {
    i64 i = 0;
    while (i < len) {
        *(dst + i) = *(src + i);
        i += 1;
    }
}

fn ptr<u8> hist_entry_ptr(ptr<u8> base, i64 idx) {
    ret byte_add(base, idx * 256);
}
fn hist_set_len(ptr<u8> base, i64 idx, i64 len) {
    *(base + idx) = u8(len);
}

fn tty_write_prompt(ptr<u16> vga, ptr<i64> rowp, ptr<i64> colp, u16 attr) {
    tty_putc(vga, rowp, colp, attr, u8(0x3E));
    tty_putc(vga, rowp, colp, attr, u8(0x20));
}
fn u8 hid_key_to_ascii(u8 key, i64 shift) {
    if (key >= u8(0x04) && key <= u8(0x1D)) {
        u8 base = u8(0x61) + (key - u8(0x04));
        if (shift) { ret base - u8(0x20); }
        ret base;
    }
    if (key == u8(0x1E)) { ret sel_shift(shift, u8(0x31), u8(0x21)); }
    if (key == u8(0x1F)) { ret sel_shift(shift, u8(0x32), u8(0x40)); }
    if (key == u8(0x20)) { ret sel_shift(shift, u8(0x33), u8(0x23)); }
    if (key == u8(0x21)) { ret sel_shift(shift, u8(0x34), u8(0x24)); }
    if (key == u8(0x22)) { ret sel_shift(shift, u8(0x35), u8(0x25)); }
    if (key == u8(0x23)) { ret sel_shift(shift, u8(0x36), u8(0x5E)); }
    if (key == u8(0x24)) { ret sel_shift(shift, u8(0x37), u8(0x26)); }
    if (key == u8(0x25)) { ret sel_shift(shift, u8(0x38), u8(0x2A)); }
    if (key == u8(0x26)) { ret sel_shift(shift, u8(0x39), u8(0x28)); }
    if (key == u8(0x27)) { ret sel_shift(shift, u8(0x30), u8(0x29)); }
    if (key == u8(0x28)) { ret u8(0x0A); }
    if (key == u8(0x2A)) { ret u8(0x08); }
    if (key == u8(0x4C)) { ret u8(0x7F); }
    if (key == u8(0x2C)) { ret u8(0x20); }
    if (key == u8(0x2D)) { ret sel_shift(shift, u8(0x2D), u8(0x5F)); }
    if (key == u8(0x2E)) { ret sel_shift(shift, u8(0x3D), u8(0x2B)); }
    if (key == u8(0x2F)) { ret sel_shift(shift, u8(0x5B), u8(0x7B)); }
    if (key == u8(0x30)) { ret sel_shift(shift, u8(0x5D), u8(0x7D)); }
    if (key == u8(0x31)) { ret sel_shift(shift, u8(0x5C), u8(0x7C)); }
    if (key == u8(0x33)) { ret sel_shift(shift, u8(0x3B), u8(0x3A)); }
    if (key == u8(0x34)) { ret sel_shift(shift, u8(0x27), u8(0x22)); }
    if (key == u8(0x35)) { ret sel_shift(shift, u8(0x60), u8(0x7E)); }
    if (key == u8(0x36)) { ret sel_shift(shift, u8(0x2C), u8(0x3C)); }
    if (key == u8(0x37)) { ret sel_shift(shift, u8(0x2E), u8(0x3E)); }
    if (key == u8(0x38)) { ret sel_shift(shift, u8(0x2F), u8(0x3F)); }
    ret u8(0);
}