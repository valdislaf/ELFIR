fn u64 fb_glyph(u8 ch) {    
    if (ch == u8(0x30)) { ret u64(0x003C666E7666663C); } // 0
    if (ch == u8(0x31)) { ret u64(0x003C181818183818); } // 1
    if (ch == u8(0x32)) { ret u64(0x007E60300C06663C); } // 2
    if (ch == u8(0x33)) { ret u64(0x003C66061C06663C); } // 3
    if (ch == u8(0x34)) { ret u64(0x000C0C7E6C3C1C0C); } // 4
    if (ch == u8(0x35)) { ret u64(0x003C6606067C607E); } // 5
    if (ch == u8(0x36)) { ret u64(0x003C66667C60301C); } // 6
    if (ch == u8(0x37)) { ret u64(0x00303030300C067E); } // 7
    if (ch == u8(0x38)) { ret u64(0x003C66663C66663C); } // 8
    if (ch == u8(0x39)) { ret u64(0x00380C063E66663C); } // 9
    if (ch == u8(0x41)) { ret u64(0x0066667E66663C18); } // A
    if (ch == u8(0x42)) { ret u64(0x007C66667C66667C); } // B
    if (ch == u8(0x43)) { ret u64(0x003C66606060663C); } // C
    if (ch == u8(0x44)) { ret u64(0x00786C6666666C78); } // D
    if (ch == u8(0x45)) { ret u64(0x007E60607C60607E); } // E
    if (ch == u8(0x46)) { ret u64(0x006060607C60607E); } // F
    if (ch == u8(0x47)) { ret u64(0x003C666E6060663C); } // G
    if (ch == u8(0x48)) { ret u64(0x006666667E666666); } // H
    if (ch == u8(0x49)) { ret u64(0x003C18181818183C); } // I
    if (ch == u8(0x4A)) { ret u64(0x00386C0C0C0C0C1E); } // J
    if (ch == u8(0x4B)) { ret u64(0x0066666C786C6666); } // K
    if (ch == u8(0x4C)) { ret u64(0x007E606060606060); } // L
    if (ch == u8(0x4D)) { ret u64(0x006363636B7F7763); } // M
    if (ch == u8(0x4E)) { ret u64(0x0066666E7E766666); } // N
    if (ch == u8(0x4F)) { ret u64(0x003C66666666663C); } // O
    if (ch == u8(0x50)) { ret u64(0x006060607C66667C); } // P
    if (ch == u8(0x51)) { ret u64(0x063C6E666666663C); } // Q
    if (ch == u8(0x52)) { ret u64(0x0066666C7C66667C); } // R
    if (ch == u8(0x53)) { ret u64(0x003C66063C60663C); } // S
    if (ch == u8(0x54)) { ret u64(0x001818181818187E); } // T
    if (ch == u8(0x55)) { ret u64(0x003C666666666666); } // U
    if (ch == u8(0x56)) { ret u64(0x00183C6666666666); } // V
    if (ch == u8(0x57)) { ret u64(0x0063777F6B636363); } // W
    if (ch == u8(0x58)) { ret u64(0x0066663C183C6666); } // X
    if (ch == u8(0x59)) { ret u64(0x00181818183C6666); } // Y
    if (ch == u8(0x5A)) { ret u64(0x007E6030180C067E); } // Z
    if (ch == u8(0x61)) { ret u64(0x003E663E063C0000); } // a
    if (ch == u8(0x62)) { ret u64(0x007C6666667C6060); } // b
    if (ch == u8(0x63)) { ret u64(0x003C6660663C0000); } // c
    if (ch == u8(0x64)) { ret u64(0x003E6666663E0606); } // d
    if (ch == u8(0x65)) { ret u64(0x003C607E663C0000); } // e
    if (ch == u8(0x66)) { ret u64(0x003030307C30301C); } // f
    if (ch == u8(0x67)) { ret u64(0x7C063E66663E0000); } // g
    if (ch == u8(0x68)) { ret u64(0x00666666667C6060); } // h
    if (ch == u8(0x69)) { ret u64(0x003C181818380018); } // i
    if (ch == u8(0x6A)) { ret u64(0x386C0C0C0C1C000C); } // j
    if (ch == u8(0x6B)) { ret u64(0x00666C786C666060); } // k
    if (ch == u8(0x6C)) { ret u64(0x003C181818181838); } // l
    if (ch == u8(0x6D)) { ret u64(0x00636B7E7E6C0000); } // m
    if (ch == u8(0x6E)) { ret u64(0x00666666667C0000); } // n
    if (ch == u8(0x6F)) { ret u64(0x003C6666663C0000); } // o
    if (ch == u8(0x70)) { ret u64(0x60607C66667C0000); } // p
    if (ch == u8(0x71)) { ret u64(0x06063E66663E0000); } // q
    if (ch == u8(0x72)) { ret u64(0x00606060766C0000); } // r
    if (ch == u8(0x73)) { ret u64(0x007C063C603E0000); } // s
    if (ch == u8(0x74)) { ret u64(0x001C3030307C3030); } // t
    if (ch == u8(0x75)) { ret u64(0x003E666666660000); } // u
    if (ch == u8(0x76)) { ret u64(0x00183C6666660000); } // v
    if (ch == u8(0x77)) { ret u64(0x00367F7F6B630000); } // w
    if (ch == u8(0x78)) { ret u64(0x00663C183C660000); } // x
    if (ch == u8(0x79)) { ret u64(0x7C063E6666660000); } // y
    if (ch == u8(0x7A)) { ret u64(0x007E30180C7E0000); } // z
    if (ch == u8(0x5F)) { ret u64(0x007E000000000000); } // _
    if (ch == u8(0x3D)) { ret u64(0x00007E00007E0000); } // =
	if (ch == u8(0x2D)) { ret u64(0x0000007E00000000); } // -
	if (ch == u8(0x2B)) { ret u64(0x0018187E18181800); } // +
	if (ch == u8(0x2A)) { ret u64(0x0000663CFF3C6600); } // *
	if (ch == u8(0x5C)) { ret u64(0x0000060C18306000); } // /
	if (ch == u8(0x2F)) { ret u64(0x00006030180C0600); } // \
	if (ch == u8(0x28)) { ret u64(0x000C18303030180C); } // (
	if (ch == u8(0x29)) { ret u64(0x0030180C0C0C1830); } // )
	// space
	if (ch == u8(0x20)) { ret u64(0x0000000000000000); } // ' '

	// . , : ;
	if (ch == u8(0x2E)) { ret u64(0x0018180000000000); } // .
	if (ch == u8(0x2C)) { ret u64(0x3018180000000000); } // ,
	if (ch == u8(0x3A)) { ret u64(0x1818000018180000); } // :
	if (ch == u8(0x3B)) { ret u64(0x3018180000181800); } // ;

	// ! ? ' "
	if (ch == u8(0x21)) { ret u64(0x0018001818181800); } // !
	if (ch == u8(0x3F)) { ret u64(0x001800180C06663C); } // ? 
	if (ch == u8(0x27)) { ret u64(0x0000000018180000); } // '
	if (ch == u8(0x22)) { ret u64(0x0000000066660000); } // "

	// ( ) [ ] { }
	if (ch == u8(0x28)) { ret u64(0x0C18303030180C00); } // (
	if (ch == u8(0x29)) { ret u64(0x30180C0C0C183000); } // )
	if (ch == u8(0x5B)) { ret u64(0x3C30303030303C00); } // [
	if (ch == u8(0x5D)) { ret u64(0x3C0C0C0C0C0C3C00); } // ]
	if (ch == u8(0x7B)) { ret u64(0x0E18187018180E00); } // {
	if (ch == u8(0x7D)) { ret u64(0x7018180E18187000); } // }

	// < >
	if (ch == u8(0x3C)) { ret u64(0x0C18306030180C00); } // <
	if (ch == u8(0x3E)) { ret u64(0x30180C060C183000); } // >

	// / \ | _
	if (ch == u8(0x5C)) { ret u64(0x006030180C060000); } // \   (как в Windows)
	if (ch == u8(0x2F)) { ret u64(0x00060C1830600000); } // /
	if (ch == u8(0x7C)) { ret u64(0x1818181818181800); } // |
	if (ch == u8(0x5F)) { ret u64(0x7E00000000000000); } // _  (сверху, как у тебя)

	// - + =  (плюс оставь свой рабочий; я не трогаю)
	if (ch == u8(0x2D)) { ret u64(0x000000007E000000); } // -
	if (ch == u8(0x2B)) { ret u64(0x0018187E18181800); } // +  (твой рабочий)
	if (ch == u8(0x3D)) { ret u64(0x00007E00007E0000); } // =

	// * % ^ ~
	if (ch == u8(0x2A)) { ret u64(0x003C663C66000000); } // *
	if (ch == u8(0x25)) { ret u64(0x00466630186C6600); } // %
	if (ch == u8(0x5E)) { ret u64(0x00000000663C1800); } // ^
	if (ch == u8(0x7E)) { ret u64(0x00006E3B00000000); } // ~
	if (ch == u8(0x60)) { ret u64(0x30180C0000000000); } // `

	// # & @ $
	if (ch == u8(0x23)) { ret u64(0x367F36367F363600); } // #
	if (ch == u8(0x26)) { ret u64(0x003B66663C386C38); } // &
	if (ch == u8(0x40)) { ret u64(0x3C66606E76663C00); } // @
	if (ch == u8(0x24)) { ret u64(0x187C063C603E1800); } // $
    ret u64(0);
}

fn serial_init(u16 port) {
    if (0) { ret; }
    out8(port + u16(1), u8(0x00));
    out8(port + u16(3), u8(0x80));
    out8(port + u16(0), u8(0x01));
    out8(port + u16(1), u8(0x00));
    out8(port + u16(3), u8(0x03));
    out8(port + u16(2), u8(0xC7));
    out8(port + u16(4), u8(0x0B));
}

fn serial_write_byte(u16 port, u8 b) {
    if (0) { ret; }
    while ((in8(port + u16(5)) & u8(0x20)) == u8(0)) {
    }
    out8(port, b);
}

fn serial_write_newline(u16 port) {
    serial_write_byte(port, u8(0x0D));
    serial_write_byte(port, u8(0x0A));
}

fn serial_write_backspace(u16 port) {
    serial_write_byte(port, u8(0x08));
    serial_write_byte(port, u8(0x20));
    serial_write_byte(port, u8(0x08));
}

fn uefi_putc(u8 c) {
    if (!uefi_present()) {
        ret;
    }
    ptr<u16> tmp = rt_uefi_tmp();
    if (c == u8(0x0A)) {
        *(tmp + 0) = u16(0x0D);
        *(tmp + 1) = u16(0x0A);
        *(tmp + 2) = u16(0);
        i64 st = uefi_print(tmp);
        st = st;
        ret;
    }
    if (c == u8(0x08)) {
        *(tmp + 0) = u16(0x08);
        *(tmp + 1) = u16(0x20);
        *(tmp + 2) = u16(0x08);
        *(tmp + 3) = u16(0);
        i64 st2 = uefi_print(tmp);
        st2 = st2;
        ret;
    }
    *(tmp + 0) = u16(c);
    *(tmp + 1) = u16(0);
    i64 st3 = uefi_print(tmp);
    st3 = st3;
}

fn serial_write_kernel_start(u16 port) {
    serial_write_byte(port, u8(0x6B));
    serial_write_byte(port, u8(0x65));
    serial_write_byte(port, u8(0x72));
    serial_write_byte(port, u8(0x6E));
    serial_write_byte(port, u8(0x65));
    serial_write_byte(port, u8(0x6C));
    serial_write_byte(port, u8(0x3A));
    serial_write_byte(port, u8(0x20));
    serial_write_byte(port, u8(0x73));
    serial_write_byte(port, u8(0x74));
    serial_write_byte(port, u8(0x61));
    serial_write_byte(port, u8(0x72));
    serial_write_byte(port, u8(0x74));
    serial_write_newline(port);
}

fn serial_write_kernel_init_ok(u16 port) {
    serial_write_byte(port, u8(0x6B));
    serial_write_byte(port, u8(0x65));
    serial_write_byte(port, u8(0x72));
    serial_write_byte(port, u8(0x6E));
    serial_write_byte(port, u8(0x65));
    serial_write_byte(port, u8(0x6C));
    serial_write_byte(port, u8(0x3A));
    serial_write_byte(port, u8(0x20));
    serial_write_byte(port, u8(0x69));
    serial_write_byte(port, u8(0x6E));
    serial_write_byte(port, u8(0x69));
    serial_write_byte(port, u8(0x74));
    serial_write_byte(port, u8(0x20));
    serial_write_byte(port, u8(0x6F));
    serial_write_byte(port, u8(0x6B));
    serial_write_newline(port);
}

fn serial_write_kernel_halt(u16 port) {
    serial_write_byte(port, u8(0x6B));
    serial_write_byte(port, u8(0x65));
    serial_write_byte(port, u8(0x72));
    serial_write_byte(port, u8(0x6E));
    serial_write_byte(port, u8(0x65));
    serial_write_byte(port, u8(0x6C));
    serial_write_byte(port, u8(0x3A));
    serial_write_byte(port, u8(0x20));
    serial_write_byte(port, u8(0x68));
    serial_write_byte(port, u8(0x61));
    serial_write_byte(port, u8(0x6C));
    serial_write_byte(port, u8(0x74));
    serial_write_newline(port);
}

fn tty_write_hex_u64(ptr<u16> vga, ptr<i64> rowp, ptr<i64> colp, u16 attr, u64 val) {
    i64 i = 0;
    while (i < 16) {
        i64 shift = (15 - i) * 4;
        u8 nib = u8((val >> u64(shift)) & u64(0xF));
        u8 ch = u8(0);
        if (nib < u8(10)) {
            ch = u8(0x30) + nib;
        }
        else {
            ch = u8(0x41) + (nib - u8(10));
        }
        tty_putc(vga, rowp, colp, attr, ch);
        i += 1;
    }
}

fn fb_clear_screen(ptr<u32> fb, i64 stride, i64 width, i64 height) {
    i64 y = 0;
    while (y < height) {
        i64 x = 0;
        while (x < width) {
            *(fb + y * stride + x) = u32(0x00000000);
            x += 1;
        }
        y += 1;
    }
    ret;
}


fn tty_putc(ptr<u16> vga, ptr<i64> rowp, ptr<i64> colp, u16 attr, u8 c) {
    i64 is_uefi = uefi_present();
    i64 row = *rowp;
    i64 col = *colp;
    i64 idx = 0;

    if (c == u8(0x0A)) {
        if (is_uefi) {
            uefi_putc(c);
        }
        col = 0;
        row += 1;
    }
    else {
        if (c == u8(0x0D)) {
            if (is_uefi) {
                uefi_putc(c);
            }
            col = 0;
        }
        else {
            if (c == u8(0x08)) {
                if (is_uefi) {
                    uefi_putc(c);
                }
                if (col > 0) {
                    col -= 1;
                }
                else {
                    if (row > 0) {
                        row -= 1;
                        col = 79;
                    }
                    else {
                        col = 0;
                    }
                }
                if (!is_uefi) {
                    idx = row * 80 + col;
                    volatile_store(vga + idx, u16(0x20) | attr);
                }
            }
            else {
                if (is_uefi) {
                    uefi_putc(c);
                }
                else {
                    idx = row * 80 + col;
                    volatile_store(vga + idx, u16(c) | attr);
                }
                col += 1;
            }
        }
    }

    if (col >= 80) {
        col = 0;
        row += 1;
    }
    if (row >= 25) {
        tty_scroll(vga, attr);
        row = 24;
    }
    *rowp = row;
    *colp = col;
}

fn tty_scroll(ptr<u16> vga, u16 attr) {
    if (uefi_has_st()) {
        ret;
    }
    i64 i = 0;
    while (i < 1920) {
        u16 v = volatile_load(vga + i + 80);
        volatile_store(vga + i, v);
        i += 1;
    }
    i64 j = 1920;
    while (j < 2000) {
        volatile_store(vga + j, u16(0x20) | attr);
        j += 1;
    }
}

fn fb_putc(ptr<u32> fb, i64 stride, i64 width, i64 height, ptr<i64> xp, ptr<i64> yp, u8 ch) {
    i64 scale = 1;
    i64 line_step = 10;
    i64 line_px = line_step * scale;
    if (line_px <= 0) { ret; }
    i64 max_lines = height / line_px;
    i64 max_cols = width / (8 * scale);
    if (max_cols <= 0) { ret; }
    if (ch == u8(0x08)) {
        if (*xp > 0) {
            *xp = *xp - 1;
        }
        else {
            if (*yp > 0) {
                *yp = *yp - 1;
                *xp = max_cols - 1;
            }
        }
        i64 pxb = *xp * 8 * scale;
        i64 pyb = *yp * line_step * scale;
        fb_fill_rect(fb, stride, width, height, pxb, pyb, 8 * scale, 8 * scale, u32(0x00000000));
        ret;
    }
    if (ch == u8(0x7F)) {
        i64 pxd = *xp * 8 * scale;
        i64 pyd = *yp * line_step * scale;
        fb_fill_rect(fb, stride, width, height, pxd, pyd, 8 * scale, 8 * scale, u32(0x00000000));
        ret;
    }
    if (ch == u8(0x0A)) {
        *xp = 0;
        *yp = *yp + 1;
        if (max_lines > 0 && *yp >= max_lines) {
            fb_clear_screen(fb, stride, width, height);
            *yp = 0;
        }
        ret;
    }
    u64 glyph = fb_glyph(ch);
    i64 x = *xp;
    i64 y = *yp;
    i64 px = x * 8 * scale;
    i64 py = y * line_step * scale;
    if (px + 8 * scale > width) {
        *xp = 0;
        *yp = *yp + 1;
        if (max_lines > 0 && *yp >= max_lines) {
            fb_clear_screen(fb, stride, width, height);
            *yp = 0;
        }
        px = 0;
        py = *yp * line_step * scale;
    }
    if (py + 8 * scale > height) {
        if (max_lines > 0) {
            fb_clear_screen(fb, stride, width, height);
            *yp = 0;
            py = *yp * line_step * scale;
        }
        else {
            ret;
        }
    }
    i64 row = 0;
    while (row < 8) {
        u8 bits = u8((glyph >> u64(row * 8)) & u64(0xFF));
        i64 col = 0;
        while (col < 8) {
            if ((bits & (u8(0x80) >> u8(col))) != u8(0)) {
                i64 sy = 0;
                while (sy < scale) {
                    i64 sx = 0;
                    while (sx < scale) {
                        i64 off = (py + row * scale + sy) * stride + (px + col * scale + sx);
                        *(fb + off) = u32(0x00FFFFFF);
                        sx += 1;
                    }
                    sy += 1;
                }
            }
            col += 1;
        }
        row += 1;
    }
    *xp = *xp + 1;
    ret;
}

fn fb_fill_rect(ptr<u32> fb, i64 stride, i64 width, i64 height, i64 x, i64 y, i64 w, i64 h, u32 color) {
    i64 yy = 0;
    while (yy < h) {
        i64 py = y + yy;
        if (py >= height) { ret; }
        i64 xx = 0;
        while (xx < w) {
            i64 px = x + xx;
            if (px >= width) { break; }
            i64 off = py * stride + px;
            *(fb + off) = color;
            xx += 1;
        }
        yy += 1;
    }
    ret;
}

fn kputc(u8 ch) {
    if (fb_out == ptr<u32>(0)) { ret; }
    if (fb_xp == ptr<i64>(0) || fb_yp == ptr<i64>(0)) { ret; }
    fb_putc(fb_out, fb_stride, fb_width, fb_height, fb_xp, fb_yp, ch);
}

fn kputs(ptr<u8> s) {
    i64 i = 0;
    while (1) {
        u8 ch = *(s + i);
        if (ch == u8(0)) { break; }
        kputc(ch);
        i += 1;
    }
}

fn kendl() {
    kputc(u8(0x0A));
}

fn kbind_fb(ptr<u32> fb, i64 stride, i64 width, i64 height, ptr<i64> xp, ptr<i64> yp) {
    fb_out = fb;
    fb_stride = stride;
    fb_width = width;
    fb_height = height;
    fb_xp = xp;
    fb_yp = yp;
}

fn fb_cursor_xor(ptr<u32> fb, i64 stride, i64 width, i64 height, i64 x, i64 y) {
    i64 scale = 1;
    i64 line_step = 10;
    i64 px = x * 8 * scale;
    i64 py = y * line_step * scale;
    if (px < 0 || py < 0) { ret; }
    if (px + 8 * scale > width) { ret; }
    if (py + 8 * scale > height) { ret; }
    i64 row = 0;
    while (row < 8) {
        i64 off = (py + row * scale) * stride + px;
        *(fb + off) = *(fb + off) ^ u32(0x00FFFFFF);
        row += 1;
    }
}

fn fb_clear_cell(ptr<u32> fb, i64 stride, i64 width, i64 height, i64 x, i64 y) {
    i64 scale = 1;
    i64 line_step = 10;
    i64 px = x * 8 * scale;
    i64 py = y * line_step * scale;
    if (px < 0 || py < 0) { ret; }
    if (px + 8 * scale > width) { ret; }
    if (py + 8 * scale > height) { ret; }
    fb_fill_rect(fb, stride, width, height, px, py, 8 * scale, 8 * scale, u32(0x00000000));
}

fn fb_draw_char_at(ptr<u32> fb, i64 stride, i64 width, i64 height, i64 x, i64 y, u8 ch) {
    i64 scale = 1;
    i64 line_step = 10;
    i64 px = x * 8 * scale;
    i64 py = y * line_step * scale;
    if (px < 0 || py < 0) { ret; }
    if (px + 8 * scale > width) { ret; }
    if (py + 8 * scale > height) { ret; }
    fb_clear_cell(fb, stride, width, height, x, y);
    u64 glyph = fb_glyph(ch);
    i64 row = 0;
    while (row < 8) {
        u8 bits = u8((glyph >> u64(row * 8)) & u64(0xFF));
        i64 col = 0;
        while (col < 8) {
            if ((bits & (u8(0x80) >> u8(col))) != u8(0)) {
                i64 off = (py + row * scale) * stride + (px + col * scale);
                *(fb + off) = u32(0x00FFFFFF);
            }
            col += 1;
        }
        row += 1;
    }
}

fn fb_redraw_from(ptr<u32> fb, i64 stride, i64 width, i64 height,
    i64 line_row, i64 line_col, ptr<u8> buf, i64 len, i64 prev_len, i64 start) {
    if (fb == ptr<u32>(0)) { ret; }
    if (start < 0) { start = 0; }
    if (start > len) { start = len; }
    i64 cols = width / 8;
    if (cols <= 0) { ret; }
    i64 total = line_col + start;
    i64 x = total - (total / cols) * cols;
    i64 y = line_row + (total / cols);
    i64 i = start;
    while (i < len) {
        fb_draw_char_at(fb, stride, width, height, x, y, *(buf + i));
        x += 1;
        if (x >= cols) {
            x = 0;
            y += 1;
        }
        i += 1;
    }
    i64 j = len;
    while (j < prev_len) {
        fb_clear_cell(fb, stride, width, height, x, y);
        x += 1;
        if (x >= cols) {
            x = 0;
            y += 1;
        }
        j += 1;
    }
}

fn fb_hex(ptr<u32> fb, i64 stride, i64 width, i64 height, ptr<i64> xp, ptr<i64> yp, u64 val) {
    i64 i = 0;
    while (i < 16) {
        i64 shift = (15 - i) * 4;
        u8 nib = u8((val >> u64(shift)) & u64(0xF));
        u8 ch = u8(0);
        if (nib < u8(10)) {
            ch = u8(0x30) + nib;
        }
        else {
            ch = u8(0x41) + (nib - u8(10));
        }
        fb_putc(fb, stride, width, height, xp, yp, ch);
        i += 1;
    }
    ret;
}

fn khex(u64 val) {
    if (fb_out == ptr<u32>(0)) { ret; }
    if (fb_xp == ptr<i64>(0) || fb_yp == ptr<i64>(0)) { ret; }
    fb_hex(fb_out, fb_stride, fb_width, fb_height, fb_xp, fb_yp, val);
}

fn kdigit(u8 v) {
    if (v > u8(9)) { ret; }
    kputc(u8(0x30) + v);
}

fn fb_write_hex_u64(ptr<u32> fb, i64 stride, i64 width, i64 height, ptr<i64> xp, ptr<i64> yp, u64 val) {
    fb_hex(fb, stride, width, height, xp, yp, val);
}

fn fb_put_hex_nib(ptr<u32> fb, i64 stride, i64 width, i64 height, ptr<i64> xp, ptr<i64> yp, u8 nib) {
    u8 ch = u8(0);
    if (nib < u8(10)) {
        ch = u8(0x30) + nib;
    }
    else {
        ch = u8(0x41) + (nib - u8(10));
    }
    fb_putc(fb, stride, width, height, xp, yp, ch);
}

fn fb_write_hex_u8(ptr<u32> fb, i64 stride, i64 width, i64 height, ptr<i64> xp, ptr<i64> yp, u8 val) {
    u8 hi = (val >> u8(4)) & u8(0xF);
    u8 lo = val & u8(0xF);
    if (hi != u8(0)) {
        fb_put_hex_nib(fb, stride, width, height, xp, yp, hi);
    }
    fb_put_hex_nib(fb, stride, width, height, xp, yp, lo);
}

